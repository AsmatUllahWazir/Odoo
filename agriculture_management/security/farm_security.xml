<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="module_category_agriculture" model="ir.module.category">
            <field name="name">Agriculture</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_farm_user" model="res.groups">
            <field name="name">Farm User</field>
            <field name="category_id" ref="module_category_agriculture"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_farm_manager" model="res.groups">
            <field name="name">Farm Manager</field>
            <field name="category_id" ref="module_category_agriculture"/>
            <field name="implied_ids" eval="[(4, ref('group_farm_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="farm_field_comp_rule" model="ir.rule">
            <field name="name">Farm Field Multi-Company</field>
            <field name="model_id" ref="model_farm_field"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="farm_season_comp_rule" model="ir.rule">
            <field name="name">Farm Season Multi-Company</field>
            <field name="model_id" ref="model_farm_season"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="farm_cultivation_comp_rule" model="ir.rule">
            <field name="name">Farm Cultivation Multi-Company</field>
            <field name="model_id" ref="model_farm_cultivation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="farm_input_comp_rule" model="ir.rule">
            <field name="name">Farm Input Multi-Company</field>
            <field name="model_id" ref="model_farm_input_application"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="farm_harvest_comp_rule" model="ir.rule">
            <field name="name">Farm Harvest Multi-Company</field>
            <field name="model_id" ref="model_farm_harvest"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>