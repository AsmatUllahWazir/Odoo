<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_farm_input_tree" model="ir.ui.view">
            <field name="name">farm.input.application.tree</field>
            <field name="model">farm.input.application</field>
            <field name="arch" type="xml">
                <tree string="Input Applications">
                    <field name="name"/>
                    <field name="application_date"/>
                    <field name="input_type"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="uom_id"/>
                    <field name="field_id"/>
                    <field name="total_cost" optional="show"/>
                    <field name="phi_days" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="view_farm_input_form" model="ir.ui.view">
            <field name="name">farm.input.application.form</field>
            <field name="model">farm.input.application</field>
            <field name="arch" type="xml">
                <form string="Input Application">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id" invisible="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="season_id"/>
                                <field name="cultivation_id" domain="[('season_id', '=', season_id)]"/>
                                <field name="field_id"/>
                                <field name="application_date"/>
                                <field name="input_type"/>
                                <field name="application_method"/>
                            </group>
                            <group>
                                <field name="product_id"/>
                                <field name="lot_id" domain="[('product_id', '=', product_id)]"/>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                                <field name="area_covered"/>
                                <field name="unit_cost"/>
                                <field name="total_cost"/>
                            </group>
                        </group>
                        <group string="Weather Conditions">
                            <group>
                                <field name="weather_condition"/>
                                <field name="temperature_c"/>
                                <field name="wind_speed"/>
                            </group>
                        </group>
                        <group string="Safety &amp; Compliance">
                            <group>
                                <field name="phi_days"/>
                                <field name="reentry_hours"/>
                                <field name="safety_equipment_used"/>
                            </group>
                            <group>
                                <field name="compliance_notes"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_farm_input_search" model="ir.ui.view">
            <field name="name">farm.input.application.search</field>
            <field name="model">farm.input.application</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="field_id"/>
                    <filter name="fertilizer" string="Fertilizer" domain="[('input_type', '=', 'fertilizer')]"/>
                    <filter name="pesticide" string="Pesticide" domain="[('input_type', '=', 'pesticide')]"/>
                    <filter name="irrigation" string="Irrigation" domain="[('input_type', '=', 'irrigation')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_type" string="Input Type" context="{'group_by': 'input_type'}"/>
                        <filter name="group_field" string="Field" context="{'group_by': 'field_id'}"/>
                        <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_farm_input" model="ir.actions.act_window">
            <field name="name">Input Applications</field>
            <field name="res_model">farm.input.application</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_farm_input_search"/>
        </record>
    </data>
</odoo>
