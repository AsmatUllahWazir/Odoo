<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_farm_harvest_wizard_form" model="ir.ui.view">
            <field name="name">farm.harvest.wizard.form</field>
            <field name="model">farm.harvest.wizard</field>
            <field name="arch" type="xml">
                <form string="Record Harvest">
                    <group>
                        <field name="cultivation_id" readonly="1"/>
                        <field name="season_id" readonly="1"/>
                        <field name="field_id" readonly="1"/>
                        <field name="crop_id" readonly="1"/>
                    </group>
                    <group>
                        <group>
                            <field name="harvest_date"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="quality_grade"/>
                            <field name="moisture_percent"/>
                        </group>
                        <group>
                            <field name="unit_price"/>
                            <field name="product_id"/>
                            <field name="location_id"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_confirm_harvest" string="Confirm Harvest" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>