<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_farm_season">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2><span t-field="o.name"/> - Season Report</h2>
                            <div class="row mt32 mb32">
                                <div class="col-6">
                                    <strong>Field:</strong> <span t-field="o.field_id.name"/><br/>
                                    <strong>Crop:</strong> <span t-field="o.crop_id.name"/><br/>
                                    <strong>Period:</strong> <span t-field="o.date_start"/> to <span t-field="o.date_end"/>
                                </div>
                                <div class="col-6">
                                    <strong>Status:</strong> <span t-field="o.state"/><br/>
                                    <strong>Budget:</strong> <span t-field="o.budget_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/><br/>
                                    <strong>Actual Cost:</strong> <span t-field="o.actual_cost_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                            </div>

                            <h3>Financial Summary</h3>
                            <table class="table table-sm">
                                <tr><td>Revenue</td><td class="text-right"><span t-field="o.revenue_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr><td>Costs</td><td class="text-right"><span t-field="o.actual_cost_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr class="table-active"><td><strong>Profit / Loss</strong></td><td class="text-right"><strong><span t-field="o.profit_loss" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong></td></tr>
                            </table>

                            <h3>Input Applications</h3>
                            <table class="table table-sm">
                                <thead><tr><th>Date</th><th>Type</th><th>Product</th><th>Quantity</th><th>Cost</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="o.input_ids" t-as="line">
                                        <td><span t-field="line.application_date"/></td>
                                        <td><span t-field="line.input_type"/></td>
                                        <td><span t-field="line.product_id.name"/></td>
                                        <td><span t-field="line.quantity"/> <span t-field="line.uom_id.name"/></td>
                                        <td class="text-right"><span t-field="line.total_cost"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <h3>Harvests</h3>
                            <table class="table table-sm">
                                <thead><tr><th>Date</th><th>Quantity</th><th>Grade</th><th>Value</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="o.harvest_ids" t-as="line">
                                        <td><span t-field="line.harvest_date"/></td>
                                        <td><span t-field="line.quantity"/> <span t-field="line.uom_id.name"/></td>
                                        <td><span t-field="line.quality_grade"/></td>
                                        <td class="text-right"><span t-field="line.total_value"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>