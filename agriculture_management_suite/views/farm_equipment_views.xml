<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_farm_equipment_tree" model="ir.ui.view">
            <field name="name">farm.equipment.tree</field>
            <field name="model">farm.equipment</field>
            <field name="arch" type="xml">
                <tree string="Equipment" decoration-muted="state=='retired'" decoration-danger="state=='broken'">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="equipment_type"/>
                    <field name="brand"/>
                    <field name="state"/>
                    <field name="current_field_id" optional="show"/>
                    <field name="current_hours" optional="show"/>
                    <field name="book_value" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="view_farm_equipment_form" model="ir.ui.view">
            <field name="name">farm.equipment.form</field>
            <field name="model">farm.equipment</field>
            <field name="arch" type="xml">
                <form string="Equipment">
                    <header>
                        <button name="action_create_maintenance_request" string="Create Maintenance Request" type="object" class="oe_highlight"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                            <h2 class="oe_inline"><field name="code" readonly="1"/></h2>
                        </div>
                        <group>
                            <group>
                                <field name="equipment_type"/>
                                <field name="brand"/>
                                <field name="model"/>
                                <field name="serial_number"/>
                                <field name="year_manufactured"/>
                            </group>
                            <group>
                                <field name="purchase_date"/>
                                <field name="purchase_price"/>
                                <field name="book_value" readonly="1"/>
                                <field name="current_hours"/>
                                <field name="current_field_id"/>
                            </group>
                        </group>
                        <group>
                            <group string="Engine/Fuel">
                                <field name="fuel_type"/>
                                <field name="fuel_capacity"/>
                            </group>
                            <group string="Depreciation">
                                <field name="depreciation_method"/>
                                <field name="useful_life_years"/>
                                <field name="residual_value"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_farm_equipment" model="ir.actions.act_window">
            <field name="name">Equipment</field>
            <field name="res_model">farm.equipment</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>