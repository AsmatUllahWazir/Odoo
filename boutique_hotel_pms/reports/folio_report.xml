<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_hotel_folio">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="padding: 40px; font-family: Arial, sans-serif;">
                    <div style="text-align: center; margin-bottom: 30px;">
                        <h1 style="color: #2c3e50;">Hotel Folio / Invoice</h1>
                        <hr style="border: 1px solid #3498db;"/>
                        <p style="font-size: 14px; color: #7f8c8d;">
                            <span t-field="doc.company_id.name"/>
                            <span t-if="doc.company_id.street"> - <span t-field="doc.company_id.street"/></span>
                        </p>
                    </div>

                    <div style="margin-bottom: 20px;">
                        <div style="float: left; width: 50%;">
                            <h3 style="color: #2c3e50;">Folio Details</h3>
                            <p><strong>Folio Number:</strong> <span t-field="doc.name"/></p>
                            <p><strong>Status:</strong> <span t-field="doc.state"/></p>
                            <p><strong>Date Opened:</strong> <span t-field="doc.date_opened"/></p>
                            <p t-if="doc.date_settled"><strong>Date Settled:</strong> <span t-field="doc.date_settled"/></p>
                        </div>
                        <div style="float: right; width: 50%; text-align: right;">
                            <h3 style="color: #2c3e50;">Guest Information</h3>
                            <p><strong>Name:</strong> <span t-field="doc.partner_id.name"/></p>
                            <p><strong>Email:</strong> <span t-field="doc.partner_id.email"/></p>
                            <p><strong>Phone:</strong> <span t-field="doc.partner_id.phone"/></p>
                        </div>
                    </div>

                    <div style="clear: both; margin-bottom: 20px;">
                        <h3 style="color: #2c3e50;">Stay Details</h3>
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="padding: 8px;"><strong>Check-in:</strong></td>
                                <td style="padding: 8px;"><span t-field="doc.check_in"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 8px;"><strong>Check-out:</strong></td>
                                <td style="padding: 8px;"><span t-field="doc.check_out"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 8px;"><strong>Nights:</strong></td>
                                <td style="padding: 8px;"><span t-field="doc.number_of_nights"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 8px;"><strong>Reservation:</strong></td>
                                <td style="padding: 8px;"><span t-field="doc.reservation_id.name"/></td>
                            </tr>
                        </table>
                    </div>

                    <div style="margin-bottom: 20px;">
                        <h3 style="color: #2c3e50;">Charges</h3>
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #ddd;">
                            <thead style="background-color: #3498db; color: white;">
                                <tr>
                                    <th style="padding: 8px; text-align: left;">Description</th>
                                    <th style="padding: 8px; text-align: right;">Quantity</th>
                                    <th style="padding: 8px; text-align: right;">Unit Price</th>
                                    <th style="padding: 8px; text-align: right;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding: 8px; border: 1px solid #ddd;">Room Charges</td>
                                    <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">
                                        <span t-field="doc.number_of_nights"/> nights
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">
                                        <span t-esc="doc.currency_id.symbol"/> <span t-field="doc.room_charges/doc.number_of_nights"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">
                                        <span t-esc="doc.currency_id.symbol"/> <span t-field="doc.room_charges"/>
                                    </td>
                                </tr>
                                <tr t-foreach="doc.service_line_ids" t-as="line">
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <span t-field="line.service_id.name"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">
                                        <span t-esc="doc.currency_id.symbol"/> <span t-field="line.unit_price"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">
                                        <span t-esc="doc.currency_id.symbol"/> <span t-field="line.total_price"/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot style="font-weight: bold;">
                                <tr>
                                    <td colspan="3" style="padding: 8px; text-align: right; border-top: 2px solid #3498db;">
                                        Subtotal:
                                    </td>
                                    <td style="padding: 8px; text-align: right; border-top: 2px solid #3498db;">
                                        <span t-esc="doc.currency_id.symbol"/>
                                        <span t-esc="doc.room_charges + doc.extra_charges"/>
                                    </td>
                                </tr>
                                <tr t-if="doc.discount_amount > 0">
                                    <td colspan="3" style="padding: 8px; text-align: right;">
                                        Discount:
                                    </td>
                                    <td style="padding: 8px; text-align: right;">
                                        -<span t-esc="doc.currency_id.symbol"/>
                                        <span t-field="doc.discount_amount"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" style="padding: 8px; text-align: right; font-size: 1.2em;">
                                        Total Amount:
                                    </td>
                                    <td style="padding: 8px; text-align: right; font-size: 1.2em; color: #2c3e50;">
                                        <span t-esc="doc.currency_id.symbol"/>
                                        <span t-field="doc.total_amount"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" style="padding: 8px; text-align: right;">
                                        Paid Amount:
                                    </td>
                                    <td style="padding: 8px; text-align: right;">
                                        <span t-esc="doc.currency_id.symbol"/>
                                        <span t-field="doc.paid_amount"/>
                                    </td>
                                </tr>
                                <tr t-if="doc.balance_due > 0" style="color: #e74c3c; font-size: 1.2em;">
                                    <td colspan="3" style="padding: 8px; text-align: right;">
                                        Balance Due:
                                    </td>
                                    <td style="padding: 8px; text-align: right;">
                                        <span t-esc="doc.currency_id.symbol"/>
                                        <span t-field="doc.balance_due"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div style="margin-top: 40px; text-align: center; font-size: 12px; color: #7f8c8d;">
                        <p>Thank you for your stay! We hope to see you again.</p>
                        <p>This is a system-generated invoice. Please keep for your records.</p>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_hotel_folio" model="ir.actions.report">
        <field name="name">Folio / Invoice</field>
        <field name="model">hotel.folio</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">boutique_hotel_pms.report_hotel_folio</field>
        <field name="report_file">boutique_hotel_pms.report_hotel_folio</field>
        <field name="binding_model_id" ref="model_hotel_folio"/>
        <field name="binding_type">report</field>
    </record>

</odoo>