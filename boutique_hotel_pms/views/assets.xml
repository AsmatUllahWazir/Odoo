<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="assets_backend" name="Boutique Hotel Assets" inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <link rel="stylesheet" href="/boutique_hotel_pms/static/src/scss/hotel.scss"/>
            <script src="/boutique_hotel_pms/static/src/js/hotel.js"/>
