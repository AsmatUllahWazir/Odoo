<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Service Tree View -->
    <record id="view_hotel_service_tree" model="ir.ui.view">
        <field name="name">hotel.service.tree</field>
        <field name="model">hotel.service</field>
        <field name="arch" type="xml">
            <tree string="Services" decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="price" sum="Total"/>
                <field name="available"/>
                <field name="requires_booking"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Service Form View -->
    <record id="view_hotel_service_form" model="ir.ui.view">
        <field name="name">hotel.service.form</field>
        <field name="model">hotel.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Service Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="price"/>
                            <field name="price_type"/>
                            <field name="available"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="available_from"/>
                            <field name="available_to"/>
                            <field name="time_slots" placeholder="e.g., 8:00-10:00, 14:00-16:00"/>
                            <field name="requires_booking"/>
                            <field name="advance_booking_hours" invisible="not requires_booking"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Service description..."/>
                        <field name="long_description" nolabel="1"
                               placeholder="Detailed description for website..."/>
                    </group>
                    <group string="Image">
                        <field name="image" widget="image" class="oe_avatar"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"
                               placeholder="Additional notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Service Line Form View -->
    <record id="view_hotel_service_line_form" model="ir.ui.view">
        <field name="name">hotel.service.line.form</field>
        <field name="model">hotel.service.line</field>
        <field name="arch" type="xml">
            <form string="Service Line">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm"
                            class="btn-primary"
                            invisible="status != 'draft'"/>
                    <button name="action_provide" type="object"
                            string="Mark Provided"
                            class="btn-success"
                            invisible="status != 'confirmed'"/>
                    <button name="action_bill" type="object"
                            string="Bill"
                            class="btn-info"
                            invisible="status != 'provided'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            class="btn-danger"
                            invisible="status in ['provided','billed']"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,confirmed,provided,billed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="service_id" placeholder="Service..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="folio_id"/>
                            <field name="partner_id"/>
                            <field name="service_id"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="total_price" readonly="1"/>
                            <field name="discount_amount"/>
                            <field name="net_price" readonly="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="duration"/>
                            <field name="notes" nolabel="1"
                                   placeholder="Additional notes..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Service Actions -->
    <record id="action_hotel_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">hotel.service</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage hotel services and amenities
            </p>
        </field>
    </record>

</odoo>