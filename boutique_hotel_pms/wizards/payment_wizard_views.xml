<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment Wizard Form View -->
    <record id="view_hotel_payment_wizard_form" model="ir.ui.view">
        <field name="name">hotel.payment.wizard.form</field>
        <field name="model">hotel.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <sheet>
                    <div class="oe_title">
                        <h1>Register Payment</h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" placeholder="Select Guest..."/>
                            <field name="folio_id" placeholder="Select Folio..."/>
                            <field name="reservation_id" placeholder="Select Reservation..."/>
                            <field name="amount" widget="monetary"/>
                            <field name="payment_method"/>
                            <field name="payment_type"/>
                        </group>
                        <group>
                            <field name="balance_due" readonly="1" widget="monetary"
                                   decoration-danger="balance_due > 0"/>
                            <field name="card_type"
                                   invisible="payment_method not in ['credit_card','debit_card']"/>
                            <field name="card_last4"
                                   invisible="payment_method not in ['credit_card','debit_card']"
                                   placeholder="Last 4 digits"/>
                            <field name="transaction_id" placeholder="Transaction ID..."/>
                            <field name="reference" placeholder="Reference..."/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"
                               placeholder="Payment notes..."/>
                    </group>
                    <footer>
                        <button name="action_process_payment"
                                string="Process Payment"
                                type="object"
                                class="btn-success"/>
                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>