<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reservation Wizard Form View -->
    <record id="view_hotel_reservation_wizard_form" model="ir.ui.view">
        <field name="name">hotel.reservation.wizard.form</field>
        <field name="model">hotel.reservation.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Reservation">
                <sheet>
                    <div class="oe_title">
                        <h1>New Reservation</h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" placeholder="Select Guest..."/>
                            <field name="room_ids" widget="many2many_tags"
                                   placeholder="Select Rooms..."/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="adults"/>
                            <field name="children"/>
                            <field name="number_of_nights" readonly="1"/>
                            <field name="total_amount" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Notes &amp; Requests">
                        <field name="notes" nolabel="1"
                               placeholder="Additional notes..."/>
                        <field name="special_requests" nolabel="1"
                               placeholder="Special requests..."/>
                    </group>
                    <footer>
                        <button name="action_create_reservation"
                                string="Create Reservation"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quick Check-in Wizard Form View -->
    <record id="view_hotel_quick_checkin_wizard_form" model="ir.ui.view">
        <field name="name">hotel.quick.checkin.wizard.form</field>
        <field name="model">hotel.quick.checkin.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Check-in">
                <sheet>
                    <div class="oe_title">
                        <h1>Quick Check-in</h1>
                    </div>
                    <group>
                        <group>
                            <field name="reservation_id" placeholder="Select Reservation..."/>
                            <field name="check_in_actual"/>
                        </group>
                        <group>
                            <field name="notes" nolabel="1"
                                   placeholder="Check-in notes..."/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_check_in"
                                string="Check In"
                                type="object"
                                class="btn-success"/>
                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>