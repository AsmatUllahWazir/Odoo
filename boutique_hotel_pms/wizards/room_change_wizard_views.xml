<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Room Change Wizard Form View -->
    <record id="view_hotel_room_change_wizard_form" model="ir.ui.view">
        <field name="name">hotel.room.change.wizard.form</field>
        <field name="model">hotel.room.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Room">
                <sheet>
                    <div class="oe_title">
                        <h1>Change Room</h1>
                    </div>
                    <group>
                        <group>
                            <field name="reservation_id" placeholder="Select Reservation..."/>
                            <field name="current_room_ids" widget="many2many_tags" readonly="1"/>
                            <field name="new_room_ids" widget="many2many_tags"
                                   placeholder="Select New Rooms..."/>
                        </group>
                        <group>
                            <field name="reason" nolabel="1"
                                   placeholder="Reason for room change..."/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_change_room"
                                string="Change Room"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>