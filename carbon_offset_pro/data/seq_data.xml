<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_carbon_offset_certificate" model="ir.sequence">
        <field name="name">Carbon Offset Certificate</field>
        <field name="code">carbon.offset.certificate</field>
        <field name="prefix">CO2-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_carbon_offset_project_code" model="ir.sequence">
        <field name="name">Carbon Offset Project Code</field>
        <field name="code">carbon.offset.project.code</field>
        <field name="prefix">PROJ-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>