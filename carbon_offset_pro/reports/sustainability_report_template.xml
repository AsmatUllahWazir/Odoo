<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sustainability Report Template -->
    <template id="report_sustainability_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>

                        <!-- Header Section -->
                        <div class="row">
                            <div class="col-12 text-center mb-4">
                                <h1 class="text-success">🌍 Sustainability Report</h1>
                                <h3><t t-esc="doc.name"/></h3>
                                <p class="text-muted">Generated on <t t-esc="fields.Date.today()"/></p>
                            </div>
                        </div>

                        <!-- Customer Information -->
                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Customer:</strong> <t t-esc="doc.partner_id.name"/><br/>
                                <strong>Order Date:</strong> <t t-esc="doc.date_order"/><br/>
                                <strong>Order Reference:</strong> <t t-esc="doc.name"/>
                            </div>
                            <div class="col-6 text-right">
                                <div class="card p-3 bg-light">
                                    <strong>Total Carbon Footprint</strong>
                                    <h2 class="text-danger">
                                        <t t-esc="'{0:.2f}'.format(doc.total_carbon_footprint_kg)"/> kg CO2e
                                    </h2>
                                    <small>≈ <t t-esc="'{0:.2f}'.format(doc.total_carbon_footprint_kg/1000)"/> tons CO2e</small>
                                </div>
                            </div>
                        </div>

                        <!-- Carbon Tier Badge -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="alert" t-attf-class="#{doc.carbon_tier == 'net_zero' and 'alert-success' or doc.carbon_tier == 'low' and 'alert-info' or doc.carbon_tier == 'medium' and 'alert-warning' or 'alert-danger'}">
                                    <strong>Carbon Classification:</strong>
                                    <t t-if="doc.carbon_tier == 'net_zero'">🎉 Net Zero - Excellent! Your order is carbon neutral!</t>
                                    <t t-elif="doc.carbon_tier == 'low'">🌱 Low Carbon Footprint - Good job!</t>
                                    <t t-elif="doc.carbon_tier == 'medium'">📊 Medium Carbon Footprint - Consider reducing where possible</t>
                                    <t t-elif="doc.carbon_tier == 'high'">⚠️ High Carbon Footprint - Offset recommended</t>
                                    <t t-else="">🚨 Very High Carbon Footprint - Immediate offset required</t>
                                </div>
                            </div>
                        </div>

                        <!-- Product Emissions Table -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4>📦 Product Emissions Breakdown</h4>
                                <table class="table table-bordered table-sm">
                                    <thead>
                                        <tr class="bg-secondary text-white">
                                            <th>Product</th>
                                            <th class="text-right">Quantity</th>
                                            <th class="text-right">CO2e (kg)</th>
                                            <th class="text-center">Carbon Rating</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.order_line" t-as="line">
                                            <tr t-if="line.line_carbon_footprint_kg > 0">
                                                <td><t t-esc="line.product_id.display_name"/></td>
                                                <td class="text-right"><t t-esc="'{0:.0f}'.format(line.product_uom_qty)"/></td>
                                                <td class="text-right"><t t-esc="'{0:.2f}'.format(line.line_carbon_footprint_kg)"/></td>
                                                <td class="text-center">
                                                    <t t-if="line.carbon_rating == 'A++'">🏆 A++ (Best)</t>
                                                    <t t-elif="line.carbon_rating == 'A'">✅ A (Excellent)</t>
                                                    <t t-elif="line.carbon_rating == 'B'">👍 B (Good)</t>
                                                    <t t-elif="line.carbon_rating == 'C'">📊 C (Average)</t>
                                                    <t t-elif="line.carbon_rating == 'D'">⚠️ D (Poor)</t>
                                                    <t t-else="">🔴 E (Very Poor)</t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot>
                                        <tr class="bg-light">
                                            <th colspan="2" class="text-right">Total:</th>
                                            <th class="text-right"><t t-esc="'{0:.2f}'.format(doc.total_carbon_footprint_kg)"/> kg</th>
                                            <th></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>

                        <!-- Top Emitters Section -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4>🔥 Top Emitting Products</h4>
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th class="text-right">CO2e (kg)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="products" t-value="doc.order_line.sorted(key=lambda l: l.line_carbon_footprint_kg, reverse=True)[:5]"/>
                                        <t t-foreach="products" t-as="line">
                                            <tr t-if="line.line_carbon_footprint_kg > 0">
                                                <td><t t-esc="line.product_id.display_name"/></td>
                                                <td class="text-right"><t t-esc="'{0:.2f}'.format(line.line_carbon_footprint_kg)"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Offset Information -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4>🌲 Carbon Offset Status</h4>
                                <table class="table table-bordered">
                                    <tr>
                                        <td width="50%"><strong>Offset Purchased:</strong></td>
                                        <td>
                                            <t t-if="doc.carbon_offset_amount_kg > 0">
                                                <span class="text-success">✅ <t t-esc="'{0:.2f}'.format(doc.carbon_offset_amount_kg)"/> kg CO2e</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-warning">⚠️ No offset purchased yet</span>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr t-if="doc.offset_purchase_id">
                                        <td><strong>Offset Project:</strong></td>
                                        <td><t t-esc="doc.offset_purchase_id.project_id.project_name"/></td>
                                    </tr>
                                    <tr t-if="doc.offset_purchase_id">
                                        <td><strong>Project Type:</strong></td>
                                        <td><t t-esc="doc.offset_purchase_id.project_id.project_type"/></td>
                                    </tr>
                                    <tr t-if="doc.offset_purchase_id">
                                        <td><strong>Certificate Number:</strong></td>
                                        <td><code><t t-esc="doc.offset_purchase_id.certificate_number or 'Pending'"/></code></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Recommendations -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header bg-success text-white">
                                        <strong>💡 Recommendations to Reduce Your Carbon Footprint</strong>
                                    </div>
                                    <div class="card-body">
                                        <ul>
                                            <li>🌿 Choose products with A+ or A carbon ratings</li>
                                            <li>📦 Consolidate multiple orders to reduce shipping emissions</li>
                                            <li>🌲 Purchase carbon offsets for unavoidable emissions</li>
                                            <li>🚚 Select slower shipping methods when possible (lower emissions)</li>
                                            <li>♻️ Look for our eco-friendly product line with sustainable packaging</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="footer mt-5 text-center text-muted small">
                            <hr/>
                            This report is generated automatically by Carbon Offset Pro.<br/>
                            For more information, contact: <t t-esc="doc.company_id.email or 'sustainability@example.com'"/>
                        </div>
                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Carbon Offset Certificate Template -->
    <template id="report_certificate_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-if="doc.exists()">
                    <t t-call="web.external_layout_landscape">
                        <div class="page">
                            <div class="oe_structure"/>

                            <!-- Certificate Header -->
                            <div class="text-center mt-5 mb-5">
                                <h1 class="text-success" style="font-size: 48px;">🌿 CARBON OFFSET CERTIFICATE</h1>
                                <p class="lead">This certificate verifies that the following entity has offset their carbon emissions</p>
                                <hr style="border-top: 3px solid #28a745; width: 100px; margin: 20px auto;"/>
                            </div>

                            <!-- Certificate Body -->
                            <div class="row mt-5">
                                <div class="col-12 text-center">
                                    <h2 class="text-uppercase" style="font-size: 28px; letter-spacing: 5px;">
                                        <t t-esc="doc.partner_id.name or 'Unknown Customer'"/>
                                    </h2>
                                    <p class="mt-3">has successfully offset</p>
                                    <h1 class="text-success" style="font-size: 64px;">
                                        <t t-esc="'{0:,.2f}'.format(doc.tons_offset)"/> TONS
                                    </h1>
                                    <p>of carbon dioxide equivalent (CO2e)</p>
                                    <p>through the purchase of verified carbon credits</p>
                                </div>
                            </div>

                            <!-- Environmental Equivalents -->
                            <div class="row mt-5">
                                <div class="col-12">
                                    <div class="card bg-light p-4" style="border-radius: 15px;">
                                        <h4 class="text-center">🌍 Environmental Impact Equivalent to:</h4>
                                        <div class="row text-center mt-3">
                                            <div class="col-md-4">
                                                <span style="font-size: 36px;">🌳</span>
                                                <h3><t t-esc="'{0:.0f}'.format((doc.tons_offset * 1000) / 22)"/></h3>
                                                <p>tree seedlings grown for 10 years</p>
                                            </div>
                                            <div class="col-md-4">
                                                <span style="font-size: 36px;">🚗</span>
                                                <h3><t t-esc="'{0:.1f}'.format(doc.tons_offset / 4.6)"/></h3>
                                                <p>cars taken off the road for 1 year</p>
                                            </div>
                                            <div class="col-md-4">
                                                <span style="font-size: 36px;">🏠</span>
                                                <h3><t t-esc="'{0:.1f}'.format(doc.tons_offset / 7.5)"/></h3>
                                                <p>homes' annual energy use</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Project Details -->
                            <div class="row mt-5">
                                <div class="col-6">
                                    <div class="card">
                                        <div class="card-header bg-success text-white">
                                            <strong>📋 Offset Project Details</strong>
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-borderless">
                                                <tr>
                                                    <td width="40%"><strong>Project Name:</strong></td>
                                                    <td><t t-esc="doc.project_id.project_name"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Project Type:</strong></td>
                                                    <td><t t-esc="doc.project_id.project_type"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Location:</strong></td>
                                                    <td><t t-esc="doc.project_id.location"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Certification:</strong></td>
                                                    <td><t t-esc="doc.project_id.certifying_body"/></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="card">
                                        <div class="card-header bg-info text-white">
                                            <strong>📄 Certificate Information</strong>
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-borderless">
                                                <tr>
                                                    <td width="50%"><strong>Certificate Number:</strong></td>
                                                    <td><code><t t-esc="doc.certificate_number"/></code></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Issue Date:</strong></td>
                                                    <td><t t-esc="doc.certificate_issue_date or doc.purchase_date"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Order Reference:</strong></td>
                                                    <td><t t-esc="doc.sale_order_id.name"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Verified By:</strong></td>
                                                    <td>Carbon Offset Pro</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Verification Statement -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="alert alert-success text-center">
                                        <strong>✅ Verified Carbon Offset</strong><br/>
                                        This purchase neutralizes <t t-esc="'{0:.2f}'.format(doc.tons_offset)"/> tons of CO2e emissions
                                        through the <t t-esc="doc.project_id.project_name"/> project.
                                    </div>
                                </div>
                            </div>

                            <!-- Signatures -->
                            <div class="row mt-5">
                                <div class="col-6 text-center">
                                    <div class="border-top d-inline-block pt-2" style="width: 200px;">
                                        <small>Authorized Signature</small>
                                    </div>
                                </div>
                                <div class="col-6 text-center">
                                    <div class="border-top d-inline-block pt-2" style="width: 200px;">
                                        <small>Carbon Offset Pro</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Footer -->
                            <div class="footer mt-5 text-center text-muted small">
                                <hr/>
                                Certificate ID: <t t-esc="doc.certificate_number"/> | Verified by Carbon Offset Pro
                            </div>
                            <div class="oe_structure"/>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>