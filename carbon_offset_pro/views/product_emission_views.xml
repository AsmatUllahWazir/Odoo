<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_emission_tree" model="ir.ui.view">
        <field name="name">carbon.offset.product.emission.tree</field>
        <field name="model">carbon.offset.product.emission</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_id"/>
                <field name="production_emission_kg"/>
                <field name="weight_kg"/>
                <field name="transport_mode"/>
                <field name="total_emission_kg"/>
                <field name="carbon_rating"/>
            </tree>
        </field>
    </record>

    <record id="view_product_emission_form" model="ir.ui.view">
        <field name="name">carbon.offset.product.emission.form</field>
        <field name="model">carbon.offset.product.emission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="production_emission_kg"/>
                            <field name="packaging_emission_kg"/>
                            <field name="weight_kg"/>
                        </group>
                        <group>
                            <field name="transport_mode"/>
                            <field name="renewable_percentage"/>
                            <field name="total_emission_kg" readonly="1"/>
                            <field name="carbon_rating" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.carbon.offset.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Carbon Footprint">
                    <group>
                        <field name="total_product_emission" readonly="1"/>
                        <field name="carbon_rating" readonly="1"/>
                        <field name="emission_factor_ids">
                            <tree editable="bottom">
                                <field name="production_emission_kg"/>
                                <field name="packaging_emission_kg"/>
                                <field name="weight_kg"/>
                                <field name="transport_mode"/>
                                <field name="total_emission_kg"/>
                                <field name="carbon_rating"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_product_emission" model="ir.actions.act_window">
        <field name="name">Product Emission Factors</field>
        <field name="res_model">carbon.offset.product.emission</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>