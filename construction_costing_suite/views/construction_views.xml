<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project Form View Extension -->
    <record id="view_project_form_construction" model="ir.ui.view">
        <field name="name">project.project.form.construction</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_construction_project" invisible="1"/>
                <field name="project_type" invisible="not is_construction_project"/>
                <field name="construction_status" invisible="not is_construction_project"/>
            </xpath>

            <xpath expr="//field[@name='date_start']" position="after">
                <field name="site_address" invisible="not is_construction_project"/>
                <field name="site_contact" invisible="not is_construction_project"/>
                <field name="site_phone" invisible="not is_construction_project"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page name="construction_details" string="Construction" invisible="not is_construction_project">
                    <group>
                        <group string="Project Details">
                            <field name="project_type"/>
                            <field name="construction_status"/>
                            <field name="site_address"/>
                            <field name="site_contact"/>
                            <field name="site_phone"/>
                        </group>
                        <group string="Financial">
                            <field name="total_contract_value"/>
                            <field name="total_budget"/>
                            <field name="total_actual_cost"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_project_search_construction" model="ir.ui.view">
        <field name="name">project.project.search.construction</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="construction" string="Construction Projects"
                        domain="[('is_construction_project', '=', True)]"/>
                <filter name="project_type" string="Project Type"
                        domain="[]" context="{'group_by': 'project_type'}"/>
                <filter name="construction_status" string="Status"
                        domain="[]" context="{'group_by': 'construction_status'}"/>
            </xpath>
        </field>
    </record>
</odoo>