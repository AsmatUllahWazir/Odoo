<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_cost_tree" model="ir.ui.view">
        <field name="name">construction.job.cost.line.tree</field>
        <field name="model">construction.job.cost.line</field>
        <field name="arch" type="xml">
            <tree string="Job Cost Lines"
                  decoration-danger="cost_variance &lt; 0"
                  decoration-success="cost_variance &gt; 0"
                  decoration-warning="completion_percentage &gt; 100">
                <field name="name"/>
                <field name="category" widget="badge"/>
                <field name="product_id"/>
                <field name="budgeted_quantity"/>
                <field name="budgeted_amount" sum="Budgeted"/>
                <field name="actual_quantity"/>
                <field name="actual_cost" sum="Actual"/>
                <field name="committed_cost" sum="Committed"/>
                <field name="cost_variance" sum="Variance"/>
                <field name="completion_percentage" widget="progressbar"/>
                <field name="project_id" invisible="context.get('default_project_id')"/>
            </tree>
        </field>
    </record>

    <record id="view_job_cost_form" model="ir.ui.view">
        <field name="name">construction.job.cost.line.form</field>
        <field name="model">construction.job.cost.line</field>
        <field name="arch" type="xml">
            <form string="Job Cost Line">
                <header>
                    <button name="action_view_purchase_orders" type="object"
                            string="Purchase Orders" class="btn-secondary"/>
                    <button name="action_view_timesheets" type="object"
                            string="Timesheets" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Description"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" required="1"/>
                            <field name="task_id"/>
                            <field name="category"/>
                            <field name="product_id"/>
                            <field name="uom_id" groups="uom.group_uom"/>
                            <field name="boq_line_id"/>
                        </group>
                        <group string="Budget">
                            <field name="budgeted_quantity"/>
                            <field name="budgeted_unit_price"/>
                            <field name="budgeted_amount" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Actual Performance">
                        <group>
                            <field name="actual_quantity"/>
                            <field name="actual_unit_price"/>
                            <field name="actual_cost" widget="monetary"/>
                        </group>
                        <group>
                            <field name="committed_quantity"/>
                            <field name="committed_cost" widget="monetary"/>
                            <field name="completion_percentage" widget="progressbar"/>
                        </group>
                    </group>
                    <group string="Variance Analysis">
                        <group>
                            <field name="quantity_variance"/>
                            <field name="cost_variance" widget="monetary"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_job_cost" model="ir.actions.act_window">
        <field name="name">Job Costs</field>
        <field name="res_model">construction.job.cost.line</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Track actual costs against budget for your construction projects.
            </p>
        </field>
    </record>
</odoo>