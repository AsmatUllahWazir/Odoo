<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_close_project_wizard_form" model="ir.ui.view">
        <field name="name">close.project.wizard.form</field>
        <field name="model">close.project.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Project">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <i class="fa fa-check-circle" style="color: #2b6cb0; margin-right: 10px;"/>
                            Close Construction Project
                        </h1>
                        <p class="text-muted">
                            Finalize the project with closing details and generate a final report.
                        </p>
                    </div>

                    <group string="Project Selection">
                        <field name="project_id" required="1"/>
                    </group>

                    <group string="Financial Summary" colspan="2">
                        <group string="Cost Summary">
                            <field name="final_cost" widget="monetary" readonly="1"/>
                            <field name="final_billed" widget="monetary" readonly="1"/>
                            <field name="final_profit" widget="monetary" readonly="1"/>
                            <field name="profit_margin" readonly="1"/>
                        </group>
                    </group>

                    <group string="Closing Details">
                        <group>
                            <field name="final_status" required="1" widget="radio"/>
                            <field name="closure_date" required="1"/>
                        </group>
                        <group>
                            <field name="release_retainage"/>
                        </group>
                    </group>

                    <group string="Closure Information">
                        <field name="closure_reason" required="1" placeholder="Provide reason for project closure..."/>
                        <field name="final_notes" placeholder="Additional notes about project closure..."/>
                    </group>

                    <group string="Audit Trail" colspan="2">
                        <button name="action_view_audit_trail" type="object" string="View Audit Trail" class="btn btn-secondary"/>
                    </group>

                    <footer>
                        <button name="action_close_project" type="object" string="Close Project"
                                class="btn btn-danger" confirm="Are you sure you want to close this project? This action cannot be undone."/>
                        <button name="action_generate_report" type="object" string="Generate Report" class="btn btn-secondary"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_close_project_wizard" model="ir.actions.act_window">
        <field name="name">Close Project</field>
        <field name="res_model">close.project.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>