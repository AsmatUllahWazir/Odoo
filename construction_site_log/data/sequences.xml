<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily Log Sequence -->
        <record id="seq_construction_site_daily_log" model="ir.sequence">
            <field name="name">Construction Site Daily Log</field>
            <field name="code">construction.site.daily.log</field>
            <field name="prefix">DL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Safety Observation Sequence -->
        <record id="seq_construction_safety_observation" model="ir.sequence">
            <field name="name">Construction Safety Observation</field>
            <field name="code">construction.safety.observation</field>
            <field name="prefix">SO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Incident Report Sequence -->
        <record id="seq_construction_incident_report" model="ir.sequence">
            <field name="name">Construction Incident Report</field>
            <field name="code">construction.incident.report</field>
            <field name="prefix">IR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Safety Checklist Execution Sequence -->
        <record id="seq_construction_safety_checklist_execution" model="ir.sequence">
            <field name="name">Construction Safety Checklist Execution</field>
            <field name="code">construction.safety.checklist.execution</field>
            <field name="prefix">CL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>