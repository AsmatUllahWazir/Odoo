<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="group_construction_site_worker" model="res.groups">
        <field name="name">Site Worker</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_construction_site_supervisor" model="res.groups">
        <field name="name">Site Supervisor</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_site_worker'))]"/>
    </record>

    <record id="group_construction_project_manager" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_site_supervisor'))]"/>
    </record>

    <record id="group_construction_safety_officer" model="res.groups">
        <field name="name">Safety Officer</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_site_supervisor'))]"/>
    </record>
</odoo>