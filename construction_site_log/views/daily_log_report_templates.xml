<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily Log Report Template -->
    <template id="daily_log_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <!-- Header -->
                    <div class="row" style="border-bottom: 3px solid #4CAF50; padding-bottom: 10px; margin-bottom: 20px;">
                        <div class="col-xs-8">
                            <h1 style="color: #4CAF50; margin: 0;">Daily Construction Log</h1>
                            <h4 style="color: #666; margin: 5px 0;"><t t-esc="doc.name"/></h4>
                        </div>
                        <div class="col-xs-4 text-right">
                            <div t-if="doc.company_id.logo">
                                <img t-att-src="'data:image/png;base64,%s' % doc.company_id.logo" style="max-height: 60px;"/>
                            </div>
                            <div t-if="not doc.company_id.logo">
                                <h4><t t-esc="doc.company_id.name"/></h4>
                            </div>
                        </div>
                    </div>

                    <!-- Project & Date Info -->
                    <div class="row" style="margin-bottom: 20px;">
                        <div class="col-xs-6">
                            <table class="table table-condensed" style="border: none;">
                                <tr>
                                    <td style="font-weight: bold; width: 40%;">Project:</td>
                                    <td><t t-esc="doc.project_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Date:</td>
                                    <td><t t-esc="doc.date"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Site Supervisor:</td>
                                    <td><t t-esc="doc.site_supervisor_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Status:</td>
                                    <td><span class="badge" t-attf-class="badge-{doc.state == 'draft' and 'warning' or doc.state == 'submitted' and 'info' or 'success'}"><t t-esc="doc.state"/></span></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-xs-6">
                            <table class="table table-condensed" style="border: none;">
                                <tr>
                                    <td style="font-weight: bold; width: 40%;">Weather:</td>
                                    <td><t t-esc="doc.weather_condition"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Temperature:</td>
                                    <td><t t-esc="doc.temperature"/> °C</td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Wind Speed:</td>
                                    <td><t t-esc="doc.wind_speed"/> km/h</td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Rainfall:</td>
                                    <td><t t-esc="doc.rainfall"/> mm</td>
                                </tr>
                                <tr t-if="doc.weather_notes">
                                    <td style="font-weight: bold;">Weather Notes:</td>
                                    <td><t t-esc="doc.weather_notes"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Risk Level:</td>
                                    <td><span class="badge" t-attf-class="badge-{doc.risk_level == 'critical' and 'danger' or doc.risk_level == 'high' and 'warning' or doc.risk_level == 'medium' and 'info' or 'success'}"><t t-esc="doc.risk_level"/></span></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Manpower -->
                    <div class="page-section" style="margin-bottom: 20px;">
                        <h3 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #4CAF50;">Manpower</h3>
                        <t t-if="doc.manpower_line_ids">
                            <table class="table table-bordered table-condensed">
                                <thead>
                                    <tr style="background-color: #e8f5e9;">
                                        <th style="text-align: center;">Category</th>
                                        <th style="text-align: center;">Planned Workers</th>
                                        <th style="text-align: center;">Actual Workers</th>
                                        <th style="text-align: center;">Variance</th>
                                        <th style="text-align: center;">Planned Hours</th>
                                        <th style="text-align: center;">Actual Hours</th>
                                        <th style="text-align: center;">Variance</th>
                                        <th style="text-align: center;">Utilization</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.manpower_line_ids" t-as="line">
                                        <tr>
                                            <td><t t-esc="line.category"/></td>
                                            <td style="text-align: center;"><t t-esc="line.planned_workers"/></td>
                                            <td style="text-align: center;"><t t-esc="line.actual_workers"/></td>
                                            <td style="text-align: center;" t-attf-class="text-{line.variance_workers &lt; 0 and 'danger' or line.variance_workers &gt; 0 and 'success' or 'muted'}">
                                                <t t-esc="line.variance_workers"/>
                                            </td>
                                            <td style="text-align: center;"><t t-esc="line.planned_hours"/></td>
                                            <td style="text-align: center;"><t t-esc="line.actual_hours"/></td>
                                            <td style="text-align: center;" t-attf-class="text-{line.variance_hours &lt; 0 and 'danger' or line.variance_hours &gt; 0 and 'success' or 'muted'}">
                                                <t t-esc="line.variance_hours"/>
                                            </td>
                                            <td style="text-align: center;">
                                                <div class="progress" style="margin: 0;">
                                                    <div class="progress-bar" t-attf-class="progress-bar-{line.utilization_rate &gt;= 90 and 'bg-success' or line.utilization_rate &gt;= 70 and 'bg-warning' or 'bg-danger'}"
                                                         t-att-style="'width: %s%%' % line.utilization_rate">
                                                        <t t-esc="'{:.0f}%'.format(line.utilization_rate)"/>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr style="background-color: #f5f5f5; font-weight: bold;">
                                        <td>TOTAL</td>
                                        <td style="text-align: center;"><t t-esc="sum(doc.manpower_line_ids.mapped('planned_workers'))"/></td>
                                        <td style="text-align: center;"><t t-esc="sum(doc.manpower_line_ids.mapped('actual_workers'))"/></td>
                                        <td style="text-align: center;"><t t-esc="sum(doc.manpower_line_ids.mapped('variance_workers'))"/></td>
                                        <td style="text-align: center;"><t t-esc="sum(doc.manpower_line_ids.mapped('planned_hours'))"/></td>
                                        <td style="text-align: center;"><t t-esc="sum(doc.manpower_line_ids.mapped('actual_hours'))"/></td>
                                        <td style="text-align: center;"><t t-esc="sum(doc.manpower_line_ids.mapped('variance_hours'))"/></td>
                                        <td/>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                        <t t-if="not doc.manpower_line_ids">
                            <p class="text-muted">No manpower data recorded.</p>
                        </t>
                    </div>

                    <!-- Materials -->
                    <div class="page-section" style="margin-bottom: 20px;">
                        <h3 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #2196F3;">Materials Used</h3>
                        <t t-if="doc.material_line_ids">
                            <table class="table table-bordered table-condensed">
                                <thead>
                                    <tr style="background-color: #e3f2fd;">
                                        <th>Product</th>
                                        <th style="text-align: center;">Quantity</th>
                                        <th style="text-align: center;">Unit</th>
                                        <th style="text-align: center;">Unit Price</th>
                                        <th style="text-align: center;">Total Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.material_line_ids" t-as="line">
                                        <tr>
                                            <td><t t-esc="line.product_id.name"/></td>
                                            <td style="text-align: center;"><t t-esc="line.quantity_used"/></td>
                                            <td style="text-align: center;"><t t-esc="line.unit"/></td>
                                            <td style="text-align: center;"><t t-esc="'{:.2f}'.format(line.unit_price)"/></td>
                                            <td style="text-align: center;"><strong><t t-esc="'{:.2f}'.format(line.total_value)"/></strong></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr style="background-color: #f5f5f5; font-weight: bold;">
                                        <td colspan="4" style="text-align: right;">TOTAL VALUE:</td>
                                        <td style="text-align: center;"><t t-esc="'{:.2f}'.format(sum(doc.material_line_ids.mapped('total_value')))"/></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                        <t t-if="not doc.material_line_ids">
                            <p class="text-muted">No materials recorded.</p>
                        </t>
                    </div>

                    <!-- Work Progress -->
                    <div class="page-section" style="margin-bottom: 20px;">
                        <h3 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #FF9800;">Work Progress</h3>
                        <t t-if="doc.progress_line_ids">
                            <table class="table table-bordered table-condensed">
                                <thead>
                                    <tr style="background-color: #fff3e0;">
                                        <th>Activity</th>
                                        <th style="text-align: center; width: 30%;">Progress</th>
                                        <th style="text-align: center;">Quantity Done</th>
                                        <th style="text-align: center;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.progress_line_ids" t-as="line">
                                        <tr>
                                            <td><t t-esc="line.activity_description"/></td>
                                            <td style="text-align: center;">
                                                <div class="progress" style="margin: 0;">
                                                    <div class="progress-bar" t-attf-class="progress-bar-{line.percentage_complete &gt;= 100 and 'bg-success' or line.percentage_complete &gt;= 50 and 'bg-warning' or 'bg-danger'}"
                                                         t-att-style="'width: %s%%' % line.percentage_complete">
                                                        <t t-esc="'{:.0f}%'.format(line.percentage_complete)"/>
                                                    </div>
                                                </div>
                                            </td>
                                            <td style="text-align: center;"><t t-esc="line.quantity_done"/> <t t-esc="line.quantity_unit"/></td>
                                            <td style="text-align: center;"><span class="badge" t-attf-class="badge-{line.status == 'completed' and 'success' or line.status == 'in_progress' and 'warning' or 'secondary'}"><t t-esc="line.status"/></span></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="not doc.progress_line_ids">
                            <p class="text-muted">No progress data recorded.</p>
                        </t>
                    </div>

                    <!-- Safety Summary -->
                    <div class="page-section" style="margin-bottom: 20px;">
                        <h3 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #F44336;">Safety Summary</h3>
                        <div class="row">
                            <div class="col-xs-4">
                                <div class="well" style="background-color: #ffebee; padding: 15px; border-radius: 4px;">
                                    <h4 style="margin: 0; color: #c62828;"><t t-esc="len(doc.safety_observation_ids)"/></h4>
                                    <small>Safety Observations</small>
                                </div>
                            </div>
                            <div class="col-xs-4">
                                <div class="well" style="background-color: #ffebee; padding: 15px; border-radius: 4px;">
                                    <h4 style="margin: 0; color: #c62828;"><t t-esc="len(doc.incident_report_ids)"/></h4>
                                    <small>Incident Reports</small>
                                </div>
                            </div>
                            <div class="col-xs-4">
                                <div class="well" style="background-color: #e8f5e9; padding: 15px; border-radius: 4px;">
                                    <h4 style="margin: 0; color: #2e7d32;"><t t-esc="len(doc.toolbox_talk_ids)"/></h4>
                                    <small>Toolbox Talks</small>
                                </div>
                            </div>
                        </div>

                        <t t-if="doc.safety_observation_ids">
                            <h5 style="margin-top: 15px;">Safety Observations Details</h5>
                            <table class="table table-condensed">
                                <thead>
                                    <tr style="background-color: #f5f5f5;">
                                        <th>Reference</th>
                                        <th>Severity</th>
                                        <th>Location</th>
                                        <th>Status</th>
                                        <th>Responsible</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.safety_observation_ids" t-as="obs">
                                        <tr>
                                            <td><t t-esc="obs.name"/></td>
                                            <td><span class="badge" t-attf-class="badge-{obs.severity == 'critical' and 'danger' or obs.severity == 'high' and 'warning' or 'secondary'}"><t t-esc="obs.severity"/></span></td>
                                            <td><t t-esc="obs.location"/></td>
                                            <td><span class="badge" t-attf-class="badge-{obs.status == 'open' and 'danger' or obs.status == 'in_progress' and 'warning' or 'success'}"><t t-esc="obs.status"/></span></td>
                                            <td><t t-esc="obs.responsible_person_id.name"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="doc.incident_report_ids">
                            <h5 style="margin-top: 15px;">Incident Details</h5>
                            <table class="table table-condensed">
                                <thead>
                                    <tr style="background-color: #f5f5f5;">
                                        <th>Reference</th>
                                        <th>Type</th>
                                        <th>Severity</th>
                                        <th>Status</th>
                                        <th>Investigation Lead</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.incident_report_ids" t-as="inc">
                                        <tr>
                                            <td><t t-esc="inc.name"/></td>
                                            <td><t t-esc="inc.incident_type"/></td>
                                            <td><span class="badge" t-attf-class="badge-{inc.severity == 'fatal' and 'danger' or inc.severity == 'major' and 'warning' or 'secondary'}"><t t-esc="inc.severity"/></span></td>
                                            <td><span class="badge" t-attf-class="badge-{inc.status in ['draft', 'under_investigation'] and 'warning' or 'success'}"><t t-esc="inc.status"/></span></td>
                                            <td><t t-esc="inc.investigation_lead_id.name"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>

                    <!-- Photos -->
                    <t t-if="doc.photo_attachment_ids">
                        <div class="page-section" style="margin-bottom: 20px;">
                            <h3 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #9C27B0;">Site Photos</h3>
                            <div class="row">
                                <t t-foreach="doc.photo_attachment_ids" t-as="photo">
                                    <div class="col-xs-4" style="margin-bottom: 10px;">
                                        <img t-att-src="'/web/image/ir.attachment/%s/datas' % photo.id" style="width: 100%; height: 150px; object-fit: cover; border-radius: 4px;"/>
                                        <p style="font-size: 10px; margin-top: 5px; text-align: center;"><t t-esc="photo.name"/></p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>

                    <!-- Notes -->
                    <t t-if="doc.notes">
                        <div class="page-section" style="margin-bottom: 20px;">
                            <h3 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #607D8B;">Additional Notes</h3>
                            <div class="well" style="background-color: #fafafa; padding: 15px; border-radius: 4px;">
                                <p><t t-esc="doc.notes"/></p>
                            </div>
                        </div>
                    </t>

                    <!-- Footer -->
                    <div style="border-top: 1px solid #ddd; padding-top: 10px; margin-top: 30px; font-size: 10px; color: #666;">
                        <div class="row">
                            <div class="col-xs-6">
                                <p>Generated on: <t t-esc="time.strftime('%Y-%m-%d %H:%M:%S')"/></p>
                                <p>Generated by: <t t-esc="doc.env.user.name"/></p>
                            </div>
                            <div class="col-xs-6 text-right">
                                <p><t t-esc="doc.company_id.name"/></p>
                                <p><t t-esc="doc.company_id.phone"/></p>
                                <p><t t-esc="doc.company_id.email"/></p>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- Checklist Report Template -->
    <template id="checklist_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <!-- Header -->
                    <div class="row" style="border-bottom: 3px solid #4CAF50; padding-bottom: 10px; margin-bottom: 20px;">
                        <div class="col-xs-8">
                            <h1 style="color: #4CAF50; margin: 0;">Safety Checklist Report</h1>
                            <h4 style="color: #666; margin: 5px 0;"><t t-esc="doc.name"/></h4>
                        </div>
                        <div class="col-xs-4 text-right">
                            <div t-if="doc.company_id.logo">
                                <img t-att-src="'data:image/png;base64,%s' % doc.company_id.logo" style="max-height: 60px;"/>
                            </div>
                        </div>
                    </div>

                    <!-- Basic Info -->
                    <div class="row" style="margin-bottom: 20px;">
                        <div class="col-xs-6">
                            <table class="table table-condensed">
                                <tr>
                                    <td style="font-weight: bold;">Template:</td>
                                    <td><t t-esc="doc.template_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Project:</td>
                                    <td><t t-esc="doc.project_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Date:</td>
                                    <td><t t-esc="doc.date"/></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-xs-6">
                            <table class="table table-condensed">
                                <tr>
                                    <td style="font-weight: bold;">Executed By:</td>
                                    <td><t t-esc="doc.executed_by_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Status:</td>
                                    <td><span class="badge" t-attf-class="badge-{doc.status == 'completed' and 'success' or doc.status == 'in_progress' and 'warning' or 'secondary'}"><t t-esc="doc.status"/></span></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Result:</td>
                                    <td><span class="badge" t-attf-class="badge-{doc.result == 'pass' and 'success' or doc.result == 'fail' and 'danger' or 'warning'}"><t t-esc="doc.result"/></span></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Pass Rate:</td>
                                    <td><t t-esc="'{:.1f}%'.format(doc.pass_rate)"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Checklist Items -->
                    <h3 style="background-color: #f5f5f5; padding: 10px; border-left: 4px solid #2196F3;">Checklist Items</h3>
                    <table class="table table-bordered">
                        <thead>
                            <tr style="background-color: #e3f2fd;">
                                <th style="width: 5%;">#</th>
                                <th>Description</th>
                                <th style="width: 15%;">Response</th>
                                <th style="width: 15%;">Status</th>
                                <th style="width: 15%;">Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.execution_line_ids" t-as="line">
                                <tr>
                                    <td style="text-align: center;"><t t-esc="line.sequence"/></td>
                                    <td><t t-esc="line.description"/></td>
                                    <td style="text-align: center;">
                                        <t t-if="line.allowed_response == 'yes_no'">
                                            <span t-if="line.response_yes_no" class="text-success">✓ Yes</span>
                                            <span t-if="not line.response_yes_no" class="text-danger">✗ No</span>
                                        </t>
                                        <t t-if="line.allowed_response == 'pass_fail'">
                                            <span t-if="line.response_pass_fail" class="text-success">✓ Pass</span>
                                            <span t-if="not line.response_pass_fail" class="text-danger">✗ Fail</span>
                                        </t>
                                        <t t-if="line.allowed_response == 'text'">
                                            <t t-esc="line.response_text or 'Not answered'"/>
                                        </t>
                                    </td>
                                    <td style="text-align: center;">
                                        <t t-if="line.required">
                                            <span class="badge" t-attf-class="badge-{line.allowed_response == 'yes_no' and line.response_yes_no or line.allowed_response == 'pass_fail' and line.response_pass_fail or line.response_text and 'success' or 'danger'}">
                                                <t t-if="line.allowed_response == 'yes_no' and line.response_yes_no">Passed</t>
                                                <t t-if="line.allowed_response == 'yes_no' and not line.response_yes_no">Failed</t>
                                                <t t-if="line.allowed_response == 'pass_fail' and line.response_pass_fail">Passed</t>
                                                <t t-if="line.allowed_response == 'pass_fail' and not line.response_pass_fail">Failed</t>
                                                <t t-if="line.allowed_response == 'text' and line.response_text">Answered</t>
                                                <t t-if="line.allowed_response == 'text' and not line.response_text">Pending</t>
                                            </span>
                                        </t>
                                        <t t-if="not line.required">
                                            <span class="badge badge-secondary">Optional</span>
                                        </t>
                                    </td>
                                    <td><t t-esc="line.notes"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Summary Statistics -->
                    <div class="row" style="margin-top: 20px;">
                        <div class="col-xs-3">
                            <div class="well" style="background-color: #e8f5e9; padding: 15px; border-radius: 4px; text-align: center;">
                                <h4 style="margin: 0; color: #2e7d32;"><t t-esc="doc.pass_count"/></h4>
                                <small>Passed</small>
                            </div>
                        </div>
                        <div class="col-xs-3">
                            <div class="well" style="background-color: #ffebee; padding: 15px; border-radius: 4px; text-align: center;">
                                <h4 style="margin: 0; color: #c62828;"><t t-esc="doc.fail_count"/></h4>
                                <small>Failed</small>
                            </div>
                        </div>
                        <div class="col-xs-3">
                            <div class="well" style="background-color: #fff3e0; padding: 15px; border-radius: 4px; text-align: center;">
                                <h4 style="margin: 0; color: #e65100;"><t t-esc="doc.na_count"/></h4>
                                <small>N/A</small>
                            </div>
                        </div>
                        <div class="col-xs-3">
                            <div class="well" style="background-color: #e3f2fd; padding: 15px; border-radius: 4px; text-align: center;">
                                <h4 style="margin: 0; color: #0d47a1;"><t t-esc="'{:.1f}%'.format(doc.pass_rate)"/></h4>
                                <small>Pass Rate</small>
                            </div>
                        </div>
                    </div>

                    <!-- Notes -->
                    <t t-if="doc.notes">
                        <div style="margin-top: 20px;">
                            <h4>Additional Notes</h4>
                            <div class="well" style="background-color: #fafafa; padding: 15px; border-radius: 4px;">
                                <p><t t-esc="doc.notes"/></p>
                            </div>
                        </div>
                    </t>

                    <!-- Footer -->
                    <div style="border-top: 1px solid #ddd; padding-top: 10px; margin-top: 30px; font-size: 10px; color: #666;">
                        <p>Generated on: <t t-esc="time.strftime('%Y-%m-%d %H:%M:%S')"/></p>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>