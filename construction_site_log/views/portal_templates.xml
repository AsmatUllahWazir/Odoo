<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal Layout -->
    <template id="portal_layout" name="Construction Portal Layout">
        <t t-call="web.layout">
            <div id="wrap" class="container">
                <t t-call="portal.portal_layout"/>
                <t t-call="construction_site_log.portal_dashboard_content"/>
            </div>
        </t>
    </template>

    <!-- Dashboard Content -->
    <template id="portal_dashboard_content" name="Construction Dashboard Content">
        <div class="container mt-4">
            <div class="row">
                <div class="col-12">
                    <h1 class="mb-4">Construction Dashboard</h1>
                </div>
            </div>

            <!-- Stats Row -->
            <div class="row">
                <div class="col-md-3 col-sm-6">
                    <div class="card bg-primary text-white mb-3">
                        <div class="card-body">
                            <h6 class="card-title">Total Logs</h6>
                            <h2 class="mb-0">0</h2>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6">
                    <div class="card bg-warning text-white mb-3">
                        <div class="card-body">
                            <h6 class="card-title">Pending Approval</h6>
                            <h2 class="mb-0">0</h2>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6">
                    <div class="card bg-danger text-white mb-3">
                        <div class="card-body">
                            <h6 class="card-title">Open Incidents</h6>
                            <h2 class="mb-0">0</h2>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6">
                    <div class="card bg-info text-white mb-3">
                        <div class="card-body">
                            <h6 class="card-title">Safety Observations</h6>
                            <h2 class="mb-0">0</h2>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Recent Daily Logs</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">No logs found.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Recent Observations</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">No observations found.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- My Daily Logs Template -->
    <template id="portal_my_daily_logs" name="My Daily Logs">
        <t t-call="construction_site_log.portal_layout">
            <div class="container mt-4">
                <div class="row">
                    <div class="col-12">
                        <h1 class="mb-4">My Daily Logs</h1>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Project</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">No logs found.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Daily Log Detail Template -->
    <template id="portal_daily_log_detail" name="Daily Log Detail">
        <t t-call="construction_site_log.portal_layout">
            <div class="container mt-4">
                <div class="row">
                    <div class="col-12">
                        <h1 class="mb-4">Daily Log Detail</h1>
                        <p class="text-muted">Log details will be displayed here.</p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- My Safety Observations Template -->
    <template id="portal_my_safety_observations" name="My Safety Observations">
        <t t-call="construction_site_log.portal_layout">
            <div class="container mt-4">
                <div class="row">
                    <div class="col-12">
                        <h1 class="mb-4">My Safety Observations</h1>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Severity</th>
                                        <th>Location</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">No observations found.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- My Incident Reports Template -->
    <template id="portal_my_incident_reports" name="My Incident Reports">
        <t t-call="construction_site_log.portal_layout">
            <div class="container mt-4">
                <div class="row">
                    <div class="col-12">
                        <h1 class="mb-4">My Incident Reports</h1>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Type</th>
                                        <th>Severity</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">No incidents found.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Shared Log Template -->
    <template id="portal_shared_log" name="Shared Log">
        <t t-call="web.layout">
            <div class="container mt-4">
                <div class="alert alert-info">
                    <i class="fa fa-share-alt"/> This log has been shared with you.
                </div>

                <div class="row">
                    <div class="col-12">
                        <h1>Shared Log</h1>
                        <p class="text-muted">Log details will be displayed here.</p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Reports Template -->
    <template id="portal_reports" name="Construction Reports">
        <t t-call="construction_site_log.portal_layout">
            <div class="container mt-4">
                <div class="row">
                    <div class="col-12">
                        <h1 class="mb-4">Reports</h1>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Daily Report</h5>
                                <p class="card-text">Generate daily construction report.</p>
                                <button class="btn btn-primary">Generate</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Weekly Report</h5>
                                <p class="card-text">Generate weekly summary report.</p>
                                <button class="btn btn-primary">Generate</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Safety Report</h5>
                                <p class="card-text">Generate safety performance report.</p>
                                <button class="btn btn-primary">Generate</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>