<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_delivery_retry" model="ir.cron">
        <field name="name">Delivery Fleet - Create Scheduled Retries</field>
        <field name="model_id" ref="model_delivery_route"/>
        <field name="state">code</field>
        <field name="code">model.cron_create_retries()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_delivery_kpi_snapshot" model="ir.cron">
        <field name="name">Delivery Fleet - Daily KPI Snapshot</field>
        <field name="model_id" ref="model_delivery_kpi_snapshot"/>
        <field name="state">code</field>
        <field name="code">model.cron_create_daily_snapshots()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_delivery_exception_scan" model="ir.cron">
        <field name="name">Delivery Fleet - Scan Operational Exceptions</field>
        <field name="model_id" ref="model_delivery_route"/>
        <field name="state">code</field>
        <field name="code">model.cron_scan_operational_exceptions()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
