<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_delivery_route" model="ir.sequence"><field name="name">Delivery Route</field><field name="code">delivery.route</field><field name="prefix">DR/%(year)s/</field><field name="padding">5</field></record>
    <record id="seq_delivery_proof" model="ir.sequence"><field name="name">Proof of Delivery</field><field name="code">delivery.proof</field><field name="prefix">POD/%(year)s/</field><field name="padding">6</field></record>
    <record id="seq_delivery_retry" model="ir.sequence"><field name="name">Delivery Retry</field><field name="code">delivery.retry</field><field name="prefix">RET/%(year)s/</field><field name="padding">5</field></record>
    <record id="seq_delivery_exception" model="ir.sequence"><field name="name">Delivery Exception</field><field name="code">delivery.exception</field><field name="prefix">EXC/%(year)s/</field><field name="padding">5</field></record>
    <record id="seq_delivery_package" model="ir.sequence"><field name="name">Delivery Package</field><field name="code">delivery.package</field><field name="prefix">PKG/%(year)s/</field><field name="padding">7</field></record>
    <record id="service_standard" model="delivery.service.type"><field name="name">Standard Delivery</field><field name="code">STANDARD</field><field name="sequence">10</field><field name="default_service_minutes">10</field><field name="requires_signature">True</field><field name="allow_partial">True</field><field name="allow_failed_retry">True</field></record>
    <record id="service_express" model="delivery.service.type"><field name="name">Express Delivery</field><field name="code">EXPRESS</field><field name="sequence">20</field><field name="default_service_minutes">7</field><field name="requires_signature">True</field><field name="requires_photo">True</field><field name="allow_partial">False</field><field name="allow_failed_retry">True</field></record>
    <record id="failure_customer_absent" model="delivery.failure"><field name="name">Customer Not Available</field><field name="code">CUSTOMER_ABSENT</field><field name="sequence">10</field><field name="retry_allowed">True</field><field name="default_retry_days">1</field><field name="customer_visible">True</field></record>
    <record id="failure_address_issue" model="delivery.failure"><field name="name">Address Issue</field><field name="code">ADDRESS_ISSUE</field><field name="sequence">20</field><field name="retry_allowed">True</field><field name="default_retry_days">1</field><field name="customer_visible">True</field></record>
    <record id="failure_refused" model="delivery.failure"><field name="name">Delivery Refused</field><field name="code">REFUSED</field><field name="sequence">30</field><field name="retry_allowed">False</field><field name="default_retry_days">0</field><field name="customer_visible">True</field></record>
    <record id="failure_vehicle" model="delivery.failure"><field name="name">Vehicle Issue</field><field name="code">VEHICLE_ISSUE</field><field name="sequence">40</field><field name="retry_allowed">True</field><field name="default_retry_days">1</field><field name="customer_visible">False</field></record>
</odoo>
