<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="delivery_route_dossier_document">
    <t t-call="web.html_container"><t t-foreach="docs" t-as="route"><t t-call="web.external_layout">
      <div class="page" style="font-size:9.5px;color:#273444">
        <div style="border-bottom:4px solid #214c72;padding-bottom:12px;margin-bottom:15px"><div style="font-size:9px;letter-spacing:2px;color:#728197;font-weight:bold">DELIVERY FLEET PRO · EXECUTIVE OPERATIONS</div><h1 style="margin:4px 0;color:#17324d;font-size:25px">Route Performance Dossier</h1><div style="color:#667085">A complete operational, service, exception and financial review for one delivery route.</div></div>
        <table style="width:100%;border-collapse:separate;border-spacing:5px;font-size:9px"><tr><td style="background:#f4f7fb;padding:9px"><b>Route</b><br/><span t-field="route.name"/></td><td style="background:#f4f7fb;padding:9px"><b>Date</b><br/><span t-field="route.date"/></td><td style="background:#f4f7fb;padding:9px"><b>State</b><br/><span t-field="route.state"/></td><td style="background:#f4f7fb;padding:9px"><b>Priority</b><br/><span t-field="route.priority"/></td></tr><tr><td style="background:#f4f7fb;padding:9px"><b>Driver</b><br/><span t-field="route.driver_id.name"/></td><td style="background:#f4f7fb;padding:9px"><b>Vehicle</b><br/><span t-field="route.vehicle_id.name"/></td><td style="background:#f4f7fb;padding:9px"><b>Warehouse</b><br/><span t-field="route.warehouse_id.name"/></td><td style="background:#f4f7fb;padding:9px"><b>Service</b><br/><span t-field="route.service_type_id.name"/></td></tr></table>
        <div style="display:table;width:100%;margin:10px 0"><div style="display:table-cell;background:#eef6fb;padding:12px;width:25%"><b>Stops</b><div style="font-size:18px;color:#17324d"><span t-field="route.stop_count"/></div></div><div style="display:table-cell;background:#edf8f1;padding:12px;width:25%"><b>Delivered</b><div style="font-size:18px;color:#1f7b50"><span t-field="route.delivered_count"/></div></div><div style="display:table-cell;background:#fff6e6;padding:12px;width:25%"><b>On-time</b><div style="font-size:18px;color:#9a6c16"><span t-field="route.on_time_count"/></div></div><div style="display:table-cell;background:#fceeee;padding:12px;width:25%"><b>Exceptions</b><div style="font-size:18px;color:#b43d3d"><span t-field="route.open_exception_count"/></div></div></div>
        <h2 style="font-size:14px;color:#17324d;border-bottom:1px solid #dce3ea;padding-bottom:6px">Operational scorecard</h2>
        <table style="width:100%;border-collapse:collapse;font-size:9px"><tr><td style="padding:6px;border-bottom:1px solid #edf0f4">Completion</td><td style="padding:6px;text-align:right"><span t-field="route.completion_percent"/>%</td><td style="padding:6px;border-bottom:1px solid #edf0f4">Service level</td><td style="padding:6px;text-align:right"><span t-field="route.service_level_percent"/>%</td></tr><tr><td style="padding:6px;border-bottom:1px solid #edf0f4">Readiness</td><td style="padding:6px;text-align:right"><span t-field="route.readiness_score"/>%</td><td style="padding:6px;border-bottom:1px solid #edf0f4">SLA breaches</td><td style="padding:6px;text-align:right"><span t-field="route.sla_breach_count"/></td></tr><tr><td style="padding:6px;border-bottom:1px solid #edf0f4">Planned distance</td><td style="padding:6px;text-align:right"><span t-field="route.estimated_distance"/> km</td><td style="padding:6px;border-bottom:1px solid #edf0f4">Actual distance</td><td style="padding:6px;text-align:right"><span t-field="route.actual_distance"/> km</td></tr><tr><td style="padding:6px">Average stop</td><td style="padding:6px;text-align:right"><span t-field="route.average_stop_minutes"/> min</td><td style="padding:6px">Route efficiency</td><td style="padding:6px;text-align:right"><span t-field="route.route_efficiency_percent"/>%</td></tr></table>
        <h2 style="font-size:14px;color:#17324d;border-bottom:1px solid #dce3ea;padding-bottom:6px;margin-top:18px">Financial performance</h2>
        <table style="width:100%;border-collapse:collapse;font-size:9px"><tr><td style="padding:7px;background:#f8fafc">Revenue</td><td style="padding:7px;text-align:right" t-field="route.total_revenue"/><td style="padding:7px;background:#f8fafc">Revenue / km</td><td style="padding:7px;text-align:right" t-field="route.revenue_per_km"/></tr><tr><td style="padding:7px">Cost</td><td style="padding:7px;text-align:right" t-field="route.total_cost"/><td style="padding:7px">Cost / km</td><td style="padding:7px;text-align:right" t-field="route.cost_per_km"/></tr><tr><td style="padding:8px;background:#eef6f1"><b>Contribution</b></td><td style="padding:8px;text-align:right;background:#eef6f1"><b t-field="route.profitability"/></td><td style="padding:8px;background:#eef6f1"><b>Margin</b></td><td style="padding:8px;text-align:right;background:#eef6f1"><b><span t-field="route.margin_percent"/>%</b></td></tr></table>
        <h2 style="font-size:14px;color:#17324d;border-bottom:1px solid #dce3ea;padding-bottom:6px;margin-top:18px">Stop-by-stop execution</h2>
        <table style="width:100%;border-collapse:collapse;font-size:8px"><thead><tr style="background:#17324d;color:white"><th style="padding:5px">#</th><th style="padding:5px;text-align:left">Customer</th><th style="padding:5px;text-align:left">Window</th><th style="padding:5px">Status</th><th style="padding:5px">On time</th><th style="padding:5px">Late min</th><th style="padding:5px">Packages</th><th style="padding:5px">Weight</th><th style="padding:5px">COD</th></tr></thead><tbody><tr t-foreach="route.line_ids.sorted('sequence')" t-as="line"><td style="padding:5px;border-bottom:1px solid #edf0f4;text-align:center"><span t-field="line.sequence"/></td><td style="padding:5px;border-bottom:1px solid #edf0f4"><b t-field="line.partner_id.name"/><br/><span t-field="line.address"/></td><td style="padding:5px;border-bottom:1px solid #edf0f4"><span t-field="line.date_from"/><br/><span t-field="line.date_to"/></td><td style="padding:5px;border-bottom:1px solid #edf0f4"><span t-esc="dict(line._fields['status'].selection).get(line.status,line.status)"/></td><td style="padding:5px;text-align:center;border-bottom:1px solid #edf0f4"><span t-esc="'Yes' if line.on_time else 'No'"/></td><td style="padding:5px;text-align:right;border-bottom:1px solid #edf0f4"><span t-field="line.late_minutes"/></td><td style="padding:5px;text-align:center;border-bottom:1px solid #edf0f4"><span t-field="line.package_count"/></td><td style="padding:5px;text-align:right;border-bottom:1px solid #edf0f4"><span t-field="line.weight"/></td><td style="padding:5px;text-align:right;border-bottom:1px solid #edf0f4"><span t-field="line.cod_amount"/></td></tr></tbody></table>
        <div style="page-break-before:always"></div>
        <h2 style="font-size:15px;color:#17324d">Exceptions &amp; recovery</h2><t t-if="route.exception_ids"><table style="width:100%;border-collapse:collapse;font-size:8.5px"><thead><tr style="background:#f1f4f7"><th style="padding:6px;text-align:left">Exception</th><th style="padding:6px">Type</th><th style="padding:6px">Priority</th><th style="padding:6px">State</th><th style="padding:6px">Detected</th><th style="padding:6px;text-align:left">Resolution</th></tr></thead><tbody><tr t-foreach="route.exception_ids.sorted('create_date', reverse=True)" t-as="e"><td style="padding:6px;border-bottom:1px solid #edf0f4"><b t-field="e.name"/><br/><span t-field="e.description"/></td><td style="padding:6px;border-bottom:1px solid #edf0f4"><span t-field="e.exception_type"/></td><td style="padding:6px;border-bottom:1px solid #edf0f4;text-align:center"><span t-field="e.priority"/></td><td style="padding:6px;border-bottom:1px solid #edf0f4"><span t-field="e.state"/></td><td style="padding:6px;border-bottom:1px solid #edf0f4"><span t-field="e.detected_at"/></td><td style="padding:6px;border-bottom:1px solid #edf0f4"><span t-field="e.resolution"/></td></tr></tbody></table></t><t t-else=""><div style="padding:18px;background:#edf8f1;color:#226b49">No route-level exceptions were recorded.</div></t>
        <h2 style="font-size:15px;color:#17324d;margin-top:22px">Route event ledger</h2><table style="width:100%;border-collapse:collapse;font-size:8px"><thead><tr style="background:#17324d;color:#fff"><th style="padding:5px">Time</th><th style="padding:5px">Event</th><th style="padding:5px">Source</th><th style="padding:5px;text-align:left">Description</th></tr></thead><tbody><tr t-foreach="route.event_ids.sorted('event_datetime', reverse=True)" t-as="event"><td style="padding:5px;border-bottom:1px solid #edf0f4"><span t-field="event.event_datetime"/></td><td style="padding:5px;border-bottom:1px solid #edf0f4"><span t-field="event.name"/></td><td style="padding:5px;border-bottom:1px solid #edf0f4"><span t-field="event.source"/></td><td style="padding:5px;border-bottom:1px solid #edf0f4"><span t-field="event.description"/></td></tr></tbody></table>
      </div>
    </t></t></t>
  </template>
  <record id="action_report_delivery_route_dossier" model="ir.actions.report"><field name="name">Executive Route Dossier</field><field name="model">delivery.route</field><field name="report_type">qweb-pdf</field><field name="report_name">delivery_fleet_pro.delivery_route_dossier_document</field><field name="report_file">delivery_fleet_pro.delivery_route_dossier_document</field><field name="paperformat_id" ref="paperformat_delivery_a4"/><field name="binding_model_id" ref="model_delivery_route"/><field name="binding_type">report</field></record>

  <template id="delivery_exception_report_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="e"><t t-call="web.external_layout"><div class="page" style="font-size:10px;color:#344054"><h1 style="color:#17324d">Operational Exception Report</h1><p>Exception ownership, age, context and resolution record.</p><table style="width:100%;border-collapse:collapse"><tr><td style="padding:8px;background:#f7f9fb"><b>Exception</b></td><td style="padding:8px"><span t-field="e.name"/></td><td style="padding:8px;background:#f7f9fb"><b>Priority</b></td><td style="padding:8px"><span t-field="e.priority"/></td></tr><tr><td style="padding:8px;background:#f7f9fb"><b>Type</b></td><td style="padding:8px"><span t-field="e.exception_type"/></td><td style="padding:8px;background:#f7f9fb"><b>State</b></td><td style="padding:8px"><span t-field="e.state"/></td></tr><tr><td style="padding:8px;background:#f7f9fb"><b>Route</b></td><td style="padding:8px"><span t-field="e.route_id.name"/></td><td style="padding:8px;background:#f7f9fb"><b>Stop</b></td><td style="padding:8px"><span t-field="e.route_line_id.display_name"/></td></tr></table><h2 style="font-size:14px;color:#17324d;margin-top:20px">Issue</h2><div style="padding:12px;background:#fff8ec;border-left:4px solid #d89a28"><span t-field="e.description"/></div><h2 style="font-size:14px;color:#17324d;margin-top:20px">Lifecycle</h2><table style="width:100%;border-collapse:collapse"><tr><td style="padding:7px">Detected</td><td style="padding:7px"><span t-field="e.detected_at"/></td><td style="padding:7px">Age</td><td style="padding:7px"><span t-field="e.age_minutes"/> minutes</td></tr><tr><td style="padding:7px">Acknowledged</td><td style="padding:7px"><span t-field="e.acknowledged_at"/></td><td style="padding:7px">Owner</td><td style="padding:7px"><span t-field="e.owner_id.name"/></td></tr><tr><td style="padding:7px">Resolved</td><td style="padding:7px"><span t-field="e.resolved_at"/></td><td style="padding:7px">Customer visible</td><td style="padding:7px"><span t-esc="'Yes' if e.customer_visible else 'No'"/></td></tr></table><h2 style="font-size:14px;color:#17324d;margin-top:20px">Resolution</h2><div style="min-height:160px;border:1px solid #e1e6ec;padding:12px"><span t-field="e.resolution"/></div></div></t></t></t></template>
  <record id="action_report_delivery_exception" model="ir.actions.report"><field name="name">Exception Report</field><field name="model">delivery.exception</field><field name="report_type">qweb-pdf</field><field name="report_name">delivery_fleet_pro.delivery_exception_report_document</field><field name="report_file">delivery_fleet_pro.delivery_exception_report_document</field><field name="paperformat_id" ref="paperformat_delivery_a4"/><field name="binding_model_id" ref="model_delivery_exception"/><field name="binding_type">report</field></record>

  <template id="delivery_driver_scorecard_document">
    <t t-call="web.html_container"><t t-foreach="docs" t-as="driver"><t t-call="web.external_layout">
      <div class="page" style="font-size:10px;color:#344054">
        <h1 style="color:#17324d">Driver Performance Scorecard</h1><p>Operational productivity, service quality and commercial contribution.</p>
        <table style="width:100%;border-collapse:collapse"><tr><td style="padding:9px;background:#f7f9fb"><b>Driver</b></td><td style="padding:9px"><span t-field="driver.driver_id.name"/></td><td style="padding:9px;background:#f7f9fb"><b>Company</b></td><td style="padding:9px"><span t-field="driver.company_id.name"/></td></tr></table>
        <div style="display:table;width:100%;margin:14px 0">
          <div style="display:table-cell;background:#edf8f1;padding:15px;width:25%"><b>Delivered</b><div style="font-size:22px"><span t-field="driver.delivered_count"/></div></div>
          <div style="display:table-cell;background:#eef6fb;padding:15px;width:25%"><b>Routes</b><div style="font-size:22px"><span t-field="driver.route_count"/></div></div>
          <div style="display:table-cell;background:#fff6e6;padding:15px;width:25%"><b>On-time</b><div style="font-size:22px"><span t-field="driver.on_time_percent"/>%</div></div>
          <div style="display:table-cell;background:#fceeee;padding:15px;width:25%"><b>Failures</b><div style="font-size:22px"><span t-field="driver.failed_count"/></div></div>
        </div>
        <h2 style="font-size:14px;color:#17324d">Performance indicators</h2>
        <table style="width:100%;border-collapse:collapse"><tr><td style="padding:8px">Stops per route</td><td style="padding:8px;text-align:right"><span t-field="driver.stops_per_route"/></td><td style="padding:8px">Failure rate</td><td style="padding:8px;text-align:right"><span t-field="driver.failed_percent"/>%</td></tr><tr><td style="padding:8px">Distance</td><td style="padding:8px;text-align:right"><span t-field="driver.distance_km"/> km</td><td style="padding:8px">Delivery hours</td><td style="padding:8px;text-align:right"><span t-field="driver.delivery_hours"/> h</td></tr><tr><td style="padding:8px">Revenue</td><td style="padding:8px;text-align:right"><span t-field="driver.revenue"/></td><td style="padding:8px">Cost</td><td style="padding:8px;text-align:right"><span t-field="driver.cost"/></td></tr><tr><td style="padding:9px;background:#eef6f1"><b>Profit</b></td><td style="padding:9px;text-align:right;background:#eef6f1"><b t-field="driver.profit"/></td><td style="padding:9px;background:#eef6f1"><b>Quality index</b></td><td style="padding:9px;text-align:right;background:#eef6f1"><b><span t-field="driver.on_time_percent"/>%</b></td></tr></table>
        <h2 style="font-size:14px;color:#17324d;margin-top:20px">Management review</h2><div style="min-height:230px;border:1px solid #e1e6ec;padding:14px">Use this space for coaching notes, corrective actions, recognition, training plans and period review comments.</div>
      </div>
    </t></t></t>
  </template>
  <record id="action_report_delivery_driver_scorecard" model="ir.actions.report"><field name="name">Driver Scorecard</field><field name="model">delivery.driver.performance</field><field name="report_type">qweb-pdf</field><field name="report_name">delivery_fleet_pro.delivery_driver_scorecard_document</field><field name="report_file">delivery_fleet_pro.delivery_driver_scorecard_document</field><field name="paperformat_id" ref="paperformat_delivery_a4"/><field name="binding_model_id" ref="model_delivery_driver_performance"/><field name="binding_type">report</field></record>
</odoo>
