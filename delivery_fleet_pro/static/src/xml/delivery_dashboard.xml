<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="delivery_fleet_pro.DeliveryFleetDashboard">
<div class="dfp-dashboard o_action">
  <div class="dfp-dashboard-scroll">
    <div class="dfp-dashboard-shell">
      <section class="dfp-hero">
        <div class="dfp-hero-copy"><span class="dfp-eyebrow">DELIVERY FLEET PRO · OPERATIONS INTELLIGENCE</span><h1>Command Center</h1><p>One operational cockpit for planning, dispatch, execution, service quality, exceptions, fleet utilization and delivery profitability.</p></div>
        <div class="dfp-hero-actions"><button class="btn btn-light" t-on-click="() => this.openAction('delivery_fleet_pro.action_delivery_route')">Routes</button><button class="btn btn-outline-light" t-on-click="() => this.openAction('delivery_fleet_pro.action_delivery_exception')">Exceptions</button><button class="btn btn-outline-light" t-on-click="() => this.openAction('delivery_fleet_pro.action_delivery_metric')">Analytics</button></div>
      </section>
      <section class="dfp-toolbar"><div class="dfp-date"><label>From</label><input type="date" t-model="state.dateFrom"/></div><div class="dfp-date"><label>To</label><input type="date" t-model="state.dateTo"/></div><div class="dfp-presets"><button t-on-click="() => this.setPreset(7)">7 days</button><button t-on-click="() => this.setPreset(30)">30 days</button><button t-on-click="() => this.setPreset(90)">90 days</button></div><button class="btn btn-primary dfp-refresh" t-on-click="applyFilters"><t t-if="state.refreshing">Refreshing…</t><t t-else="">Refresh intelligence</t></button><span class="dfp-company">Current company · <strong>Live operational data</strong></span></section>
      <t t-if="state.error"><div class="alert alert-danger dfp-alert">Unable to load dashboard intelligence. Check access rights and delivery configuration, then refresh.</div></t>
      <t t-if="state.loading"><div class="dfp-loading"><div class="spinner-border"/><strong>Building delivery intelligence…</strong><span>Aggregating routes, stops, fleet, drivers and exceptions.</span></div></t>
      <t t-else="">
        <section class="dfp-kpis">
          <article class="dfp-kpi dfp-kpi-blue"><span>Routes</span><strong><t t-esc="formatNumber(state.data.kpis.route_count)"/></strong><small><i t-att-class="changeClass('route_count')"/><t t-esc="formatNumber(Math.abs(change('route_count')), 1)"/>% vs previous</small></article>
          <article class="dfp-kpi dfp-kpi-green"><span>Delivered</span><strong><t t-esc="formatNumber(state.data.kpis.delivered_count)"/></strong><small><t t-esc="percent(state.data.kpis.on_time_percent)"/> on time</small></article>
          <article class="dfp-kpi dfp-kpi-indigo"><span>Completion</span><strong><t t-esc="percent(state.data.completion_percent)"/></strong><small><t t-esc="formatNumber(state.data.kpis.stop_count)"/> total stops</small></article>
          <article class="dfp-kpi dfp-kpi-red"><span>Failures</span><strong><t t-esc="formatNumber(state.data.kpis.failed_count)"/></strong><small><t t-esc="percent(state.data.kpis.failed_percent)"/> failure rate</small></article>
          <article class="dfp-kpi dfp-kpi-amber"><span>Open exceptions</span><strong><t t-esc="formatNumber(state.data.open_exceptions)"/></strong><small><t t-esc="state.data.critical_exceptions"/> critical</small></article>
          <article class="dfp-kpi dfp-kpi-teal"><span>Distance</span><strong><t t-esc="formatNumber(state.data.kpis.distance_km, 1)"/> km</strong><small><t t-esc="formatMoney(state.data.cost_per_delivery)"/> cost / delivery</small></article>
          <article class="dfp-kpi dfp-kpi-purple"><span>Revenue</span><strong><t t-esc="formatMoney(state.data.kpis.revenue)"/></strong><small><t t-esc="formatMoney(state.data.revenue_per_km)"/> / km</small></article>
          <article class="dfp-kpi dfp-kpi-profit"><span>Contribution</span><strong><t t-esc="formatMoney(state.data.kpis.profit)"/></strong><small><t t-esc="percent(state.data.kpis.revenue ? state.data.kpis.profit / state.data.kpis.revenue * 100 : 0)"/> margin</small></article>
        </section>
        <section class="dfp-grid dfp-grid-main">
          <article class="dfp-panel dfp-panel-large"><header><div><span class="dfp-kicker">SERVICE VOLUME</span><h2>Delivery pulse</h2><p>Thirty-day operating rhythm with completed and failed stops.</p></div><div class="dfp-legend"><span><i class="dfp-dot dfp-dot-delivered"/>Delivered</span><span><i class="dfp-dot dfp-dot-failed"/>Failed</span></div></header><div class="dfp-chart"><t t-foreach="latestTrend" t-as="item" t-key="item.date_from"><div class="dfp-chart-day"><div class="dfp-bars"><i class="dfp-bar dfp-delivered" t-att-style="'height:' + progress((item.delivered_count / trendMax) * 100)"/><i class="dfp-bar dfp-failed" t-att-style="'height:' + progress((item.failed_count / trendMax) * 100)"/></div><small><t t-esc="item.date_from.slice(5)"/></small></div></t></div></article>
          <article class="dfp-panel"><header><div><span class="dfp-kicker">EXECUTION HEALTH</span><h2>Service scorecard</h2><p>Signals that deserve attention.</p></div></header><div class="dfp-score"><div class="dfp-score-ring" t-att-style="'--pct:' + progress(state.data.kpis.on_time_percent)"><b><t t-esc="formatNumber(state.data.kpis.on_time_percent, 0)"/>%</b><span>on time</span></div><div class="dfp-score-list"><div><span>Active routes</span><strong><t t-esc="state.data.active_routes"/></strong></div><div><span>Ready routes</span><strong><t t-esc="state.data.ready_routes"/></strong></div><div><span>At risk</span><strong class="dfp-danger-text"><t t-esc="state.data.at_risk_routes"/></strong></div><div><span>Avg. stop</span><strong><t t-esc="formatNumber(state.data.average_stop_minutes, 1)"/>m</strong></div></div></div></article>
        </section>
        <section class="dfp-grid dfp-grid-three">
          <article class="dfp-panel"><header><div><span class="dfp-kicker">FLEET</span><h2>Vehicle readiness</h2><p>Current delivery fleet status.</p></div><button class="dfp-link" t-on-click="() => this.openAction('delivery_fleet_pro.action_delivery_vehicle_log')">Open fleet</button></header><div class="dfp-fleet-summary"><div><strong><t t-esc="state.data.fleet.total"/></strong><span>Total</span></div><div><strong class="dfp-green-text"><t t-esc="state.data.fleet.available"/></strong><span>Available</span></div><div><strong class="dfp-amber-text"><t t-esc="state.data.fleet.assigned"/></strong><span>Assigned</span></div><div><strong class="dfp-red-text"><t t-esc="state.data.fleet.maintenance"/></strong><span>Maintenance</span></div></div><div class="dfp-vehicle-list"><t t-foreach="state.data.vehicles" t-as="vehicle" t-key="vehicle.id"><div class="dfp-vehicle-row"><span class="dfp-vehicle-icon">▰</span><div><strong><t t-esc="vehicle.name"/></strong><small><t t-esc="vehicle.route_count"/> routes · <t t-esc="vehicle.capacity_weight || 0"/> kg capacity</small></div><em><t t-esc="vehicle.status"/></em></div></t></div></article>
          <article class="dfp-panel"><header><div><span class="dfp-kicker">EXCEPTIONS</span><h2>Exception queue</h2><p>Unresolved operational issues.</p></div><button class="dfp-link" t-on-click="() => this.openAction('delivery_fleet_pro.action_delivery_exception')">Manage all</button></header><div class="dfp-exception-list"><t t-foreach="state.data.exceptions" t-as="exception" t-key="exception.id"><button class="dfp-exception" t-on-click="() => this.openException(exception.id)"><span t-att-class="'dfp-exception-priority ' + priorityClass(exception.priority)"><t t-esc="priorityLabel(exception.priority).slice(0,1)"/></span><div><strong><t t-esc="exception.name"/></strong><small><t t-esc="exceptionType(exception.type)"/> · <t t-esc="exception.route"/> <t t-if="exception.stop">· <t t-esc="exception.stop"/></t></small></div><span class="dfp-age"><t t-esc="exception.age"/>m</span></button></t><t t-if="!state.data.exceptions.length"><div class="dfp-empty">No open exceptions. Excellent operational health.</div></t></div></article>
          <article class="dfp-panel"><header><div><span class="dfp-kicker">ROUTE PIPELINE</span><h2>Route state mix</h2><p>Selected period.</p></div></header><div class="dfp-state-list"><t t-foreach="state.data.states" t-as="item" t-key="item.state"><div class="dfp-state-row"><span><t t-esc="item.label"/></span><div class="dfp-state-track"><i t-att-style="'width:' + progress(state.data.kpis.route_count ? item.count / state.data.kpis.route_count * 100 : 0)"/></div><strong><t t-esc="item.count"/></strong></div></t></div></article>
        </section>
        <section class="dfp-grid dfp-grid-main">
          <article class="dfp-panel dfp-panel-large"><header><div><span class="dfp-kicker">DISPATCH BOARD</span><h2>Routes requiring attention</h2><p>Prioritized view of recent routes and readiness.</p></div><button class="dfp-link" t-on-click="() => this.openAction('delivery_fleet_pro.action_delivery_route')">View all routes</button></header><div class="dfp-table-wrap"><table class="dfp-table"><thead><tr><th>Route</th><th>Driver / vehicle</th><th>Status</th><th>Readiness</th><th>Stops</th><th>Exceptions</th><th>Contribution</th></tr></thead><tbody><t t-foreach="state.routes" t-as="route" t-key="route.id"><tr t-on-click="() => this.openRoute(route.id)"><td><strong><t t-esc="route.name"/></strong><small><t t-esc="route.date"/> · <t t-esc="priorityLabel(route.priority)"/></small></td><td><span><t t-esc="route.driver_id?.[1] || 'Unassigned'"/></span><small><t t-esc="route.vehicle_id?.[1] || 'No vehicle'"/></small></td><td><span class="dfp-pill"><t t-esc="stateLabel(route.state)"/></span></td><td><div class="dfp-readiness"><i t-att-style="'width:' + progress(route.readiness_score)"/><span><t t-esc="formatNumber(route.readiness_score, 0)"/>%</span></div></td><td><strong><t t-esc="route.delivered_count"/></strong> / <t t-esc="route.stop_count"/></td><td><span t-att-class="route.open_exception_count ? 'dfp-red-text' : 'dfp-green-text'"><t t-esc="route.open_exception_count"/></span></td><td><strong><t t-esc="formatMoney(route.profitability)"/></strong></td></tr></t><t t-if="!state.routes.length"><tr><td colspan="7" class="dfp-empty">No routes in the selected period.</td></tr></t></tbody></table></div></article>
          <article class="dfp-panel"><header><div><span class="dfp-kicker">PEOPLE</span><h2>Driver leaderboard</h2><p>Quality and output.</p></div><button class="dfp-link" t-on-click="() => this.openAction('delivery_fleet_pro.action_delivery_driver_performance')">All drivers</button></header><div class="dfp-driver-list"><t t-foreach="state.drivers" t-as="driver" t-key="driver.id"><div class="dfp-driver-row"><span class="dfp-avatar"><t t-esc="(driver.driver_id?.[1] || '?').slice(0,1).toUpperCase()"/></span><div><strong><t t-esc="driver.driver_id?.[1] || 'Unknown'"/></strong><small><t t-esc="driver.delivered_count"/> delivered · <t t-esc="driver.route_count"/> routes</small></div><b><t t-esc="formatNumber(driver.on_time_percent, 1)"/>%</b></div></t></div></article>
        </section>
        <section class="dfp-quick"><button t-on-click="() => this.openAction('delivery_fleet_pro.action_batch_route_wizard')"><b>Batch planning</b><span>Build routes from delivery demand</span></button><button t-on-click="() => this.openAction('delivery_fleet_pro.action_optimize_route_wizard')"><b>Optimize routes</b><span>Sequence stops and recalculate metrics</span></button><button t-on-click="() => this.openAction('delivery_fleet_pro.action_delivery_proof')"><b>POD control</b><span>Review signatures, OTP and photos</span></button><button t-on-click="() => this.openAction('delivery_fleet_pro.action_delivery_retry')"><b>Recovery desk</b><span>Manage failures and retry schedules</span></button><button t-on-click="() => this.openAction('delivery_fleet_pro.action_delivery_capacity')"><b>Capacity planning</b><span>Validate weight and volume utilization</span></button><button t-on-click="() => this.openAction('delivery_fleet_pro.action_delivery_kpi_snapshot')"><b>KPI snapshots</b><span>Review historical operational snapshots</span></button></section>
      </t>
    </div>
  </div>
</div>
</t>
</templates>
