<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_delivery_dashboard" model="ir.actions.client">
        <field name="name">Delivery Command Center</field>
        <field name="tag">delivery_fleet_pro_dashboard</field>
    </record>

    <record id="view_delivery_metric_tree" model="ir.ui.view">
        <field name="name">delivery.metric.tree</field><field name="model">delivery.metric</field>
        <field name="arch" type="xml"><tree string="Delivery KPI Analytics">
            <field name="route_date"/><field name="route_id"/><field name="warehouse_id"/><field name="stop_count"/>
            <field name="delivered_count"/><field name="failed_count"/><field name="partial_count"/><field name="on_time_percent"/>
            <field name="total_distance"/><field name="utilization_weight"/><field name="revenue"/><field name="cost"/><field name="profit"/>
        </tree></field>
    </record>
    <record id="view_delivery_metric_graph" model="ir.ui.view">
        <field name="name">delivery.metric.graph</field><field name="model">delivery.metric</field>
        <field name="arch" type="xml"><graph string="Delivery KPI Trend" type="bar">
            <field name="route_date" interval="month"/><field name="delivered_count" type="measure"/>
            <field name="failed_count" type="measure"/><field name="partial_count" type="measure"/>
            <field name="total_distance" type="measure"/><field name="profit" type="measure"/>
        </graph></field>
    </record>
    <record id="view_delivery_metric_pivot" model="ir.ui.view">
        <field name="name">delivery.metric.pivot</field><field name="model">delivery.metric</field>
        <field name="arch" type="xml"><pivot string="Delivery Analytics">
            <field name="route_date" type="row" interval="month"/><field name="warehouse_id" type="row"/>
            <field name="stop_count" type="measure"/><field name="delivered_count" type="measure"/>
            <field name="failed_count" type="measure"/><field name="on_time_percent" type="measure"/>
            <field name="total_distance" type="measure"/><field name="revenue" type="measure"/>
            <field name="cost" type="measure"/><field name="profit" type="measure"/>
        </pivot></field>
    </record>
    <record id="view_delivery_metric_search" model="ir.ui.view">
        <field name="name">delivery.metric.search</field><field name="model">delivery.metric</field>
        <field name="arch" type="xml"><search>
            <field name="route_date"/><field name="route_id"/><field name="warehouse_id"/><field name="company_id"/>
            <filter name="profitable" string="Profitable" domain="[('profit', '&gt;', 0)]"/>
            <filter name="exceptions" string="Has Failures" domain="[('failed_count', '&gt;', 0)]"/>
            <group expand="0" string="Group By"><filter name="month" string="Month" context="{'group_by': 'route_date:month'}"/><filter name="warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/></group>
        </search></field>
    </record>
    <record id="action_delivery_metric" model="ir.actions.act_window">
        <field name="name">Delivery Analytics</field><field name="res_model">delivery.metric</field>
        <field name="view_mode">graph,pivot,tree</field><field name="search_view_id" ref="view_delivery_metric_search"/>
    </record>
</odoo>
