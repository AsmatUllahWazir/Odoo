<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_delivery_route_form_advanced" model="ir.ui.view">
    <field name="name">delivery.route.form.advanced.pro</field><field name="model">delivery.route</field>
    <field name="inherit_id" ref="view_delivery_route_form"/><field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_acknowledge_by_driver" type="object" string="Driver Acknowledge" class="btn-secondary" invisible="state not in ['dispatched','in_transit'] or driver_acknowledged"/>
        <button name="action_create_exception" type="object" string="Raise Exception" class="btn-secondary" invisible="state in ['done','cancelled']"/>
        <button name="action_recalculate_operational_metrics" type="object" string="Recalculate" class="btn-secondary"/>
      </xpath>
      <xpath expr="//sheet//group[1]" position="after">
        <group string="Operational Readiness" col="4">
          <field name="priority" widget="priority"/>
          <field name="readiness_state" widget="badge" decoration-success="readiness_state == 'ready'" decoration-warning="readiness_state == 'warning'" decoration-danger="readiness_state == 'blocked'"/>
          <field name="readiness_score" widget="progressbar"/>
          <field name="open_exception_count"/>
        </group>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Control Tower">
          <group col="4">
            <group string="Dispatch Handover"><field name="loading_start"/><field name="loading_end"/><field name="handover_confirmed"/><field name="driver_acknowledged"/><field name="driver_acknowledged_at"/></group>
            <group string="Odometer"><field name="departure_odometer"/><field name="arrival_odometer"/><field name="odometer_distance"/></group>
            <group string="Execution"><field name="planned_stop_minutes"/><field name="actual_stop_minutes"/><field name="average_stop_minutes"/><field name="completion_percent"/></group>
            <group string="Commercial"><field name="revenue_per_km"/><field name="cost_per_km"/><field name="profit_per_stop"/><field name="service_level_percent"/></group>
          </group>
          <group string="SLA Health" col="4"><field name="sla_breached"/><field name="sla_breach_count"/><field name="exception_count"/><field name="dispatch_notes"/></group>
          <separator string="Operational Exceptions"/>
          <field name="exception_ids" readonly="state == 'cancelled'"><tree decoration-danger="priority == '3'" decoration-warning="priority == '2'"><field name="name"/><field name="exception_type"/><field name="priority" widget="priority"/><field name="state" widget="badge"/><field name="detected_at"/><field name="age_minutes"/><field name="owner_id"/></tree></field>
        </page>
      </xpath>
      <xpath expr="//field[@name='line_ids']/tree/field[@name='sequence']" position="after"><field name="priority" widget="priority"/><field name="customer_reference" optional="hide"/></xpath>
      <xpath expr="//field[@name='line_ids']/tree/field[@name='status']" position="after"><field name="on_time" optional="show"/><field name="gps_checkin_valid" optional="hide"/></xpath>
    </field>
  </record>

  <record id="view_delivery_route_line_tree_advanced" model="ir.ui.view"><field name="name">delivery.route.line.tree.advanced.pro</field><field name="model">delivery.route.line</field><field name="arch" type="xml"><tree decoration-success="status == 'delivered'" decoration-danger="status == 'failed'" decoration-warning="status in ['partial','retry']"><field name="sequence"/><field name="picking_id"/><field name="partner_id"/><field name="route_id"/><field name="priority" widget="priority"/><field name="status" widget="badge"/><field name="date_to"/><field name="on_time"/><field name="late_minutes"/><field name="package_count"/><field name="cod_amount"/><field name="cod_collected"/><field name="exception_count"/></tree></field></record>
  <record id="view_delivery_route_line_form_advanced" model="ir.ui.view"><field name="name">delivery.route.line.form.advanced.pro</field><field name="model">delivery.route.line</field><field name="arch" type="xml"><form><header><button name="action_mark_arrived" type="object" string="Arrive" class="btn-secondary" invisible="status not in ['assigned','in_transit']"/><button name="action_mark_delivered" type="object" string="Deliver" class="btn-primary" invisible="status not in ['arrived','in_transit']"/><button name="action_collect_cod" type="object" string="Collect COD" class="btn-secondary" invisible="cod_amount &lt;= 0 or cod_collected"/><button name="action_reschedule" type="object" string="Reschedule" class="btn-secondary" invisible="status in ['delivered','cancelled']"/><field name="status" widget="statusbar" statusbar_visible="pending,assigned,in_transit,arrived,delivered,partial,failed"/></header><sheet><div class="oe_title"><h1><field name="picking_id"/></h1></div><group col="4"><field name="route_id"/><field name="sequence"/><field name="priority" widget="priority"/><field name="partner_id"/><field name="date_from"/><field name="date_to"/><field name="weight"/><field name="volume"/><field name="cod_amount"/><field name="cod_collected"/></group><notebook><page string="Execution"><group col="4"><field name="promised_datetime"/><field name="arrival_time"/><field name="departure_time"/><field name="delivery_cycle_minutes"/><field name="waiting_minutes"/><field name="service_variance_minutes"/><field name="geofence_radius_m"/><field name="gps_distance_to_customer_m"/><field name="gps_checkin_valid"/></group></page><page string="GPS"><group col="2"><field name="latitude"/><field name="longitude"/><field name="checkin_latitude"/><field name="checkin_longitude"/><field name="checkout_latitude"/><field name="checkout_longitude"/></group></page><page string="Customer Experience"><group><field name="customer_rating"/><field name="customer_feedback"/><field name="delivery_instructions"/></group></page><page string="Exceptions"><field name="exception_ids"><tree><field name="name"/><field name="exception_type"/><field name="priority" widget="priority"/><field name="state"/><field name="description"/></tree></field></page></notebook><chatter/></sheet></form></field></record>
  <record id="action_delivery_route_line_advanced" model="ir.actions.act_window"><field name="name">Delivery Stops</field><field name="res_model">delivery.route.line</field><field name="view_mode">tree,form</field><field name="view_id" ref="view_delivery_route_line_tree_advanced"/></record>

  <record id="view_delivery_exception_tree" model="ir.ui.view"><field name="name">delivery.exception.tree</field><field name="model">delivery.exception</field><field name="arch" type="xml"><tree decoration-danger="priority == '3' and state != 'resolved'" decoration-warning="priority == '2' and state != 'resolved'"><field name="name"/><field name="priority" widget="priority"/><field name="exception_type"/><field name="state" widget="badge"/><field name="route_id"/><field name="route_line_id"/><field name="driver_id"/><field name="detected_at"/><field name="age_minutes"/><field name="owner_id"/></tree></field></record>
  <record id="view_delivery_exception_form" model="ir.ui.view"><field name="name">delivery.exception.form</field><field name="model">delivery.exception</field><field name="arch" type="xml"><form><header><button name="action_acknowledge" type="object" string="Acknowledge" class="btn-secondary" invisible="state != 'open'"/><button name="action_start" type="object" string="Start Work" class="btn-primary" invisible="state not in ['open','acknowledged']"/><button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state in ['resolved','cancelled']"/><button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state in ['resolved','cancelled']"/><field name="state" widget="statusbar" statusbar_visible="open,acknowledged,in_progress,resolved"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group col="4"><field name="priority" widget="priority"/><field name="exception_type"/><field name="route_id"/><field name="route_line_id"/><field name="driver_id"/><field name="vehicle_id"/><field name="owner_id"/><field name="customer_visible"/></group><notebook><page string="Issue"><group><field name="description"/><field name="resolution"/><field name="detected_at"/><field name="acknowledged_at"/><field name="resolved_at"/><field name="age_minutes"/></group></page><page string="Context"><group col="2"><field name="picking_id"/><field name="partner_id"/><field name="sla_minutes"/><field name="auto_created"/></group></page></notebook></sheet><chatter/></form></field></record>
  <record id="view_delivery_exception_search" model="ir.ui.view"><field name="name">delivery.exception.search</field><field name="model">delivery.exception</field><field name="arch" type="xml"><search><field name="name"/><field name="route_id"/><field name="route_line_id"/><field name="driver_id"/><field name="exception_type"/><field name="state"/><filter name="open" string="Open" domain="[('state','in',['open','acknowledged','in_progress'])]"/><filter name="critical" string="Critical" domain="[('priority','=','3'),('state','not in',['resolved','cancelled'])]"/><filter name="late" string="Late" domain="[('exception_type','=','late')]"/><group expand="0" string="Group By"><filter name="type" string="Type" context="{'group_by':'exception_type'}"/><filter name="priority" string="Priority" context="{'group_by':'priority'}"/><filter name="state_group" string="State" context="{'group_by':'state'}"/></group></search></field></record>
  <record id="action_delivery_exception" model="ir.actions.act_window"><field name="name">Exception Control Desk</field><field name="res_model">delivery.exception</field><field name="view_mode">tree,form</field><field name="search_view_id" ref="view_delivery_exception_search"/><field name="context">{'search_default_open': 1}</field></record>
</odoo>
