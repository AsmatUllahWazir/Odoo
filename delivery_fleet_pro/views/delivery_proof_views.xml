<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_proof_tree" model="ir.ui.view"><field name="name">delivery.proof.tree</field><field name="model">delivery.proof</field><field name="arch" type="xml"><tree decoration-success="status == 'verified'" decoration-danger="status == 'rejected'"><field name="name"/><field name="route_id"/><field name="partner_id"/><field name="recipient_name"/><field name="signed_at"/><field name="otp_verified"/><field name="status"/></tree></field></record>
    <record id="view_delivery_proof_form" model="ir.ui.view"><field name="name">delivery.proof.form</field><field name="model">delivery.proof</field><field name="arch" type="xml"><form><header><button name="action_generate_otp" type="object" string="Generate OTP" invisible="status == 'verified'"/><button name="action_verify" type="object" string="Verify POD" class="btn-primary" invisible="status == 'verified'"/><button name="action_reject" type="object" string="Reject" invisible="status == 'verified'"/><button name="action_print" type="object" string="Print" invisible="not id"/><field name="status" widget="statusbar" statusbar_visible="draft,verified,rejected"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="route_id"/><field name="route_line_id"/><field name="picking_id"/><field name="partner_id"/><field name="driver_id"/></group><group><field name="recipient_name"/><field name="recipient_phone"/><field name="recipient_relation"/><field name="captured_at"/><field name="signed_at"/></group></group><notebook><page string="Signature"><field name="signature" widget="image"/></page><page string="Photos"><field name="photo" widget="image"/><field name="photo_2" widget="image"/><field name="photo_3" widget="image"/></page><page string="OTP"><group><field name="otp" password="True"/><field name="otp_generated_at"/><field name="otp_expires_at"/><field name="otp_verified"/><field name="otp_verified_at"/></group></page><page string="GPS"><group><field name="latitude"/><field name="longitude"/><field name="accuracy_meters"/></group></page><page string="Notes"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_delivery_proof" model="ir.actions.act_window"><field name="name">Proofs of Delivery</field><field name="res_model">delivery.proof</field><field name="view_mode">tree,form</field></record>
</odoo>
