<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="delivery_tracking_page" name="Delivery Tracking Page">
    <html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Track Delivery · Delivery Fleet Pro</title><link rel="stylesheet" href="/delivery_fleet_pro/static/src/css/delivery_portal.css"/><script type="module" src="/delivery_fleet_pro/static/src/js/delivery_tracking.js"/></head>
    <body class="dfp-portal-body"><main class="dfp-public" t-att-data-delivery-token="token">
      <nav class="dfp-public-nav"><div class="dfp-logo"><span>DF</span><div><b>Delivery Fleet Pro</b><small>Secure delivery visibility</small></div></div><div class="dfp-live-indicator"><i/> Live tracking</div></nav>
      <section class="dfp-public-hero"><div><span class="dfp-overline">DELIVERY STATUS</span><h1>Your delivery is <span data-delivery-status="1"><t t-esc="dict(line._fields['status'].selection).get(line.status, line.status)"/></span></h1><p>Follow the latest milestone, delivery progress and customer-safe tracking information.</p></div><div class="dfp-hero-route"><span>ROUTE</span><strong><t t-esc="route.name"/></strong><small><t t-esc="route.date"/></small></div></section>
      <section class="dfp-public-kpis"><div><span>Delivery</span><strong><t t-esc="line.picking_id.name"/></strong><small><t t-esc="partner.name"/></small></div><div><span>Progress</span><strong data-delivery-progress-label="1"><t t-esc="'%s / %s delivered' % (route.delivered_count, route.stop_count)"/></strong><div class="dfp-progress"><i data-delivery-progress="1" t-att-style="'width:%s%%' % ((route.delivered_count / route.stop_count * 100) if route.stop_count else 0)"/></div></div><div><span>Packages</span><strong><t t-esc="line.package_count"/></strong><small><t t-esc="line.weight"/> kg total</small></div><div><span>Window</span><strong><t t-esc="line.date_from or 'Flexible'"/></strong><small><t t-if="line.date_to"><t t-esc="line.date_to"/></t><t t-else="">No fixed end time</t></small></div></section>
      <section class="dfp-public-layout"><div class="dfp-main-col">
        <article class="dfp-card"><header><div><span class="dfp-overline">LIVE MILESTONES</span><h2>Delivery journey</h2></div><span class="dfp-live-chip"><i/> Updating automatically</span></header><div class="dfp-timeline"><t t-if="events"><t t-foreach="events" t-as="event"><div class="dfp-timeline-item"><span class="dfp-timeline-dot"/><div><div class="dfp-timeline-title"><strong><t t-esc="event.name"/></strong><time><t t-esc="event.event_datetime"/></time></div><p t-if="event.description"><t t-esc="event.description"/></p><small><t t-esc="event.source or 'Operations'"/></small></div></div></t></t><t t-else=""><div class="dfp-empty"><b>Tracking is ready</b><span>The first customer-visible milestone will appear here.</span></div></t></div></article>
        <article class="dfp-card"><header><div><span class="dfp-overline">DELIVERY CONTEXT</span><h2>At a glance</h2></div></header><div class="dfp-detail-grid"><div><span>Customer</span><strong><t t-esc="partner.name"/></strong></div><div><span>Address</span><strong><t t-esc="line.address or 'Address on file'"/></strong></div><div><span>Service</span><strong><t t-esc="route.service_type_id.name or 'Standard delivery'"/></strong></div><div><span>SLA</span><strong><t t-esc="route.sla_id.name or 'Standard service level'"/></strong></div><div><span>Stop</span><strong>#<t t-esc="line.sequence"/></strong></div><div><span>Contact</span><strong><t t-esc="line.phone or line.mobile or 'Customer contact on file'"/></strong></div></div></article>
        <article class="dfp-card" t-if="line.package_ids"><header><div><span class="dfp-overline">SHIPMENT CONTENT</span><h2>Packages</h2></div></header><div class="dfp-package-list"><t t-foreach="line.package_ids" t-as="package"><div><span class="dfp-package-icon">▦</span><div><strong><t t-esc="package.name"/></strong><small><t t-esc="package.package_type"/> · <t t-esc="package.weight"/> kg<t t-if="package.barcode"> · <t t-esc="package.barcode"/></t></small></div><em><t t-esc="'Delivered' if package.delivered else 'In shipment'"/></em></div></t></div></article>
      </div><aside class="dfp-side-col">
        <article class="dfp-card dfp-location"><header><div><span class="dfp-overline">DELIVERY LOCATION</span><h2>Destination</h2></div></header><div class="dfp-map"><div class="dfp-map-grid"/><span class="dfp-map-pin">●</span><div><t t-if="line.latitude and line.longitude"><b>GPS coordinates available</b><small><t t-esc="'%.6f, %.6f' % (line.latitude, line.longitude)"/></small><a target="_blank" t-att-href="'https://www.google.com/maps/search/?api=1&amp;query=%s,%s' % (line.latitude,line.longitude)">Open in maps ↗</a></t><t t-else=""><b>GPS not yet captured</b><small>Location will be updated when field coordinates are available.</small></t></div></div></article>
        <article class="dfp-card"><header><div><span class="dfp-overline">PROOF OF DELIVERY</span><h2>Confirmation</h2></div></header><t t-if="line.proof_id"><div class="dfp-pod-status"><b><t t-esc="line.proof_id.status"/></b><span><t t-esc="'OTP verified' if line.proof_id.otp_verified else 'OTP not required / pending'"/></span></div><div class="dfp-recipient"><span>Recipient</span><strong><t t-esc="line.proof_id.recipient_name or 'Recorded recipient'"/></strong><small><t t-esc="line.proof_id.signed_at or line.proof_id.captured_at"/></small></div><div class="dfp-signature" t-if="line.proof_id.signature"><img t-att-src="image_data_uri(line.proof_id.signature)" alt="Signature"/></div></t><t t-else=""><div class="dfp-empty dfp-empty-small"><b>Not completed yet</b><span>Proof details will appear after delivery confirmation.</span></div></t></article>
        <article class="dfp-card dfp-help"><span class="dfp-overline">NEED HELP?</span><h2>Contact your delivery team</h2><p>Keep this tracking page available when contacting customer service about this shipment.</p><a t-if="line.phone" t-att-href="'tel:%s' % line.phone" class="dfp-button dfp-button-primary">Call customer</a></article>
      </aside></section>
      <section class="dfp-public-actions"><button class="dfp-button dfp-button-primary" data-delivery-refresh="1">Refresh status</button><button class="dfp-button dfp-button-secondary" data-delivery-copy="1">Copy tracking link</button></section><div class="dfp-error" data-delivery-error="1" hidden="hidden"/><footer>Delivery Fleet Pro · Secure customer tracking · <span data-delivery-updated="1"/></footer>
    </main></body></html>
  </template>

  <template id="portal_my_deliveries" name="My Deliveries"><t t-call="portal.portal_layout"><div class="dfp-portal-page"><div class="dfp-portal-container"><div class="dfp-portal-top"><div><span class="dfp-overline">CUSTOMER PORTAL</span><h1>My Deliveries</h1><p>Track active shipments, review delivery milestones and access secure tracking pages.</p></div><a href="/my/deliveries" class="dfp-button dfp-button-secondary">Refresh</a></div><section class="dfp-customer-kpis"><div><span>Total</span><strong><t t-esc="len(links)"/></strong><small>Tracking links</small></div><div><span>In progress</span><strong><t t-esc="active_count"/></strong><small>Active deliveries</small></div><div><span>Delivered</span><strong><t t-esc="delivered_count"/></strong><small>Completed</small></div><div><span>Exceptions</span><strong><t t-esc="failed_count"/></strong><small>Needs attention</small></div></section><div class="dfp-customer-list"><t t-if="links"><t t-foreach="links" t-as="link"><article class="dfp-customer-card"><div class="dfp-customer-card-head"><div><span class="dfp-overline">SHIPMENT</span><h2><t t-esc="link.route_line_id.picking_id.name"/></h2><p><t t-esc="link.partner_id.name"/> · <t t-esc="link.route_id.name"/></p></div><span class="dfp-status-badge"><t t-esc="dict(link.route_line_id._fields['status'].selection).get(link.route_line_id.status, link.route_line_id.status)"/></span></div><div class="dfp-customer-progress"><div><span>Route progress</span><b><t t-esc="link.route_line_id.route_id.delivered_count"/> / <t t-esc="link.route_line_id.route_id.stop_count"/></b></div><div class="dfp-progress"><i t-att-style="'width:%s%%' % ((link.route_line_id.route_id.delivered_count / link.route_line_id.route_id.stop_count * 100) if link.route_line_id.route_id.stop_count else 0)"/></div></div><div class="dfp-customer-meta"><div><span>Date</span><strong><t t-esc="link.route_id.date"/></strong></div><div><span>Stop</span><strong>#<t t-esc="link.route_line_id.sequence"/></strong></div><div><span>Packages</span><strong><t t-esc="link.route_line_id.package_count"/></strong></div><div><span>Address</span><strong><t t-esc="link.route_line_id.address or 'Address on file'"/></strong></div></div><div class="dfp-customer-actions"><a t-att-href="'/my/deliveries/%s' % link.route_line_id.id" class="dfp-button dfp-button-primary">View delivery</a><a t-att-href="'/delivery/track/%s' % link.token" class="dfp-button dfp-button-secondary">Live tracking</a></div></article></t></t><t t-else=""><div class="dfp-empty"><b>No deliveries yet</b><span>Secure delivery links will appear here when shipments are available.</span></div></t></div></div></div></t></template>

  <template id="portal_delivery_detail" name="Delivery Detail"><t t-call="portal.portal_layout"><div class="dfp-portal-page"><div class="dfp-portal-container"><a href="/my/deliveries" class="dfp-back">← Back to My Deliveries</a><div class="dfp-detail-top"><div><span class="dfp-overline">SHIPMENT DETAIL</span><h1><t t-esc="line.picking_id.name"/></h1><p><t t-esc="line.address or 'Delivery address on file'"/></p></div><span class="dfp-status-badge dfp-status-large"><t t-esc="dict(line._fields['status'].selection).get(line.status, line.status)"/></span></div><section class="dfp-customer-detail-grid"><div class="dfp-detail-main"><article class="dfp-card"><header><div><span class="dfp-overline">DELIVERY JOURNEY</span><h2>Milestones</h2></div></header><div class="dfp-timeline"><t t-if="events"><t t-foreach="events" t-as="event"><div class="dfp-timeline-item"><span class="dfp-timeline-dot"/><div><div class="dfp-timeline-title"><strong><t t-esc="event.name"/></strong><time><t t-esc="event.event_datetime"/></time></div><p t-if="event.description"><t t-esc="event.description"/></p></div></div></t></t><t t-else=""><div class="dfp-empty"><b>No milestones yet</b><span>Delivery events will be displayed here.</span></div></t></div></article><article class="dfp-card"><header><div><span class="dfp-overline">SHIPMENT</span><h2>Packages &amp; service</h2></div></header><div class="dfp-detail-grid"><div><span>Service</span><strong><t t-esc="route.service_type_id.name or 'Standard'"/></strong></div><div><span>SLA</span><strong><t t-esc="route.sla_id.name or 'Standard'"/></strong></div><div><span>Packages</span><strong><t t-esc="line.package_count"/></strong></div><div><span>Weight</span><strong><t t-esc="line.weight"/> kg</strong></div><div><span>Delivery window</span><strong><t t-esc="line.date_from or 'Flexible'"/></strong></div><div><span>Reference</span><strong><t t-esc="line.customer_reference or line.picking_id.origin or '—'"/></strong></div></div></article></div><aside class="dfp-detail-side"><article class="dfp-card"><span class="dfp-overline">ROUTE</span><h2><t t-esc="route.name"/></h2><div class="dfp-definition"><div><span>Driver</span><b><t t-esc="route.driver_id.name or 'Dispatch assigned'"/></b></div><div><span>Vehicle</span><b><t t-esc="route.vehicle_id.name or 'Dispatch assigned'"/></b></div><div><span>Stop</span><b>#<t t-esc="line.sequence"/></b></div></div></article><article class="dfp-card"><span class="dfp-overline">LIVE TRACKING</span><h2>Secure public status</h2><p>Open the customer-safe tracking page to see the latest status without signing in.</p><a t-if="line.tracking_link_id and line.tracking_link_id.active" t-att-href="'/delivery/track/%s' % line.tracking_link_id.token" class="dfp-button dfp-button-primary dfp-button-full">Open live tracking</a></article></aside></section></div></div></t></template>
</odoo>
