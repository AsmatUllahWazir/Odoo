<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_retry_tree" model="ir.ui.view"><field name="name">delivery.retry.tree</field><field name="model">delivery.retry</field><field name="arch" type="xml"><tree decoration-success="state == 'created'"><field name="name"/><field name="scheduled_date"/><field name="customer_id"/><field name="picking_id"/><field name="attempt_number"/><field name="reason_id"/><field name="state"/></tree></field></record>
    <record id="view_delivery_retry_form" model="ir.ui.view"><field name="name">delivery.retry.form</field><field name="model">delivery.retry</field><field name="arch" type="xml"><form><header><button name="action_create_retry" type="object" string="Create Retry Route" class="btn-primary" invisible="state != 'scheduled'"/><field name="state" widget="statusbar" statusbar_visible="scheduled,created,cancelled"/></header><sheet><group><group><field name="name"/><field name="scheduled_date"/><field name="attempt_number"/><field name="state"/></group><group><field name="customer_id"/><field name="picking_id"/><field name="reason_id"/><field name="retry_line_id"/></group></group><field name="notes"/></sheet><chatter/></form></field></record>
    <record id="action_delivery_retry" model="ir.actions.act_window"><field name="name">Retry Schedule</field><field name="res_model">delivery.retry</field><field name="view_mode">tree,calendar,form</field></record>
</odoo>
