    <record id="view_delivery_route_calendar" model="ir.ui.view">
        <field name="name">delivery.route.calendar</field>
        <field name="model">delivery.route</field>
        <field name="arch" type="xml">
            <calendar string="Delivery Routes" date_start="planned_start" date_stop="planned_end" color="driver_id" mode="day" quick_create="0"><field name="name"/><field name="driver_id"/><field name="vehicle_id"/><field name="state"/></calendar>
        </field>
    </record>

    <record id="view_delivery_retry_calendar" model="ir.ui.view">
        <field name="name">delivery.retry.calendar</field>
        <field name="model">delivery.retry</field>
        <field name="arch" type="xml">
            <calendar string="Retry Schedule" date_start="scheduled_date" color="state"><field name="name"/><field name="customer_id"/><field name="reason_id"/><field name="state"/></calendar>
        </field>
    </record>

    <record id="view_driver_schedule_calendar" model="ir.ui.view">
        <field name="name">delivery.driver.schedule.calendar</field>
        <field name="model">delivery.driver.schedule</field>
        <field name="arch" type="xml">
            <calendar string="Driver Availability" date_start="date" color="employee_id"><field name="employee_id"/><field name="available"/><field name="start_hour"/><field name="end_hour"/></calendar>
        </field>
    </record>
</odoo>
