<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record id="document_expiry_type_passport" model="document.expiry.type">
        <field name="name">Passport</field>
        <field name="code">PASSPORT</field>
        <field name="sequence">10</field>
    </record>
    <record id="document_expiry_type_driving_license" model="document.expiry.type">
        <field name="name">Driving License</field>
        <field name="code">LICENSE</field>
        <field name="sequence">20</field>
    </record>
    <record id="document_expiry_type_work_permit" model="document.expiry.type">
        <field name="name">Work Permit / Visa</field>
        <field name="code">PERMIT</field>
        <field name="sequence">30</field>
    </record>
    <record id="document_expiry_type_insurance" model="document.expiry.type">
        <field name="name">Insurance Policy</field>
        <field name="code">INSURANCE</field>
        <field name="sequence">40</field>
    </record>
    <record id="document_expiry_type_contract" model="document.expiry.type">
        <field name="name">Contract / Agreement</field>
        <field name="code">CONTRACT</field>
        <field name="sequence">50</field>
    </record>
    <record id="document_expiry_type_certification" model="document.expiry.type">
        <field name="name">Certification</field>
        <field name="code">CERTIFICATION</field>
        <field name="sequence">60</field>
    </record>
    <record id="document_expiry_type_warranty" model="document.expiry.type">
        <field name="name">Warranty</field>
        <field name="code">WARRANTY</field>
        <field name="sequence">70</field>
    </record>
    <record id="document_expiry_type_other" model="document.expiry.type">
        <field name="name">Other</field>
        <field name="code">OTHER</field>
        <field name="sequence">100</field>
    </record>

    <record id="ir_cron_document_expiry_check" model="ir.cron">
        <field name="name">Document Expiry Tracker: Check &amp; Notify</field>
        <field name="model_id" ref="model_document_expiry"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
