<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_document_expiry" model="ir.module.category">
        <field name="name">Document Expiry Tracker</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_document_expiry_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_document_expiry"/>
    </record>

    <record id="group_document_expiry_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_document_expiry"/>
        <field name="implied_ids" eval="[(4, ref('group_document_expiry_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="document_expiry_company_rule" model="ir.rule">
        <field name="name">Document Expiry: multi-company</field>
        <field name="model_id" ref="model_document_expiry"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_document_expiry_user'))]"/>
    </record>

    <record id="document_expiry_type_company_rule" model="ir.rule">
        <field name="name">Document Expiry Type: multi-company</field>
        <field name="model_id" ref="model_document_expiry_type"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_document_expiry_user'))]"/>
    </record>
</odoo>
