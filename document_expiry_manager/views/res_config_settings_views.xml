<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.document.expiry</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Document Expiry" string="Document Expiry"
                     data-key="document_expiry_manager" groups="document_expiry_manager.group_document_expiry_manager">
                    <h2>Document Expiry Tracker</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="document_expiry_default_warning_days" string="Default Warning Window (days)"/>
                                <div class="text-muted">
                                    Days before expiry at which a new document is flagged 'Expiring Soon' by default.
                                </div>
                                <field name="document_expiry_default_warning_days"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="document_expiry_default_reminder_schedule" string="Default Reminder Schedule"/>
                                <div class="text-muted">
                                    Comma separated day thresholds (before expiry) used for new documents.
                                </div>
                                <field name="document_expiry_default_reminder_schedule"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
