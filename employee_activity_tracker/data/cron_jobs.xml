<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================
             Cron: Update Idle/Expired Sessions (every 15 minutes)
             ================================================================ -->
        <record id="cron_update_session_status" model="ir.cron">
            <field name="name">Activity Tracker: Update Session Status</field>
            <field name="model_id" ref="model_activity_tracker_session"/>
            <field name="state">code</field>
            <field name="code">model.cron_cleanup_sessions()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="priority">5</field>
        </record>

        <!-- ================================================================
             Cron: Send Daily Activity Report (every day at 8 PM)
             ================================================================ -->
        <record id="cron_daily_activity_report" model="ir.cron">
            <field name="name">Activity Tracker: Send Daily Report</field>
            <field name="model_id" ref="model_activity_tracker_log"/>
            <field name="state">code</field>
            <field name="code">
# Send daily report if enabled
param = env['ir.config_parameter'].sudo().get_param('activity_tracker.send_daily_report', 'True')
if param.lower() in ('true', '1', 'yes'):
    template = env.ref('employee_activity_tracker.email_template_daily_report', raise_if_not_found=False)
    if template:
        alert_email = env['ir.config_parameter'].sudo().get_param('activity_tracker.alert_email', '')
        if alert_email:
            template.sudo().with_context(email_to=alert_email).send_mail(1, force_send=True)
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>

        <!-- ================================================================
             Cron: Log Cleanup / Retention Policy (weekly)
             ================================================================ -->
        <record id="cron_log_cleanup" model="ir.cron">
            <field name="name">Activity Tracker: Log Cleanup (Retention Policy)</field>
            <field name="model_id" ref="model_activity_tracker_log"/>
            <field name="state">code</field>
            <field name="code">model.cron_cleanup_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="priority">20</field>
        </record>

        <!-- ================================================================
             Cron: Check Suspicious Activity (every hour)
             ================================================================ -->
        <record id="cron_suspicious_activity_check" model="ir.cron">
            <field name="name">Activity Tracker: Suspicious Activity Alert</field>
            <field name="model_id" ref="model_activity_tracker_security_log"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_suspicious_activity()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>

        <!-- ================================================================
             Cron: Send Weekly Productivity Report (every Monday)
             ================================================================ -->
        <record id="cron_weekly_productivity_report" model="ir.cron">
            <field name="name">Activity Tracker: Send Weekly Productivity Report</field>
            <field name="model_id" ref="model_activity_tracker_log"/>
            <field name="state">code</field>
            <field name="code">
param = env['ir.config_parameter'].sudo().get_param('activity_tracker.send_weekly_report', 'True')
if param.lower() in ('true', '1', 'yes'):
    template = env.ref('employee_activity_tracker.email_template_weekly_report', raise_if_not_found=False)
    if template:
        alert_email = env['ir.config_parameter'].sudo().get_param('activity_tracker.alert_email', '')
        if alert_email:
            template.sudo().with_context(email_to=alert_email).send_mail(1, force_send=True)
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>