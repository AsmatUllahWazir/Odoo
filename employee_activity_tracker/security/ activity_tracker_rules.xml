<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Users can only see their own session logs -->
        <record id="rule_session_log_user_own" model="ir.rule">
            <field name="name">Session Log: User sees own sessions</field>
            <field name="model_id" ref="model_activity_tracker_session"/>
            <field name="groups" eval="[(4, ref('group_tracker_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Managers see all sessions -->
        <record id="rule_session_log_manager_all" model="ir.rule">
            <field name="name">Session Log: Manager sees all</field>
            <field name="model_id" ref="model_activity_tracker_session"/>
            <field name="groups" eval="[(4, ref('group_tracker_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Users can only see their own activity logs -->
        <record id="rule_activity_log_user_own" model="ir.rule">
            <field name="name">Activity Log: User sees own activities</field>
            <field name="model_id" ref="model_activity_tracker_log"/>
            <field name="groups" eval="[(4, ref('group_tracker_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

        <!-- Managers see all activity logs -->
        <record id="rule_activity_log_manager_all" model="ir.rule">
            <field name="name">Activity Log: Manager sees all</field>
            <field name="model_id" ref="model_activity_tracker_log"/>
            <field name="groups" eval="[(4, ref('group_tracker_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Users see own field changes -->
        <record id="rule_field_change_user_own" model="ir.rule">
            <field name="name">Field Change: User sees own changes</field>
            <field name="model_id" ref="model_activity_tracker_field_change"/>
            <field name="groups" eval="[(4, ref('group_tracker_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

        <!-- Managers see all field changes -->
        <record id="rule_field_change_manager_all" model="ir.rule">
            <field name="name">Field Change: Manager sees all</field>
            <field name="model_id" ref="model_activity_tracker_field_change"/>
            <field name="groups" eval="[(4, ref('group_tracker_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>