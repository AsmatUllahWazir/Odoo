<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================================
         User Status List View
         ==================================================================== -->
    <record id="view_tracker_user_status_tree" model="ir.ui.view">
        <field name="name">res.users.tracker.status.tree</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <tree string="Users Activity Status">
                <field name="image_128" widget="image" class="o_list_avatar" optional="show"/>
                <field name="name"/>
                <field name="login"/>
                <field name="tracker_session_status" string="Status" widget="badge"/>
                <field name="tracker_last_login" string="Last Login"/>
                <field name="tracker_current_ip" string="IP"/>
                <field name="tracker_session_count" string="Total Sessions"/>
                <field name="tracker_activity_count" string="Actions Today"/>
                <button name="action_view_user_sessions" type="object"
                        string="Sessions" icon="fa-clock-o" class="btn-sm btn-secondary"/>
                <button name="action_view_user_activities" type="object"
                        string="Timeline" icon="fa-list" class="btn-sm btn-info"/>
            </tree>
        </field>
    </record>

