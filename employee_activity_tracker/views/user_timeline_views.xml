    <record id="action_tracker_user_status" model="ir.actions.act_window">
        <field name="name">User Activity Status</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">tree,form</field>
<!--        <field name="search_view_id" ref="view_tracker_user_status_search"/>-->
        <field name="domain">[('share', '=', False), ('active', '=', True)]</field>
        <field name="context">{'search_default_online_users': 1}</field>
    </record>

    <!-- ====================================================================
         Full Timeline View
         ==================================================================== -->
    <record id="view_tracker_full_timeline_tree" model="ir.ui.view">
        <field name="name">activity.tracker.log.full.timeline</field>
        <field name="model">activity.tracker.log</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <tree string="Full User Timeline">
                <field name="action_datetime" string="Time"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="action_type" widget="badge"/>
                <field name="action_summary" string="What Happened"/>
                <field name="module_name" string="Module"/>
                <field name="model_description" string="Object" optional="show"/>
                <field name="record_name" string="Document" optional="show"/>
                <field name="result" widget="badge"/>
                <field name="session_id" optional="hide"/>
                <field name="ip_address" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="action_tracker_full_timeline" model="ir.actions.act_window">
        <field name="name">Full Activity Timeline</field>
        <field name="res_model">activity.tracker.log</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_tracker_full_timeline_tree"/>
        <field name="context">{'search_default_today': 1}</field>
    </record>

</odoo>