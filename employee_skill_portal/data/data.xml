<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo data for skills -->
    <record id="demo_skill_python" model="employee.skill">
        <field name="name">Python Programming</field>
        <field name="skill_type">technical</field>
        <field name="level">expert</field>
        <field name="years_experience">8</field>
        <field name="icon">fa-code</field>
        <field name="color">#3776ab</field>
        <field name="description">Expert in Python development with Django, Flask, and data science libraries.
            Specialized in backend development and automation.
        </field>
        <field name="is_verified">True</field>
        <field name="rating">4.8</field>
    </record>

    <record id="demo_skill_pmp" model="employee.skill">
        <field name="name">Project Management Professional (PMP)</field>
        <field name="skill_type">certification</field>
        <field name="level">expert</field>
        <field name="certification_org">Project Management Institute</field>
        <field name="certificate_id">PMP-123456</field>
        <field name="icon">fa-award</field>
        <field name="color">#10b981</field>
        <field name="description">Certified Project Management Professional with expertise in Agile and Waterfall
            methodologies.
        </field>
        <field name="is_verified">True</field>
        <field name="rating">4.9</field>
    </record>

    <record id="demo_skill_leadership" model="employee.skill">
        <field name="name">Team Leadership</field>
        <field name="skill_type">soft</field>
        <field name="level">advanced</field>
        <field name="years_experience">5</field>
        <field name="icon">fa-users</field>
        <field name="color">#f59e0b</field>
        <field name="description">Experienced in leading cross-functional teams, mentoring junior developers, and
            facilitating agile ceremonies.
        </field>
        <field name="is_verified">True</field>
        <field name="rating">4.7</field>
    </record>

    <!-- Demo endorsements -->
    <record id="demo_endorsement_1" model="skill.endorsement">
        <field name="skill_id" ref="demo_skill_python"/>
        <field name="endorser_id" ref="base.partner_admin"/>
        <field name="comment">John is an exceptional Python developer who consistently delivers high-quality code. His
            expertise in Django is remarkable.
        </field>
        <field name="state">approved</field>
    </record>

    <!-- Server Actions -->
    <record id="action_verify_selected" model="ir.actions.server">
        <field name="name">Verify Selected Skills</field>
        <field name="model_id" ref="model_employee_skill"/>
        <field name="binding_model_id" ref="model_employee_skill"/>
        <field name="state">code</field>
        <field name="code">
            for skill in records:
            skill.write({
            'is_verified': True,
            'verification_date': fields.Date.today()
            })
        </field>
    </record>

    <record id="action_calculate_avg_rating" model="ir.actions.server">
        <field name="name">Calculate Average Ratings</field>
        <field name="model_id" ref="model_employee_skill"/>
        <field name="state">code</field>
        <field name="code">
            for employee in env['hr.employee'].search([]):
            skills = env['employee.skill'].search([('employee_id', '=', employee.id)])
            if skills:
            avg_rating = sum(skills.mapped('rating')) / len(skills)
            # You can store this in a field if needed
            env.cr.execute("""
            UPDATE hr_employee
            SET skill_avg_rating = %s
            WHERE id = %s
            """, (avg_rating, employee.id))
        </field>
    </record>
</odoo>