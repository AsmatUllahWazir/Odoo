<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Patient ID Sequence -->
        <record id="seq_lims_patient" model="ir.sequence">
            <field name="name">LIMS Patient</field>
            <field name="code">lims.patient</field>
            <field name="prefix">PAT-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Test Order Sequence -->
        <record id="seq_lims_test_order" model="ir.sequence">
            <field name="name">LIMS Test Order</field>
            <field name="code">lims.test.order</field>
            <field name="prefix">ORD-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sample ID Sequence -->
        <record id="seq_lims_sample" model="ir.sequence">
            <field name="name">LIMS Sample</field>
            <field name="code">lims.sample</field>
            <field name="prefix">SMP-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_lims_quality_control" model="ir.sequence">
            <field name="name">LIMS Quality Control</field>
            <field name="code">lims.quality.control</field>
            <field name="prefix">QC-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Instrument Sequence (optional) -->
        <record id="seq_lims_instrument" model="ir.sequence">
            <field name="name">LIMS Instrument</field>
            <field name="code">lims.instrument</field>
            <field name="prefix">INS-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>