<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== TREE VIEW ===================== -->
    <record id="view_lims_quality_control_tree" model="ir.ui.view">
        <field name="name">lims.quality_control.tree</field>
        <field name="model">lims.quality_control</field>
        <field name="arch" type="xml">
            <tree string="Quality Control" decoration-danger="is_passed==False" decoration-success="is_passed==True">
                <field name="name"/>
                <field name="test_type_id"/>
                <field name="date"/>
                <field name="technician_id"/>
                <field name="qc_type" widget="badge"/>
                <field name="result_value"/>
                <field name="target_value"/>
                <field name="tolerance"/>
                <field name="is_passed" widget="boolean_favorite"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ===================== KANBAN VIEW ===================== -->
    <record id="view_lims_quality_control_kanban" model="ir.ui.view">
        <field name="name">lims.quality_control.kanban</field>
        <field name="model">lims.quality_control</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="test_type_id"/>
                <field name="date"/>
                <field name="is_passed"/>
                <field name="state"/>
                <field name="qc_type"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <span class="fa fa-check-circle" style="font-size: 48px;"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <field name="test_type_id"/>
                                    </div>
                                    <div>
                                        <field name="qc_type" widget="badge"/>
                                        <field name="state" widget="badge"/>
                                    </div>
                                    <div>
                                        Result: <field name="result_value"/> / <field name="target_value"/>
                                    </div>
                                    <div>
                                        <field name="is_passed" widget="boolean_favorite"/>
                                        Deviation: <field name="deviation_percentage"/>%
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_lims_quality_control_form" model="ir.ui.view">
        <field name="name">lims.quality_control.form</field>
        <field name="model">lims.quality_control</field>
        <field name="arch" type="xml">
            <form string="Quality Control">
                <header>
                    <button name="action_review" type="object"
                            string="Submit for Review"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve"
                            class="oe_highlight"
                            invisible="state != 'review'"/>
                    <button name="action_reject" type="object"
                            string="Reject"
                            class="oe_highlight"
                            invisible="state != 'review'"/>
                    <button name="action_require_corrective" type="object"
                            string="Require Corrective Action"
                            class="oe_highlight"
                            invisible="state not in ['draft','review']"/>
                    <button name="action_validate" type="object"
                            string="Validate"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            class="oe_highlight"
                            invisible="state in ['draft']"/>
                    <button name="action_print_qc_report" type="object"
                            string="Print Report"
                            class="oe_highlight"
                            icon="fa-print"/>
                    <button name="action_generate_qc_chart" type="object"
                            string="Generate Chart"
                            class="oe_highlight"
                            icon="fa-bar-chart"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,approved,rejected,corrective"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="QC Reference"/>
                        </h1>
                        <h3>
                            <field name="test_type_id"/>
                            <field name="instrument_id" invisible="not instrument_id"/>
                        </h3>
                    </div>
<!--                    <div class="oe_button_box" name="button_box">-->
<!--                        <button name="action_view_order" type="object"-->
<!--                                class="oe_stat_button"-->
<!--                                icon="fa-file-text-o"-->
<!--                                invisible="not test_order_id">-->
<!--                            <span class="o_stat_text">Order</span>-->
<!--                        </button>-->
<!--                        <button name="action_view_patient" type="object"-->
<!--                                class="oe_stat_button"-->
<!--                                icon="fa-user"-->
<!--                                invisible="not patient_id">-->
<!--                            <span class="o_stat_text">Patient</span>-->
<!--                        </button>-->
<!--                        <button name="action_view_sample" type="object"-->
<!--                                class="oe_stat_button"-->
<!--                                icon="fa-tint"-->
<!--                                invisible="not sample_id">-->
<!--                            <span class="o_stat_text">Sample</span>-->
<!--                        </button>-->
<!--                    </div>-->
                    <notebook>
                        <!-- ===== Page: QC Details ===== -->
                        <page string="QC Details" name="details">
                            <group>
                                <group string="QC Information">
                                    <field name="test_type_id"/>
                                    <field name="qc_type"/>
                                    <field name="date"/>
                                    <field name="technician_id"/>
                                    <field name="supervisor_id" readonly="1"/>
                                    <field name="instrument_id"/>
                                    <field name="instrument_name" readonly="1"/>
                                </group>
                                <group string="QC Results">
                                    <field name="result_value"/>
                                    <field name="target_value"/>
                                    <field name="tolerance"/>
                                    <field name="lower_limit" readonly="1"/>
                                    <field name="upper_limit" readonly="1"/>
                                    <field name="is_passed" widget="boolean_favorite" readonly="1"/>
                                    <field name="deviation" readonly="1"/>
                                    <field name="deviation_percentage" readonly="1" widget="percentage"/>
                                </group>
                            </group>
                            <group string="Statistical Analysis">
                                <group>
                                    <field name="mean_value" readonly="1"/>
                                    <field name="standard_deviation" readonly="1"/>
                                </group>
                                <group>
                                    <field name="coefficient_variation" readonly="1" widget="percentage"/>
                                    <field name="z_score" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- ===== Page: Control Materials ===== -->
                        <page string="Control Materials" name="materials">
                            <group>
                                <group string="Material Information">
                                    <field name="control_material"/>
                                    <field name="lot_number"/>
                                    <field name="expiry_date"/>
                                    <field name="is_valid" widget="boolean_favorite" readonly="1"/>
                                </group>
                                <group string="Control Level">
                                    <field name="control_level"/>
                                </group>
                            </group>
                        </page>

                        <!-- ===== Page: Actions ===== -->
                        <page string="Actions &amp; Notes" name="actions">
                            <group>
                                <field name="notes" nolabel="1" placeholder="QC Notes"/>
                            </group>
                            <group string="Corrective Actions">
                                <field name="corrective_action" nolabel="1" placeholder="Corrective Action Required"/>
                            </group>
                            <group string="Preventive Actions" invisible="state != 'approved'">
                                <field name="preventive_action" nolabel="1" placeholder="Preventive Action"/>
                            </group>
                            <group string="Review Notes" invisible="state not in ['approved','rejected','corrective']">
                                <field name="review_notes" nolabel="1" placeholder="Review Notes"/>
                            </group>
                        </page>

                        <!-- ===== Page: Related ===== -->
                        <page string="Related" name="related">
                            <group>
                                <group string="Test Order">
                                    <field name="test_order_id" readonly="1"/>
                                    <field name="test_line_id" readonly="1"/>
                                </group>
                                <group string="Patient">
                                    <field name="patient_id" readonly="1"/>
                                    <field name="sample_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- ===== Page: Chatter ===== -->
                        <page string="Chatter" name="chatter">
                            <field name="message_follower_ids"/>
                            <field name="activity_ids"/>
                            <field name="message_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== SEARCH VIEW ===================== -->
    <record id="view_lims_quality_control_search" model="ir.ui.view">
        <field name="name">lims.quality_control.search</field>
        <field name="model">lims.quality_control</field>
        <field name="arch" type="xml">
            <search string="Search QC Records">
                <field name="name" string="QC Reference"/>
                <field name="test_type_id" string="Test Type"/>
                <field name="technician_id" string="Technician"/>
                <field name="instrument_id" string="Instrument"/>
                <filter name="state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="state_review" string="Under Review" domain="[('state', '=', 'review')]"/>
                <filter name="state_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="state_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="state_corrective" string="Corrective Action" domain="[('state', '=', 'corrective')]"/>
                <separator/>
                <filter name="passed" string="Passed" domain="[('is_passed', '=', True)]"/>
                <filter name="failed" string="Failed" domain="[('is_passed', '=', False)]"/>
                <separator/>
                <filter name="qc_type_daily" string="Daily Control" domain="[('qc_type', '=', 'daily')]"/>
                <filter name="qc_type_instrument" string="Instrument Calibration" domain="[('qc_type', '=', 'instrument_calibration')]"/>
                <filter name="qc_type_reagent" string="Reagent Validation" domain="[('qc_type', '=', 'reagent_validation')]"/>
                <filter name="qc_type_external" string="External Proficiency" domain="[('qc_type', '=', 'external_proficiency')]"/>
                <filter name="today" string="Today" domain="[('date', '>=', context_today)]"/>
                <filter name="this_week" string="This Week" domain="[('date', '>=', context_today - 7)]"/>
                <filter name="this_month" string="This Month" domain="[('date', '>=', context_today - 30)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_qc_type" string="QC Type" context="{'group_by': 'qc_type'}"/>
                    <filter name="group_test_type" string="Test Type" context="{'group_by': 'test_type_id'}"/>
                    <filter name="group_technician" string="Technician" context="{'group_by': 'technician_id'}"/>
                    <filter name="group_result" string="Result" context="{'group_by': 'is_passed'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== ACTION ===================== -->
    <record id="action_lims_quality_control" model="ir.actions.act_window">
        <field name="name">Quality Control</field>
        <field name="res_model">lims.quality_control</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_lims_quality_control_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Perform quality control
            </p>
            <p>
                Monitor and validate test accuracy through quality control.
            </p>
        </field>
    </record>
</odoo>