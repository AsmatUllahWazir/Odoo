<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== TREE VIEW ===================== -->
    <record id="view_lims_test_order_tree" model="ir.ui.view">
        <field name="name">lims.test_order.tree</field>
        <field name="model">lims.test_order</field>
        <field name="arch" type="xml">
            <tree string="Test Orders" decoration-danger="is_overdue==True" decoration-warning="state in ['draft','confirmed','sample_collection']" decoration-success="state in ['reported','invoiced','completed']">
                <field name="order_id"/>
                <field name="patient_id"/>
                <field name="date_ordered"/>
                <field name="state" widget="badge"/>
                <field name="priority" widget="badge"/>
                <field name="amount_total" sum="Total"/>
                <field name="completion_percentage" widget="progressbar"/>
                <field name="has_abnormal_results" widget="boolean_favorite"/>
                <field name="is_overdue" widget="boolean_favorite"/>
                <field name="doctor_id"/>
            </tree>
        </field>
    </record>

    <!-- ===================== KANBAN VIEW ===================== -->
    <record id="view_lims_test_order_kanban" model="ir.ui.view">
        <field name="name">lims.test_order.kanban</field>
        <field name="model">lims.test_order</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="order_id"/>
                <field name="patient_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="amount_total"/>
                <field name="completion_percentage"/>
                <field name="has_abnormal_results"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <span class="fa fa-flask" style="font-size: 48px;"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="order_id"/>
                                </strong>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <field name="patient_id"/>
                                    </div>
                                    <div>
                                        <field name="state" widget="badge"/>
                                        <field name="priority" widget="badge"/>
                                    </div>
                                    <div>
                                        <field name="amount_total"/>
                                    </div>
                                    <div>
                                        <field name="completion_percentage" widget="progressbar"/>
                                    </div>
                                    <div>
                                        <field name="has_abnormal_results" widget="boolean_favorite"/>
                                        <field name="is_overdue" widget="boolean_favorite"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_lims_test_order_form" model="ir.ui.view">
        <field name="name">lims.test_order.form</field>
        <field name="model">lims.test_order</field>
        <field name="arch" type="xml">
            <form string="Test Order">
                <header>
                    <button name="action_submit_for_approval" type="object"
                            string="Submit for Approval"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve"
                            class="oe_highlight"
                            invisible="state != 'pending_approval'"/>
                    <button name="action_confirm" type="object"
                            string="Confirm"
                            class="oe_highlight"
                            invisible="state not in ['approved','draft']"/>
                    <button name="action_start_sample_collection" type="object"
                            string="Start Collection"
                            class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <button name="action_complete_collection" type="object"
                            string="Complete Collection"
                            class="oe_highlight"
                            invisible="state != 'sample_collection'"/>
                    <button name="action_start_processing" type="object"
                            string="Start Processing"
                            class="oe_highlight"
                            invisible="state not in ['confirmed','sample_collection']"/>
                    <button name="action_submit_qc" type="object"
                            string="Submit QC"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_approve_qc" type="object"
                            string="Approve QC"
                            class="oe_highlight"
                            invisible="state != 'quality_check'"/>
                    <button name="action_results_ready" type="object"
                            string="Results Ready"
                            class="oe_highlight"
                            invisible="state not in ['in_progress','quality_check']"/>
                    <button name="action_submit_review" type="object"
                            string="Submit Review"
                            class="oe_highlight"
                            invisible="state != 'results_ready'"/>
                    <button name="action_approve_review" type="object"
                            string="Approve &amp; Generate Report"
                            class="oe_highlight"
                            invisible="state != 'review_pending'"/>
                    <button name="action_generate_report" type="object"
                            string="Generate Report"
                            class="oe_highlight"
                            invisible="state not in ['results_ready','review_pending']"/>
                    <button name="action_invoice" type="object"
                            string="Create Invoice"
                            class="oe_highlight"
                            invisible="state not in ['reported','results_ready']"/>
                    <button name="action_complete" type="object"
                            string="Complete"
                            class="oe_highlight"
                            invisible="state != 'invoiced'"/>
                    <button name="action_hold" type="object"
                            string="Hold"
                            class="oe_highlight"
                            invisible="state in ['draft','cancelled','completed','invoiced']"/>
                    <button name="action_resume" type="object"
                            string="Resume"
                            class="oe_highlight"
                            invisible="state != 'on_hold'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            class="oe_highlight"
                            invisible="state in ['invoiced','completed','cancelled']"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft"
                            class="oe_highlight"
                            invisible="state not in ['cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_approval,approved,confirmed,sample_collection,in_progress,quality_check,results_ready,review_pending,reported,invoiced,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="order_id" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="patient_id"/>
                        </h3>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_samples" type="object"
                                class="oe_stat_button"
                                icon="fa-tint">
                            <div class="o_stat_info">
                                <field name="sample_count" widget="statinfo"/>
                                <span class="o_stat_text">Samples</span>
                            </div>
                        </button>
                        <button name="action_view_reports" type="object"
                                class="oe_stat_button"
                                icon="fa-file-pdf-o">
                            <div class="o_stat_info">
                                <field name="report_count" widget="statinfo"/>
                                <span class="o_stat_text">Reports</span>
                            </div>
                        </button>
                        <button name="action_view_invoice" type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not invoice_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                        <button name="action_view_qc" type="object"
                                class="oe_stat_button"
                                icon="fa-check-circle-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">QC</span>
                            </div>
                        </button>
                    </div>
                    <notebook>
                        <!-- ===== Page: Order Details ===== -->
                        <page string="Order Details" name="details">
                            <group>
                                <group string="Order Information">
                                    <field name="patient_id"/>
                                    <field name="doctor_id"/>
                                    <field name="date_ordered"/>
                                    <field name="priority"/>
                                    <field name="order_type"/>
                                    <field name="department"/>
                                    <field name="referral_reference"/>
                                </group>
                                <group string="Progress">
                                    <field name="total_tests" readonly="1"/>
                                    <field name="completed_tests" readonly="1"/>
                                    <field name="completion_percentage" widget="progressbar" readonly="1"/>
                                    <field name="has_abnormal_results" widget="boolean_favorite" readonly="1"/>
                                    <field name="sample_collection_status" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <group string="Turnaround Time">
                                    <field name="actual_turnaround_hours" readonly="1"/>
                                    <field name="expected_turnaround_hours" readonly="1"/>
                                    <field name="is_overdue" widget="boolean_favorite" readonly="1"/>
                                    <field name="overdue_days" readonly="1"/>
                                </group>
                                <group string="Timeline">
                                    <field name="confirmation_date" readonly="1"/>
                                    <field name="sample_collection_date" readonly="1"/>
                                    <field name="processing_start_date" readonly="1"/>
                                    <field name="results_ready_date" readonly="1"/>
                                    <field name="reported_date" readonly="1"/>
                                    <field name="completed_date" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- ===== Page: Test Lines ===== -->
                        <page string="Test Lines" name="lines">
                            <field name="order_line_ids" context="{'default_test_order_id': active_id}">
                                <tree string="Test Lines" editable="bottom">
                                    <field name="test_type_id"/>
                                    <field name="sample_id"/>
                                    <field name="price" sum="Total"/>
                                    <field name="discount"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                    <field name="result_value"/>
                                    <field name="result_text"/>
                                    <field name="is_abnormal" widget="boolean_favorite"/>
                                    <field name="technician_id"/>
                                </tree>
                                <form string="Test Line">
                                    <group>
                                        <group>
                                            <field name="test_type_id"/>
                                            <field name="sample_id"/>
                                            <field name="state" widget="badge"/>
                                        </group>
                                        <group>
                                            <field name="price"/>
                                            <field name="discount"/>
                                            <field name="subtotal" readonly="1"/>
                                        </group>
                                    </group>
                                    <group string="Results">
                                        <field name="result_value"/>
                                        <field name="result_text"/>
                                        <field name="result_unit" readonly="1"/>
                                        <field name="result_date" readonly="1"/>
                                        <field name="technician_id"/>
                                        <field name="is_abnormal" widget="boolean_favorite" readonly="1"/>
                                        <field name="validation_status"/>
                                        <field name="validation_message" readonly="1"/>
                                    </group>
                                    <group string="Interpretation">
                                        <field name="interpretation" nolabel="1" placeholder="Interpretation"/>
                                        <field name="notes" nolabel="1" placeholder="Notes"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <!-- ===== Page: Samples ===== -->
                        <page string="Samples" name="samples">
                            <field name="sample_ids">
                                <tree string="Samples">
                                    <field name="sample_id"/>
                                    <field name="sample_type" widget="badge"/>
                                    <field name="collection_date"/>
                                    <field name="status" widget="badge"/>
                                    <field name="quality_ok" widget="boolean_favorite"/>
                                    <field name="test_count"/>
                                </tree>
                            </field>
                        </page>

                        <!-- ===== Page: Financial ===== -->
                        <page string="Financial" name="financial">
                            <group>
                                <group string="Amounts">
                                    <field name="amount_subtotal" readonly="1"/>
                                    <field name="discount"/>
                                    <field name="discount_amount" readonly="1"/>
                                    <field name="amount_tax" readonly="1"/>
                                    <field name="amount_total" readonly="1" style="font-weight: bold;"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group string="Invoicing">
                                    <field name="invoice_id" readonly="1" context="{'form_view_ref': 'account.view_move_form'}"/>
                                    <field name="invoice_status"/>
                                    <field name="payment_status"/>
                                    <field name="invoice_date" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- ===== Page: Notes ===== -->
                        <page string="Notes" name="notes">
                            <field name="clinical_indications" nolabel="1" placeholder="Clinical Indications"/>
                            <field name="notes" nolabel="1" placeholder="Patient Notes"/>
                            <field name="internal_notes" nolabel="1" placeholder="Internal Notes"/>
                            <field name="qc_notes" nolabel="1" placeholder="QC Notes"/>
                        </page>

                        <!-- ===== Page: Chatter ===== -->
                        <page string="Chatter" name="chatter">
                            <field name="message_follower_ids"/>
                            <field name="activity_ids"/>
                            <field name="message_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== SEARCH VIEW ===================== -->
    <record id="view_lims_test_order_search" model="ir.ui.view">
        <field name="name">lims.test_order.search</field>
        <field name="model">lims.test_order</field>
        <field name="arch" type="xml">
            <search string="Search Test Orders">
                <field name="order_id" string="Order ID"/>
                <field name="patient_id" string="Patient"/>
                <field name="doctor_id" string="Doctor"/>
                <field name="referral_reference" string="Referral"/>
                <filter name="state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="state_pending_approval" string="Pending Approval" domain="[('state', '=', 'pending_approval')]"/>
                <filter name="state_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="state_processing" string="Processing" domain="[('state', 'in', ['sample_collection','in_progress','quality_check'])]"/>
                <filter name="state_results_ready" string="Results Ready" domain="[('state', 'in', ['results_ready','review_pending'])]"/>
                <filter name="state_reported" string="Reported" domain="[('state', '=', 'reported')]"/>
                <filter name="state_invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter name="state_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="state_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter name="state_on_hold" string="On Hold" domain="[('state', '=', 'on_hold')]"/>
                <separator/>
                <filter name="priority_stat" string="STAT" domain="[('priority', '=', 'stat')]"/>
                <filter name="priority_emergency" string="Emergency" domain="[('priority', '=', 'emergency')]"/>
                <filter name="priority_urgent" string="Urgent" domain="[('priority', '=', 'urgent')]"/>
                <separator/>
                <filter name="abnormal" string="Has Abnormal Results" domain="[('has_abnormal_results', '=', True)]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="today" string="Today" domain="[('date_ordered', '>=', context_today)]"/>
                <filter name="this_week" string="This Week" domain="[('date_ordered', '>=', context_today - 7)]"/>
                <filter name="this_month" string="This Month" domain="[('date_ordered', '>=', context_today - 30)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_patient" string="Patient" context="{'group_by': 'patient_id'}"/>
                    <filter name="group_doctor" string="Doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                    <filter name="group_order_type" string="Order Type" context="{'group_by': 'order_type'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== ACTION ===================== -->
    <record id="action_lims_test_order" model="ir.actions.act_window">
        <field name="name">Test Orders</field>
        <field name="res_model">lims.test_order</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_lims_test_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first test order
            </p>
            <p>
                Manage laboratory test orders from request to invoicing.
            </p>
        </field>
    </record>
</odoo>