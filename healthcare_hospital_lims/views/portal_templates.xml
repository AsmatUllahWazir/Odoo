<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== PORTAL LAYOUT ===================== -->
    <template id="portal_layout" name="LIMS Portal Layout">
        <t t-call="web.layout">
            <div class="container mt-4">
                <div class="row">
                    <div class="col-md-3">
                        <!-- Sidebar -->
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Patient Portal</h5>
                                <hr/>
                                <div class="list-group">
                                    <a t-attf-href="/lims/portal/patient/#{patient.id}?token=#{patient.access_token}"
                                       class="list-group-item list-group-item-action">
                                        Dashboard
                                    </a>
                                    <a t-attf-href="/lims/portal/settings?patient_id=#{patient.id}&amp;token=#{patient.access_token}"
                                       class="list-group-item list-group-item-action">
                                        Settings
                                    </a>
                                    <a href="/lims/portal/login"
                                       class="list-group-item list-group-item-action text-danger">
                                        Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <t t-raw="0"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================== PORTAL LOGIN ===================== -->
    <template id="portal_login" name="LIMS Portal Login">
        <t t-call="web.layout">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h4 class="mb-0">Patient Portal Login</h4>
                            </div>
                            <div class="card-body">
                                <form method="post" action="/lims/portal/login">
                                    <t t-if="error">
                                        <div class="alert alert-danger">
                                            <t t-esc="error"/>
                                        </div>
                                    </t>
                                    <div class="mb-3">
                                        <label class="form-label">Patient ID</label>
                                        <input type="text" name="patient_id" class="form-control"
                                               placeholder="Enter your Patient ID" required="required"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Access Token</label>
                                        <input type="password" name="access_token" class="form-control"
                                               placeholder="Enter your Access Token" required="required"/>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">Login</button>
                                </form>
                                <div class="mt-3 text-muted text-center">
                                    <small>Please contact the laboratory if you don't have your access token.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================== PORTAL ACCESS DENIED ===================== -->
    <template id="portal_access_denied" name="LIMS Portal Access Denied">
        <t t-call="web.layout">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header bg-danger text-white">
                                <h4 class="mb-0">Access Denied</h4>
                            </div>
                            <div class="card-body text-center">
                                <div style="font-size: 64px; margin: 20px 0;">🔒</div>
                                <h5>You do not have access to this page</h5>
                                <p class="text-muted">Please check your login credentials and try again.</p>
                                <a href="/lims/portal/login" class="btn btn-primary">Go to Login</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================== PORTAL DASHBOARD ===================== -->
    <template id="portal_dashboard" name="LIMS Portal Dashboard">
        <t t-call="hospital_lims.portal_layout">
            <div>
                <div class="mb-4">
                    <h2>Welcome, <t t-esc="patient.name"/>!</h2>
                    <p class="text-muted">Patient ID: <t t-esc="patient.patient_id"/></p>
                </div>

                <!-- Quick Stats -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card bg-info text-white">
                            <div class="card-body">
                                <h5 class="card-title">Total Orders</h5>
                                <h3><t t-esc="len(orders)"/></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <h5 class="card-title">Reports Available</h5>
                                <h3><t t-esc="len(reports)"/></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-warning text-white">
                            <div class="card-body">
                                <h5 class="card-title">Pending Orders</h5>
                                <h3><t t-esc="len(orders.filtered(lambda o: o.state not in ['reported','invoiced','completed']))"/></h3>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Orders -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Recent Orders</h5>
                    </div>
                    <div class="card-body">
                        <t t-if="orders">
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Order ID</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                            <th>Tests</th>
                                            <th>Amount</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="orders[:5]" t-as="order">
                                            <tr>
                                                <td><t t-esc="order.order_id"/></td>
                                                <td><t t-esc="order.date_ordered"/></td>
                                                <td>
                                                    <span class="badge" t-attf-class="#{order.state in ['draft','confirmed'] and 'badge-secondary' or order.state in ['sample_collection','in_progress','quality_check'] and 'badge-warning' or order.state in ['results_ready','review_pending'] and 'badge-info' or order.state in ['reported'] and 'badge-success' or order.state in ['invoiced','completed'] and 'badge-primary' or 'badge-danger'}">
                                                        <t t-esc="order.state.replace('_', ' ').title()"/>
                                                    </span>
                                                </td>
                                                <td><t t-esc="order.total_tests"/></td>
                                                <td><t t-esc="order.amount_total"/></td>
                                                <td>
                                                    <a t-attf-href="/lims/portal/order/#{order.id}?token=#{patient.access_token}"
                                                       class="btn btn-sm btn-outline-primary">View</a>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No orders found.</p>
                        </t>
                    </div>
                </div>

                <!-- Available Reports -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Available Reports</h5>
                    </div>
                    <div class="card-body">
                        <t t-if="reports">
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Report Number</th>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="reports" t-as="report">
                                            <tr>
                                                <td><t t-esc="report.name"/></td>
                                                <td><t t-esc="report.report_date"/></td>
                                                <td><t t-esc="report.report_type"/></td>
                                                <td>
                                                    <span class="badge" t-attf-class="#{report.state in ['generated','reviewed'] and 'badge-info' or report.state in ['sent'] and 'badge-success' or 'badge-secondary'}">
                                                        <t t-esc="report.state.title()"/>
                                                    </span>
                                                </td>
                                                <td>
                                                    <a t-attf-href="/lims/portal/report/#{report.id}?token=#{patient.access_token}"
                                                       class="btn btn-sm btn-outline-primary">View</a>
                                                    <a t-attf-href="/lims/portal/report/download/#{report.id}?token=#{patient.access_token}"
                                                       class="btn btn-sm btn-outline-success">Download</a>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No reports available.</p>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================== PORTAL REPORT VIEW ===================== -->
    <template id="portal_report_view" name="LIMS Portal Report View">
        <t t-call="hospital_lims.portal_layout">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Report: <t t-esc="report.name"/></h2>
                    <div>
                        <a t-attf-href="/lims/portal/report/download/#{report.id}?token=#{patient.access_token}"
                           class="btn btn-success">Download PDF</a>
                        <a t-attf-href="/lims/portal/patient/#{patient.id}?token=#{patient.access_token}"
                           class="btn btn-secondary">Back</a>
                    </div>
                </div>

                <!-- Report Content -->
                <div class="card">
                    <div class="card-body">
                        <div style="font-family: Arial, sans-serif; padding: 20px;">
                            <!-- Header -->
                            <div style="text-align: center; border-bottom: 3px solid #2c3e50; padding-bottom: 20px; margin-bottom: 30px;">
                                <h1 style="color: #2c3e50; font-size: 24px;">LABORATORY INFORMATION MANAGEMENT SYSTEM</h1>
                                <h2 style="color: #34495e; font-size: 18px;">PATHOLOGY REPORT</h2>
                                <p style="color: #7f8c8d; font-size: 12px;">Report: <t t-esc="report.name"/> | Date: <t t-esc="report.report_date"/></p>
                            </div>

                            <!-- Patient Information -->
                            <div style="margin-bottom: 25px; background: #f8f9fa; padding: 15px; border-radius: 5px;">
                                <h4 style="color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 5px;">PATIENT INFORMATION</h4>
                                <div class="row">
                                    <div class="col-md-6"><strong>Name:</strong> <t t-esc="report.patient_id.name"/></div>
                                    <div class="col-md-6"><strong>Patient ID:</strong> <t t-esc="report.patient_id.patient_id"/></div>
                                    <div class="col-md-6"><strong>DOB:</strong> <t t-esc="report.patient_id.date_of_birth"/></div>
                                    <div class="col-md-6"><strong>Age:</strong> <t t-esc="report.patient_id.age"/> years</div>
                                </div>
                            </div>

                            <!-- Order Information -->
                            <div style="margin-bottom: 25px; background: #f8f9fa; padding: 15px; border-radius: 5px;">
                                <h4 style="color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 5px;">ORDER INFORMATION</h4>
                                <div class="row">
                                    <div class="col-md-6"><strong>Order ID:</strong> <t t-esc="report.test_order_id.order_id"/></div>
                                    <div class="col-md-6"><strong>Date:</strong> <t t-esc="report.test_order_id.date_ordered"/></div>
                                    <div class="col-md-6"><strong>Doctor:</strong> <t t-esc="report.test_order_id.doctor_id.name"/></div>
                                    <div class="col-md-6"><strong>Priority:</strong> <t t-esc="report.test_order_id.priority"/></div>
                                </div>
                            </div>

                            <!-- Test Results -->
                            <div style="margin-bottom: 25px;">
                                <h4 style="color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 5px;">TEST RESULTS</h4>
                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Test Name</th>
                                                <th>Result</th>
                                                <th>Unit</th>
                                                <th>Normal Range</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="report.test_order_id.order_line_ids" t-as="line">
                                                <tr t-attf-class="#{line.is_abnormal and 'table-warning' or ''}">
                                                    <td><t t-esc="line.test_type_id.name"/></td>
                                                    <td><strong><t t-esc="line.result_value or line.result_text or 'N/A'"/></strong></td>
                                                    <td><t t-esc="line.result_unit or ''"/></td>
                                                    <td><t t-esc="line.normal_range or 'N/A'"/></td>
                                                    <td>
                                                        <t t-if="line.is_critical">
                                                            <span class="badge bg-danger">⚠️ CRITICAL</span>
                                                        </t>
                                                        <t t-elif="line.is_abnormal">
                                                            <span class="badge bg-warning text-dark">⚠️ Abnormal</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-success">✅ Normal</span>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Disclaimer -->
                            <div style="margin-top: 30px; padding: 15px; background-color: #f8f9fa; border-left: 4px solid #95a5a6; font-size: 11px; color: #7f8c8d;">
                                <p><strong>DISCLAIMER:</strong> <t t-esc="report.disclaimer or 'This report is generated automatically. Please consult your doctor for clinical interpretation.'"/></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================== PORTAL ORDER VIEW ===================== -->
    <template id="portal_order_view" name="LIMS Portal Order View">
        <t t-call="hospital_lims.portal_layout">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Order: <t t-esc="order.order_id"/></h2>
                    <a t-attf-href="/lims/portal/patient/#{patient.id}?token=#{patient.access_token}"
                       class="btn btn-secondary">Back</a>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Date Ordered:</strong> <t t-esc="order.date_ordered"/></p>
                                <p><strong>Status:</strong>
                                    <span class="badge" t-attf-class="#{order.state in ['draft','confirmed'] and 'badge-secondary' or order.state in ['sample_collection','in_progress','quality_check'] and 'badge-warning' or order.state in ['results_ready','review_pending'] and 'badge-info' or order.state in ['reported'] and 'badge-success' or order.state in ['invoiced','completed'] and 'badge-primary' or 'badge-danger'}">
                                        <t t-esc="order.state.replace('_', ' ').title()"/>
                                    </span>
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Doctor:</strong> <t t-esc="order.doctor_id.name"/></p>
                                <p><strong>Priority:</strong> <t t-esc="order.priority"/></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Test Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Test Name</th>
                                        <th>Status</th>
                                        <th>Result</th>
                                        <th>Normal Range</th>
                                        <th>Abnormal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="lines" t-as="line">
                                        <tr>
                                            <td><t t-esc="line.test_type_id.name"/></td>
                                            <td>
                                                <span class="badge" t-attf-class="#{line.state in ['draft','assigned'] and 'badge-secondary' or line.state in ['in_progress','pending_review'] and 'badge-warning' or line.state in ['completed'] and 'badge-info' or line.state in ['verified','reported'] and 'badge-success' or 'badge-danger'}">
                                                    <t t-esc="line.state.replace('_', ' ').title()"/>
                                                </span>
                                            </td>
                                            <td>
                                                <t t-esc="line.result_value or line.result_text or 'Pending'"/>
                                            </td>
                                            <td><t t-esc="line.normal_range or 'N/A'"/></td>
                                            <td>
                                                <t t-if="line.is_abnormal">
                                                    <span class="badge bg-warning text-dark">⚠️ Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span class="badge bg-success">No</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================== PORTAL SETTINGS ===================== -->
    <template id="portal_settings" name="LIMS Portal Settings">
        <t t-call="hospital_lims.portal_layout">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Settings</h2>
                    <a t-attf-href="/lims/portal/patient/#{patient.id}?token=#{patient.access_token}"
                       class="btn btn-secondary">Back</a>
                </div>

                <div class="card">
                    <div class="card-body">
                        <t t-if="success">
                            <div class="alert alert-success"><t t-esc="success"/></div>
                        </t>
                        <form method="post" t-attf-action="/lims/portal/settings?patient_id=#{patient.id}&amp;token=#{patient.access_token}">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Patient ID</label>
                                        <input type="text" class="form-control" t-att-value="patient.patient_id" disabled="disabled"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Name</label>
                                        <input type="text" class="form-control" t-att-value="patient.name" disabled="disabled"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Email</label>
                                        <input type="email" name="email" class="form-control" t-att-value="patient.email"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Phone</label>
                                        <input type="text" name="phone" class="form-control" t-att-value="patient.phone"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Mobile</label>
                                        <input type="text" name="mobile" class="form-control" t-att-value="patient.mobile"/>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Street</label>
                                        <input type="text" name="street" class="form-control" t-att-value="patient.street"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">City</label>
                                        <input type="text" name="city" class="form-control" t-att-value="patient.city"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">ZIP</label>
                                        <input type="text" name="zip" class="form-control" t-att-value="patient.zip"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Access Token</label>
                                        <input type="text" class="form-control" t-att-value="patient.access_token" disabled="disabled"/>
                                        <small class="text-muted">Keep your access token secure. You'll need it to login.</small>
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">Update Settings</button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================== PORTAL ERROR ===================== -->
    <template id="portal_error" name="LIMS Portal Error">
        <t t-call="web.layout">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header bg-danger text-white">
                                <h4 class="mb-0">Error</h4>
                            </div>
                            <div class="card-body text-center">
                                <div style="font-size: 64px; margin: 20px 0;">❌</div>
                                <h5>An error occurred</h5>
                                <p class="text-muted"><t t-esc="error"/></p>
                                <a href="/lims/portal/login" class="btn btn-primary">Go to Login</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>