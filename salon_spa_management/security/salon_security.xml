<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- User Groups -->
        <record id="salon_group_manager" model="res.groups">
            <field name="name">Salon Manager</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <record id="salon_group_staff" model="res.groups">
            <field name="name">Salon Staff</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="salon_appointment_company_rule" model="ir.rule">
            <field name="name">Appointment: Multi-Company</field>
            <field name="model_id" ref="model_salon_appointment"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="salon_order_company_rule" model="ir.rule">
            <field name="name">Order: Multi-Company</field>
            <field name="model_id" ref="model_salon_order"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="salon_chair_company_rule" model="ir.rule">
            <field name="name">Chair: Multi-Company</field>
            <field name="model_id" ref="model_salon_chair"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Staff can only see their own appointments -->
        <record id="salon_appointment_staff_rule" model="ir.rule">
            <field name="name">Appointment: Staff Only Own</field>
            <field name="model_id" ref="model_salon_appointment"/>
            <field name="domain_force">[
                '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.user_id', '=', False)
            ]</field>
            <field name="groups" eval="[(4, ref('salon_group_staff'))]"/>
        </record>

        <record id="salon_commission_rule_company_rule" model="ir.rule">
            <field name="name">Commission Rule: Multi-Company</field>
            <field name="model_id" ref="model_salon_commission_rule"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="salon_employee_commission_company_rule" model="ir.rule">
            <field name="name">Employee Commission: Multi-Company</field>
            <field name="model_id" ref="model_salon_employee_commission"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="salon_product_kit_company_rule" model="ir.rule">
            <field name="name">Product Kit: Multi-Company</field>
            <field name="model_id" ref="model_salon_product_kit"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Staff can only see their own commission -->
        <record id="salon_employee_commission_staff_rule" model="ir.rule">
            <field name="name">Employee Commission: Staff Only Own</field>
            <field name="model_id" ref="model_salon_employee_commission"/>
            <field name="domain_force">[
                '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.user_id', '=', False)
            ]</field>
            <field name="groups" eval="[(4, ref('salon_group_staff'))]"/>
        </record>

    </data>
</odoo>