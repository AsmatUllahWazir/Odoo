<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search View -->
    <record id="view_salon_appointment_search" model="ir.ui.view">
        <field name="name">salon.appointment.search</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointments">
                <field name="name" string="Appointment Number"/>
                <field name="customer_id" string="Customer"/>
                <field name="employee_id" string="Staff"/>
                <field name="service_ids" string="Service"/>
                <filter name="today" string="Today"
                        domain="[('appointment_date', '&gt;=', context_today()), ('appointment_date', '&lt;', context_today() + datetime.timedelta(days=1))]"/>
                <filter name="this_week" string="This Week"
                        domain="[('appointment_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('appointment_date', '&lt;', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="checked_in" string="Checked In" domain="[('state', '=', 'checked_in')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <group>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_employee" string="Staff" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'appointment_date'}"/>
                    <filter name="group_by_chair" string="Chair" context="{'group_by': 'chair_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_salon_appointment_tree" model="ir.ui.view">
        <field name="name">salon.appointment.tree</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <tree string="Appointments"
                  decoration-danger="state in ['cancelled','no_show']"
                  decoration-warning="state in ['confirmed','checked_in','in_progress']"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'draft'">
                <field name="name" string="Appointment #"/>
                <field name="customer_id"/>
                <field name="employee_id"/>
                <field name="service_ids" widget="many2many_tags"/>
                <field name="appointment_date"/>
                <field name="duration" widget="float_time" options="{'step': 5}"/>
                <field name="state" widget="badge"/>
                <field name="chair_id" groups="salon_spa_management.salon_group_staff"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_salon_appointment_form" model="ir.ui.view">
        <field name="name">salon.appointment.form</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm"
                            class="oe_highlight" invisible="state not in ['draft']"/>
                    <button name="action_check_in" type="object"
                            string="Check In"
                            class="oe_highlight" invisible="state not in ['confirmed']"/>
                    <button name="action_start_service" type="object"
                            string="Start Service"
                            class="oe_highlight" invisible="state not in ['checked_in']"/>
                    <button name="action_complete" type="object"
                            string="Complete"
                            class="oe_highlight" invisible="state not in ['in_progress']"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            class="oe_highlight" invisible="state not in ['draft', 'confirmed']"/>
                    <button name="action_no_show" type="object"
                            string="No Show"
                            class="oe_highlight" invisible="state not in ['confirmed', 'checked_in']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,checked_in,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Appointment Number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" context="{'default_customer_rank': 1}"/>
                            <field name="customer_phone" readonly="1"/>
                            <field name="customer_email" readonly="1"/>
                            <field name="is_member" readonly="1"/>
                            <field name="membership_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="employee_id" required="1"/>
                            <field name="appointment_date" required="1"
                                   widget="datetime"
                                   options="{'timezone': 'UTC'}"/>
                            <field name="end_datetime" readonly="1" widget="datetime"/>
                            <field name="duration" widget="float_time" options="{'step': 5}" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="service_ids" widget="many2many_tags" required="1"/>
                        <field name="chair_id" groups="salon_spa_management.salon_group_staff"/>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Customer notes"/>
                            <field name="internal_notes" placeholder="Internal notes (staff only)"/>
                        </page>
                        <page string="Order" invisible="not order_id">
                            <field name="order_id" readonly="1"/>
                        </page>
                        <page string="History">
                            <group>
                                <field name="is_online_booking"/>
                                <field name="confirmation_sent"/>
                                <field name="reminder_sent"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_salon_appointment_calendar" model="ir.ui.view">
        <field name="name">salon.appointment.calendar</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments"
                      date_start="appointment_date"
                      date_stop="end_datetime"
                      color="employee_id"
                      mode="week">
                <field name="name" string="Appointment"/>
                <field name="customer_id" string="Customer"/>
                <field name="employee_id" string="Staff"/>
                <field name="service_ids" string="Services"/>
                <field name="state" string="Status"/>
            </calendar>
        </field>
    </record>

    <record id="action_salon_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_salon_appointment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Book a new appointment for your salon.
            </p>
        </field>
    </record>

    <record id="action_salon_appointment_calendar" model="ir.actions.act_window">
        <field name="name">Calendar</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_salon_appointment_calendar"/>
    </record>

</odoo>