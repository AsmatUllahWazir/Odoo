<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kanban View -->
    <record id="view_salon_chair_kanban" model="ir.ui.view">
        <field name="name">salon.chair.kanban</field>
        <field name="model">salon.chair</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="code"/>
                <field name="state"/>
                <field name="daily_revenue"/>
                <field name="daily_orders"/>
                <field name="current_appointment_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('salon.chair', 'image_512', record.id.raw_value)" class="o_image_64_cover" alt="Chair"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <span class="badge" t-attf-class="badge-{{ record.state.raw_value == 'available' ? 'success' : record.state.raw_value == 'occupied' ? 'danger' : 'warning' }}">
                                        <field name="state"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><strong>Code:</strong> <field name="code"/></div>
                                    <div><strong>Today's Revenue:</strong> <field name="daily_revenue" widget="monetary"/></div>
                                    <div><strong>Today's Orders:</strong> <field name="daily_orders"/></div>
                                    <t t-if="record.current_appointment_id.raw_value">
                                        <div class="text-info">
                                            <i class="fa fa-user"/> Current: <field name="current_appointment_id"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_salon_chair_tree" model="ir.ui.view">
        <field name="name">salon.chair.tree</field>
        <field name="model">salon.chair</field>
        <field name="arch" type="xml">
            <tree string="Chairs" decoration-success="state=='available'" decoration-danger="state=='occupied'">
                <field name="name"/>
                <field name="code"/>
                <field name="location"/>
                <field name="state" widget="badge"/>
                <field name="current_appointment_id"/>
                <field name="daily_revenue" widget="monetary" sum="Total"/>
                <field name="daily_orders" sum="Total"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_salon_chair_form" model="ir.ui.view">
        <field name="name">salon.chair.form</field>
        <field name="model">salon.chair</field>
        <field name="arch" type="xml">
            <form string="Chair/Station">
                <header>
                    <button name="action_occupy" type="object"
                            string="Occupy"
                            class="oe_highlight" invisible="state not in ['available']"/>
                    <button name="action_available" type="object"
                            string="Set Available"
                            class="oe_highlight" invisible="state not in ['occupied', 'maintenance']"/>
                    <button name="action_maintenance" type="object"
                            string="Maintenance" invisible="state not in ['available']"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,occupied,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Chair/Station Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="Code"/>
                            <field name="location"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="current_appointment_id" readonly="1"/>
                            <field name="daily_revenue" widget="monetary"/>
                            <field name="daily_orders"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Staff">
                            <field name="employee_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Appointment History">
                            <!-- Placeholder for appointment history -->
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_salon_chair" model="ir.actions.act_window">
        <field name="name">Chairs &amp; Stations</field>
        <field name="res_model">salon.chair</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_salon_chair_dashboard" model="ir.actions.act_window">
        <field name="name">Chair Dashboard</field>
        <field name="res_model">salon.chair</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_salon_chair_kanban"/>
        <field name="context">{'default_state': 'available'}</field>
    </record>

</odoo>