<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Membership Plan Tree -->
    <record id="view_salon_membership_tree" model="ir.ui.view">
        <field name="name">salon.membership.tree</field>
        <field name="model">salon.membership</field>
        <field name="arch" type="xml">
            <list string="Membership Plans">
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
                <field name="tier_level"/>
                <field name="discount_percentage" widget="percentage"/>
                <field name="duration"/>
                <field name="price" widget="monetary"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <!-- Membership Plan Form -->
    <record id="view_salon_membership_form" model="ir.ui.view">
        <field name="name">salon.membership.form</field>
        <field name="model">salon.membership</field>
        <field name="arch" type="xml">
            <form string="Membership Plan">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Membership Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="type"/>
                            <field name="tier_level" help="Higher number = higher tier"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="discount_percentage" widget="percentage"/>
                            <field name="duration" help="Duration in days (0 for lifetime)"/>
                        </group>
                    </group>
                    <group string="Discounted Services">
                        <field name="service_category_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Benefits">
                        <field name="benefits" nolabel="1" placeholder="Describe the benefits of this membership plan"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Membership Card Search -->
    <record id="view_salon_membership_card_search" model="ir.ui.view">
        <field name="name">salon.membership.card.search</field>
        <field name="model">salon.membership.card</field>
        <field name="arch" type="xml">
            <search string="Search Membership Cards">
                <field name="name" string="Card Number"/>
                <field name="partner_id" string="Customer"/>
                <field name="membership_id" string="Plan"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="expiring_soon" string="Expiring Soon"
                        domain="[('expiry_date', '&lt;=', context_today() + datetime.timedelta(days=30)), ('state', '=', 'active')]"/>
            </search>
        </field>
    </record>

    <!-- Membership Card Tree -->
    <record id="view_salon_membership_card_tree" model="ir.ui.view">
        <field name="name">salon.membership.card.tree</field>
        <field name="model">salon.membership.card</field>
        <field name="arch" type="xml">
            <list string="Membership Cards"
                  decoration-danger="state in ['expired','cancelled']"
                  decoration-warning="state == 'suspended'"
                  decoration-success="state == 'active'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="membership_id"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"/>
                <field name="discount_percentage" widget="percentage"/>
                <field name="total_spent" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- Membership Card Form -->
    <record id="view_salon_membership_card_form" model="ir.ui.view">
        <field name="name">salon.membership.card.form</field>
        <field name="model">salon.membership.card</field>
        <field name="arch" type="xml">
            <form string="Membership Card">
                <header>
                    <button name="action_activate" type="object" class="oe_highlight"
                            string="Activate" invisible="state not in ['suspended', 'cancelled']"/>
                    <button name="action_suspend" type="object" class="oe_highlight"
                            string="Suspend" invisible="state not in ['active']"/>
                    <button name="action_cancel" type="object" class="oe_highlight"
                            string="Cancel" invisible="state not in ['suspended', 'active']"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,expired,suspended,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Card Number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" domain="[('customer_rank', '>', 0)]"/>
                            <field name="membership_id"/>
                            <field name="discount_percentage" widget="percentage" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="expiry_date" readonly="1"/>
                            <field name="remaining_balance" widget="monetary"/>
                            <field name="total_spent" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Barcode">
                            <group>
                                <field name="barcode"/>
                                <field name="barcode_image" widget="image"/>
                            </group>
                        </page>
<!--                        <page string="Order History">-->
<!--                            <field name="partner_id.order_ids">-->
<!--                                <list string="Orders" decoration-success="state=='done'">-->
<!--                                    <field name="name"/>-->
<!--                                    <field name="order_date"/>-->
<!--                                    <field name="total_amount" widget="monetary"/>-->
<!--                                    <field name="state"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                        </page>-->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Membership Plan Actions -->
    <record id="action_salon_membership" model="ir.actions.act_window">
        <field name="name">Membership Plans</field>
        <field name="res_model">salon.membership</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Membership Card Actions -->
    <record id="action_salon_membership_card" model="ir.actions.act_window">
        <field name="name">Membership Cards</field>
        <field name="res_model">salon.membership.card</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_salon_membership_card_search"/>
    </record>

</odoo>