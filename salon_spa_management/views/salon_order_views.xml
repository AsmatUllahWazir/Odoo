<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action -->
    <record id="action_salon_order" model="ir.actions.act_window">
        <field name="name">Salon Orders</field>
        <field name="res_model">salon.order</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage salon orders.
            </p>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_salon_order_tree" model="ir.ui.view">
        <field name="name">salon.order.tree</field>
        <field name="model">salon.order</field>
        <field name="arch" type="xml">
            <tree string="Orders"
                  decoration-danger="state in ['cancelled']"
                  decoration-warning="state in ['draft','confirmed']"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_date"/>
                <field name="total_amount" sum="Total"/>
                <field name="state" widget="badge"/>
                <field name="payment_status" widget="badge"/>
                <field name="employee_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_salon_order_form" model="ir.ui.view">
        <field name="name">salon.order.form</field>
        <field name="model">salon.order</field>
        <field name="arch" type="xml">
            <form string="Salon Order">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm"
                            class="oe_highlight" invisible="state not in ['draft']"/>
                    <button name="action_start" type="object"
                            string="Start Service"
                            class="oe_highlight" invisible="state not in ['confirmed']"/>
                    <button name="action_done" type="object"
                            string="Done"
                            class="oe_highlight" invisible="state not in ['in_progress']"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" invisible="state not in ['draft', 'confirmed']"/>
                    <button name="action_create_invoice" type="object"
                            string="Create Invoice" invisible="state not in ['draft'] or payment_status == 'paid'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Order Number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" domain="[('customer_rank', '>', 0)]"/>
                            <field name="appointment_id"/>
                            <field name="order_date"/>
                            <field name="is_member" readonly="1"/>
                            <field name="membership_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="payment_status" widget="badge"/>
                            <field name="total_amount" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids">
                                <tree string="Order Lines" editable="bottom">
                                    <field name="service_id"/>
                                    <field name="employee_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="discount" widget="percentage"/>
                                    <field name="discount_amount" widget="monetary" sum="Total Discount"/>
                                    <field name="price_subtotal" widget="monetary" sum="Total"/>
                                    <field name="commission_amount" widget="monetary" sum="Total Commission"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Payments">
                            <field name="payment_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>