<odoo>
  <record id="seq_government_transaction" model="ir.sequence"><field name="name">Saudi Government Transaction</field><field name="code">saudi.government.transaction</field><field name="prefix">GOV/%(year)s/</field><field name="padding">5</field></record>
  <record id="seq_compliance_case" model="ir.sequence"><field name="name">Saudi Compliance Case</field><field name="code">saudi.compliance.case</field><field name="prefix">CASE/%(year)s/</field><field name="padding">5</field></record>
  <record id="seq_eos" model="ir.sequence"><field name="name">Saudi EOS Request</field><field name="code">saudi.eos.request</field><field name="prefix">EOS/%(year)s/</field><field name="padding">5</field></record>
  <record id="seq_clearance" model="ir.sequence"><field name="name">Saudi Clearance</field><field name="code">saudi.clearance</field><field name="prefix">CLR/%(year)s/</field><field name="padding">5</field></record>
  <record id="type_iqama" model="saudi.compliance.document.type"><field name="name">Iqama</field><field name="code">IQAMA</field><field name="sequence">10</field><field name="required_for_non_saudi">1</field><field name="reminder_days">30</field></record>
  <record id="type_passport" model="saudi.compliance.document.type"><field name="name">Passport</field><field name="code">PASSPORT</field><field name="sequence">20</field><field name="required_for_non_saudi">1</field><field name="required_for_saudi">1</field><field name="reminder_days">60</field></record>
  <record id="type_work_permit" model="saudi.compliance.document.type"><field name="name">Work Permit</field><field name="code">WORK_PERMIT</field><field name="sequence">30</field><field name="required_for_non_saudi">1</field><field name="reminder_days">30</field></record>
  <record id="type_insurance" model="saudi.compliance.document.type"><field name="name">Medical Insurance</field><field name="code">INSURANCE</field><field name="sequence">40</field><field name="required_for_non_saudi">1</field><field name="reminder_days">30</field></record>
  <record id="type_visa" model="saudi.compliance.document.type"><field name="name">Visa</field><field name="code">VISA</field><field name="sequence">50</field><field name="required_for_non_saudi">1</field><field name="reminder_days">30</field></record>

  <record id="service_iqama_renewal" model="saudi.government.service"><field name="name">Iqama Renewal</field><field name="code">iqama_renewal</field><field name="provider">muqeem</field><field name="requires_iqama">1</field><field name="default_deadline_days">5</field></record>
  <record id="service_exit_reentry" model="saudi.government.service"><field name="name">Exit / Re-entry Visa</field><field name="code">exit_reentry_issue</field><field name="provider">muqeem</field><field name="requires_iqama">1</field><field name="default_deadline_days">2</field></record>
  <record id="service_final_exit" model="saudi.government.service"><field name="name">Final Exit</field><field name="code">final_exit</field><field name="provider">muqeem</field><field name="requires_iqama">1</field><field name="default_deadline_days">3</field></record>
  <record id="service_contract" model="saudi.government.service"><field name="name">Employment Contract Update</field><field name="code">contract_update</field><field name="provider">qiwa</field><field name="requires_iqama">1</field><field name="default_deadline_days">5</field></record>
  <record id="service_gosi" model="saudi.government.service"><field name="name">GOSI Employee Update</field><field name="code">gosi_update</field><field name="provider">gosi</field><field name="default_deadline_days">3</field></record>
</odoo>
