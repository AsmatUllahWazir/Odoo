<odoo>
<record id="action_report_muqeem_profile" model="ir.actions.report"><field name="name">Muqeem Workforce Passport</field><field name="model">muqeem.workforce.profile</field><field name="report_type">qweb-pdf</field><field name="report_name">saudi_muqeem_workforce_operations.report_muqeem_profile</field></record>
<record id="action_report_muqeem_service" model="ir.actions.report"><field name="name">Government Service Dossier</field><field name="model">muqeem.service.request</field><field name="report_type">qweb-pdf</field><field name="report_name">saudi_muqeem_workforce_operations.report_muqeem_service</field></record>
<record id="action_report_muqeem_travel" model="ir.actions.report"><field name="name">Travel Readiness Brief</field><field name="model">muqeem.travel.permit</field><field name="report_type">qweb-pdf</field><field name="report_name">saudi_muqeem_workforce_operations.report_muqeem_travel</field></record>
<template id="report_muqeem_profile"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h1>Muqeem Workforce Passport</h1><h2 t-out="o.name"/><table class="table table-bordered"><tr><th>Iqama</th><td t-out="o.iqama_number"/></tr><tr><th>Iqama Expiry</th><td t-out="o.iqama_expiry"/></tr><tr><th>Passport</th><td t-out="o.passport_number"/></tr><tr><th>Passport Expiry</th><td t-out="o.passport_expiry"/></tr><tr><th>Muqeem Status</th><td t-out="o.muqeem_status"/></tr><tr><th>Risk Score</th><td><span t-out="round(o.risk_score,1)"/>%</td></tr><tr><th>Travel Readiness</th><td><span t-out="round(o.travel_readiness,1)"/>%</td></tr><tr><th>Sponsor</th><td t-out="o.sponsor_name"/></tr></table><h3>Open Government Operations</h3><table class="table table-sm"><tbody><t t-foreach="o.service_request_ids" t-as="r"><tr><td t-out="r.name"/><td t-out="r.service_code"/><td t-out="r.state"/><td t-out="r.government_reference"/></tr></t></tbody></table></div></t></t></t></template>
<template id="report_muqeem_service"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h1>Government Service Dossier</h1><h2 t-out="o.name"/><p><strong>Employee:</strong> <span t-out="o.employee_id.name"/></p><p><strong>Operation:</strong> <span t-out="o.service_code"/></p><p><strong>Eligibility:</strong> <span t-out="round(o.eligibility_score,1)"/>%</p><p><strong>Document Gate:</strong> <span t-out="o.document_gate"/></p><p><strong>Payment Gate:</strong> <span t-out="o.payment_gate"/></p><h3>Checklist</h3><table class="table"><tbody><t t-foreach="o.checklist_ids" t-as="c"><tr><td t-out="c.name"/><td><span t-out="'Complete' if c.completed else 'Pending'"/></td></tr></t></tbody></table><h3>Transactions</h3><table class="table"><tbody><t t-foreach="o.transaction_ids" t-as="tx"><tr><td t-out="tx.name"/><td t-out="tx.state"/><td t-out="tx.external_reference"/></tr></t></tbody></table></div></t></t></t></template>
<template id="report_muqeem_travel"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h1>Travel Readiness Brief</h1><h2 t-out="o.profile_id.name"/><table class="table table-bordered"><tr><th>Permit</th><td t-out="o.permit_type"/></tr><tr><th>Travel Date</th><td t-out="o.travel_date"/></tr><tr><th>Expected Return</th><td t-out="o.expected_return"/></tr><tr><th>Return Before</th><td t-out="o.return_before"/></tr><tr><th>Days Remaining</th><td t-out="o.days_to_return"/></tr><tr><th>Risk</th><td t-out="o.travel_risk"/></tr><tr><th>Risk Reason</th><td t-out="o.travel_risk_reason"/></tr></table></div></t></t></t></template>
</odoo>