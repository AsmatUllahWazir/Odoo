<odoo>
  <template id="report_employee_compliance"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Saudi Employee Compliance Report</h2><table class="table table-sm"><tr><th>Employee</th><td><span t-field="o.name"/></td><th>Compliance Score</th><td><span t-field="o.compliance_score"/>%</td></tr><tr><th>Iqama</th><td><span t-esc="o.iqama_number or '-'"/></td><th>Iqama Expiry</th><td><span t-esc="o.iqama_expiry_date or '-'"/></td></tr><tr><th>Passport</th><td><span t-esc="o.passport_number or '-'"/></td><th>Passport Expiry</th><td><span t-esc="o.passport_expiry_date or '-'"/></td></tr><tr><th>Work Permit</th><td><span t-esc="o.work_permit_number or '-'"/></td><th>Work Permit Expiry</th><td><span t-esc="o.work_permit_expiry_date or '-'"/></td></tr></table><h3>Compliance Documents</h3><table class="table table-sm"><thead><tr><th>Document</th><th>Number</th><th>Expiry</th><th>Status</th></tr></thead><tbody><tr t-foreach="o.compliance_document_ids" t-as="d"><td><span t-field="d.name"/></td><td><span t-field="d.document_number"/></td><td><span t-field="d.expiry_date"/></td><td><span t-field="d.state"/></td></tr></tbody></table><h3>Government Transactions</h3><table class="table table-sm"><thead><tr><th>Reference</th><th>Service</th><th>Date</th><th>Status</th></tr></thead><tbody><tr t-foreach="o.government_transaction_ids" t-as="t"><td><span t-field="t.name"/></td><td><span t-field="t.service_type"/></td><td><span t-field="t.request_date"/></td><td><span t-field="t.state"/></td></tr></tbody></table></div></t></t></t></template>
  <template id="report_eos"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>End of Service Settlement</h2><table class="table table-bordered"><tr><th>Employee</th><td><span t-field="o.employee_id"/></td><th>Last Working Day</th><td><span t-field="o.last_working_day"/></td></tr><tr><th>Service</th><td><span t-esc="'%.2f' % o.service_years"/> years</td><th>Reason</th><td><span t-field="o.reason"/></td></tr></table><h3>Calculation</h3><table class="table"><tr><td>EOS Base Salary</td><td><span t-field="o.eos_base_salary"/></td></tr><tr><td>Gross EOS</td><td><span t-field="o.gross_eos"/></td></tr><tr><td>Leave Encashment</td><td><span t-field="o.leave_encashment"/></td></tr><tr><td>Deductions</td><td><span t-esc="o.unpaid_deductions + o.advances_deduction + o.other_deductions"/></td></tr><tr><th>Net Settlement</th><th><span t-field="o.net_settlement"/></th></tr></table></div></t></t></t></template>
</odoo>
