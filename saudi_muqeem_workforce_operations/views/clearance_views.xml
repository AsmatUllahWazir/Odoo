<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_clearance_tree" model="ir.ui.view">
    <field name="name">saudi.clearance.tree</field>
    <field name="model">saudi.clearance</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="employee_id"/>
        <field name="last_working_day"/>
        <field name="reason"/>
        <field name="completion_percentage" widget="progressbar"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>
  <record id="view_clearance_form" model="ir.ui.view">
    <field name="name">saudi.clearance.form</field>
    <field name="model">saudi.clearance</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_hr" type="object" string="HR" invisible="state != 'in_progress'"/>
          <button name="action_finance" type="object" string="Finance" invisible="state != 'hr'"/>
          <button name="action_it" type="object" string="IT" invisible="state != 'finance'"/>
          <button name="action_manager" type="object" string="Manager" invisible="state != 'it'"/>
          <button name="action_ready" type="object" string="Ready" class="btn-primary" invisible="state != 'manager'"/>
          <button name="action_done" type="object" string="Complete" class="btn-success" invisible="state != 'ready'"/>
          <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done','cancelled')"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,hr,finance,it,manager,ready,done"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name"/>
            </h1>
          </div>
          <group>
            <field name="employee_id"/>
            <field name="request_date"/>
            <field name="last_working_day"/>
            <field name="reason"/>
            <field name="completion_percentage" widget="progressbar"/>
          </group>
          <group string="Clearance Checklist">
            <field name="asset_returned"/>
            <field name="advances_settled"/>
            <field name="loans_settled"/>
            <field name="finance_cleared"/>
            <field name="it_cleared"/>
            <field name="manager_cleared"/>
            <field name="hr_cleared"/>
            <field name="government_actions_done"/>
            <field name="final_payroll_done"/>
          </group>
          <field name="notes"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_saudi_clearance" model="ir.actions.act_window">
    <field name="name">Employee Clearance</field>
    <field name="res_model">saudi.clearance</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
