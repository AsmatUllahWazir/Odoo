  <record id="view_document_type_tree" model="ir.ui.view">
    <field name="name">saudi.compliance.document.type.tree</field>
    <field name="model">saudi.compliance.document.type</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="required_for_saudi"/>
        <field name="required_for_non_saudi"/>
        <field name="reminder_days"/>
        <field name="active"/>
      </tree>
    </field>
  </record>
  <record id="view_document_type_form" model="ir.ui.view">
    <field name="name">saudi.compliance.document.type.form</field>
    <field name="model">saudi.compliance.document.type</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="sequence"/>
            <field name="active"/>
          </group>
          <group>
            <field name="required_for_saudi"/>
            <field name="required_for_non_saudi"/>
            <field name="expiry_required"/>
            <field name="reminder_days"/>
            <field name="color"/>
          </group>
          <field name="description"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_saudi_compliance_document" model="ir.actions.act_window">
    <field name="name">Compliance Documents</field>
    <field name="res_model">saudi.compliance.document</field>
    <field name="view_mode">tree,form</field>
<!--    <field name="search_view_id" ref="view_document_search"/>-->
  </record>
  <record id="action_saudi_document_type" model="ir.actions.act_window">
    <field name="name">Document Types</field>
    <field name="res_model">saudi.compliance.document.type</field>
    <field name="view_mode">tree,form</field>
  </record>
