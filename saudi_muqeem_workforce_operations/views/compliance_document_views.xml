<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_document_tree" model="ir.ui.view">
    <field name="name">saudi.compliance.document.tree</field>
    <field name="model">saudi.compliance.document</field>
    <field name="arch" type="xml">
      <tree decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'" decoration-success="state == 'valid'">
        <field name="employee_id"/>
        <field name="name"/>
        <field name="document_type_id"/>
        <field name="document_number"/>
        <field name="issue_date"/>
        <field name="expiry_date"/>
        <field name="days_to_expiry"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>
  <record id="view_document_form" model="ir.ui.view">
    <field name="name">saudi.compliance.document.form</field>
    <field name="model">saudi.compliance.document</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,valid,expiring,expired"/>
        </header>
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1>
              <field name="name"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="employee_id"/>
              <field name="document_type_id"/>
              <field name="document_number"/>
            </group>
            <group>
              <field name="issue_date"/>
              <field name="expiry_date"/>
              <field name="days_to_expiry"/>
              <field name="is_required"/>
            </group>
          </group>
          <group string="Attachment">
            <field name="attachment_id"/>
            <field name="attachment_count" readonly="1"/>
            <field name="notes"/>
          </group>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </div>
        </sheet>
      </form>
    </field>
  </record>
