<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_gosi_tree" model="ir.ui.view">
    <field name="name">saudi.gosi.profile.tree</field>
    <field name="model">saudi.gosi.profile</field>
    <field name="arch" type="xml">
      <tree>
        <field name="employee_id"/>
        <field name="gosi_number"/>
        <field name="eligibility"/>
        <field name="contribution_base"/>
        <field name="employee_contribution"/>
        <field name="employer_contribution"/>
        <field name="total_contribution"/>
      </tree>
    </field>
  </record>
  <record id="view_gosi_form" model="ir.ui.view">
    <field name="name">saudi.gosi.profile.form</field>
    <field name="model">saudi.gosi.profile</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="employee_id"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="gosi_number"/>
              <field name="eligibility"/>
              <field name="registration_date"/>
              <field name="deregistration_date"/>
              <field name="occupational_hazard"/>
            </group>
            <group>
              <field name="basic_salary"/>
              <field name="housing_allowance"/>
              <field name="other_allowances"/>
              <field name="contribution_base"/>
            </group>
          </group>
          <group string="Contribution Rates">
            <field name="employee_rate"/>
            <field name="employer_rate"/>
            <field name="hazard_rate"/>
          </group>
          <group string="Monthly Contributions">
            <field name="employee_contribution"/>
            <field name="employer_contribution"/>
            <field name="total_contribution"/>
          </group>
          <field name="notes"/>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="message_ids"/>
          </div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_saudi_gosi_profile" model="ir.actions.act_window">
    <field name="name">GOSI Profiles</field>
    <field name="res_model">saudi.gosi.profile</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
