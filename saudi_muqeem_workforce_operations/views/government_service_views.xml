<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_government_service_tree" model="ir.ui.view">
    <field name="name">saudi.government.service.tree</field>
    <field name="model">saudi.government.service</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="provider"/>
        <field name="default_deadline_days"/>
        <field name="active"/>
      </tree>
    </field>
  </record>
  <record id="view_government_service_form" model="ir.ui.view">
    <field name="name">saudi.government.service.form</field>
    <field name="model">saudi.government.service</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="provider"/>
            <field name="sequence"/>
            <field name="active"/>
            <field name="endpoint_key"/>
          </group>
          <group>
            <field name="requires_iqama"/>
            <field name="requires_passport"/>
            <field name="requires_national_id"/>
            <field name="requires_sponsor"/>
            <field name="requires_attachment"/>
            <field name="default_deadline_days"/>
          </group>
          <field name="description"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_government_service" model="ir.actions.act_window">
    <field name="name">Government Services</field>
    <field name="res_model">saudi.government.service</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
