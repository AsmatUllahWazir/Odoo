<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_hr_employee_form_saudi_compliance" model="ir.ui.view">
    <field name="name">hr.employee.form.saudi.compliance</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/notebook" position="inside">
        <page string="Saudi Compliance" name="saudi_compliance" groups="saudi_muqeem_workforce_operations.group_saudi_compliance_user">
          <div class="o_saudi_employee_header">
            <div class="row">
              <div class="col-3">
                <div class="o_saudi_metric">
                  <span>Score</span>
                  <field name="compliance_score" widget="progressbar"/>
                </div>
              </div>
              <div class="col-3">
                <div class="o_saudi_metric">
                  <span>Status</span>
                  <field name="compliance_status"/>
                </div>
              </div>
              <div class="col-3">
                <div class="o_saudi_metric">
                  <span>Open Issues</span>
                  <field name="compliance_issue_count"/>
                </div>
              </div>
              <div class="col-3">
                <div class="o_saudi_metric">
                  <span>Documents</span>
                  <field name="document_expiry_count"/>
                </div>
              </div>
            </div>
          </div>
          <group string="Identity &amp; Residency">
            <group>
              <field name="saudi_employee_type"/>
              <field name="national_id"/>
              <field name="iqama_number"/>
              <field name="iqama_issue_date"/>
              <field name="iqama_expiry_date"/>
            </group>
            <group>
              <field name="border_number"/>
              <field name="sponsor_name"/>
              <field name="sponsor_id_number"/>
              <field name="profession_ar"/>
              <field name="visa_number"/>
              <field name="visa_type"/>
              <field name="visa_expiry_date"/>
            </group>
          </group>
          <group string="Travel &amp; Employment Documents">
            <group>
              <field name="passport_number"/>
              <field name="passport_issue_date"/>
              <field name="passport_expiry_date"/>
            </group>
            <group>
              <field name="work_permit_number"/>
              <field name="work_permit_expiry_date"/>
              <field name="insurance_policy_number"/>
              <field name="insurance_expiry_date"/>
            </group>
          </group>
          <group string="Government Registrations">
            <group>
              <field name="gosi_status"/>
              <field name="gosi_number"/>
            </group>
            <group>
              <field name="qiwa_contract_status"/>
              <field name="qiwa_contract_reference"/>
            </group>
          </group>
          <notebook>
            <page string="Compliance Documents">
              <field name="compliance_document_ids">
                <tree editable="bottom">
                  <field name="name"/>
                  <field name="document_type_id"/>
                  <field name="document_number"/>
                  <field name="issue_date"/>
                  <field name="expiry_date"/>
                  <field name="days_to_expiry"/>
                  <field name="state"/>
                </tree>
              </field>
            </page>
            <page string="Government Transactions">
              <field name="government_transaction_ids">
                <tree>
                  <field name="name"/>
                  <field name="service_type"/>
                  <field name="provider"/>
                  <field name="request_date"/>
                  <field name="state"/>
                  <field name="external_reference"/>
                </tree>
              </field>
            </page>
          </notebook>
        </page>
      </xpath>
      <xpath expr="//sheet" position="inside">
        <div class="oe_button_box" name="button_box_saudi">
          <button name="action_open_compliance_documents" type="object" class="oe_stat_button" icon="fa-id-card">
            <field name="document_expiry_count" widget="statinfo" string="Documents"/>
          </button>
          <button name="action_open_government_transactions" type="object" class="oe_stat_button" icon="fa-exchange">
            <field name="government_transaction_count" widget="statinfo" string="Transactions"/>
          </button>
          <button name="action_create_compliance_case" type="object" class="oe_stat_button" icon="fa-warning" string="New Case"/>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
