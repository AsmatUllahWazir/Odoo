<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_bulk_reminder_wizard" model="ir.ui.view">
    <field name="name">saudi.bulk.reminder.wizard.form</field>
    <field name="model">saudi.bulk.reminder.wizard</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="document_ids" widget="many2many_tags"/>
            <field name="recipient_mode"/>
            <field name="user_id" invisible="recipient_mode != 'manual'"/>
            <field name="subject"/>
          </group>
          <field name="body" widget="html"/>
        </sheet>
        <footer>
          <button name="action_send" type="object" string="Send Reminders" class="btn-primary"/>
          <button special="cancel" string="Cancel"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_bulk_reminder_wizard" model="ir.actions.act_window">
    <field name="name">Send Compliance Reminders</field>
    <field name="res_model">saudi.bulk.reminder.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
