<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_print_job_tree" model="ir.ui.view">
        <field name="name">smart.print.job.tree</field>
        <field name="model">smart.print.job</field>
        <field name="arch" type="xml">
            <list string="Print Jobs">
                <field name="name"/>
                <field name="model"/>
                <field name="res_id"/>
                <field name="printer_id"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
                <field name="number_of_copies"/>
                <field name="created_at"/>
                <field name="completed_at"/>
            </list>
        </field>
    </record>

    <record id="view_smart_print_job_form" model="ir.ui.view">
        <field name="name">smart.print.job.form</field>
        <field name="model">smart.print.job</field>
        <field name="arch" type="xml">
            <form string="Print Job">
                <header>
                    <button name="action_retry" string="Retry" type="object" class="btn-primary" invisible="state not in ['error']"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-danger" invisible="state not in ['draft', 'queued', 'processing', 'sent']"/>
                    <button name="action_view_record" string="View Record" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,sent,done"
                           colors="{'error':'danger','cancelled':'secondary'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="model"/>
                            <field name="res_id"/>
                            <field name="report_id"/>
                            <field name="attachment_id"/>
                            <field name="document_format"/>
                            <field name="number_of_copies"/>
                        </group>
                        <group string="Printer">
                            <field name="printer_id"/>
                            <field name="server_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Status &amp; Tracking">
                        <group>
                            <field name="external_job_id"/>
                            <field name="state"/>
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                            <field name="priority"/>
                            <field name="document_size"/>
                        </group>
                        <group>
                            <field name="created_at"/>
                            <field name="queued_at"/>
                            <field name="sent_at"/>
                            <field name="completed_at"/>
                        </group>
                    </group>
                    <group string="Error Information" groups="base.group_system">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_smart_print_job_search" model="ir.ui.view">
        <field name="name">smart.print.job.search</field>
        <field name="model">smart.print.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model"/>
                <field name="user_id"/>
                <field name="printer_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="queued" string="Queued" domain="[('state','in',['queued','processing'])]"/>
                <filter name="sent" string="Sent" domain="[('state','=','sent')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="error" string="Error" domain="[('state','=','error')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <group>
                    <filter name="group_by_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_by_printer" string="Printer" context="{'group_by':'printer_id'}"/>
                    <filter name="group_by_user" string="User" context="{'group_by':'user_id'}"/>
                    <filter name="group_by_model" string="Model" context="{'group_by':'model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_smart_print_job" model="ir.actions.act_window">
        <field name="name">Print Jobs</field>
        <field name="res_model">smart.print.job</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Monitor and manage print jobs
            </p>
            <p>
                All print requests are tracked here with their current status.
                Failed jobs can be retried and completed jobs can be archived.
            </p>
        </field>
    </record>

    <menuitem id="menu_smart_print_job" name="Print Jobs" parent="menu_smart_print_operations" action="action_smart_print_job" sequence="10"/>
</odoo>