<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_print_scenario_tree" model="ir.ui.view">
        <field name="name">smart.print.scenario.tree</field>
        <field name="model">smart.print.scenario</field>
        <field name="arch" type="xml">
            <list string="Print Scenarios" default_order="priority desc, name">
                <field name="name"/>
                <field name="action_id"/>
                <field name="report_id"/>
                <field name="printer_rule_id"/>
                <field name="number_of_copies"/>
                <field name="priority"/>
                <field name="active" widget="boolean"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_smart_print_scenario_form" model="ir.ui.view">
        <field name="name">smart.print.scenario.form</field>
        <field name="model">smart.print.scenario</field>
        <field name="arch" type="xml">
            <form string="Print Scenario">
                <header>
                    <button name="action_preview" string="Preview" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Scenario Name..."/>
                        </h1>
                        <field name="active" invisible="1"/>
                    </div>
                    <group>
                        <group string="Trigger">
                            <field name="action_id" required="1"/>
                            <field name="report_id" required="1"/>
                            <field name="condition_filter" placeholder="[('state','in',['confirmed','done'])]"
                                   help="Domain filter to determine when to apply this scenario"/>
                        </group>
                        <group string="Printing">
                            <field name="printer_rule_id" help="Rule to select printer. If not set, default resolution is used."/>
                            <field name="number_of_copies"/>
                            <field name="document_format"/>
                            <field name="priority"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_smart_print_scenario_search" model="ir.ui.view">
        <field name="name">smart.print.scenario.search</field>
        <field name="model">smart.print.scenario</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="action_id"/>
                <field name="report_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="with_condition" string="With Condition" domain="[('condition_filter','!=',False)]"/>
                <group>
                    <filter name="group_by_action" string="Action" context="{'group_by':'action_id'}"/>
                    <filter name="group_by_report" string="Report" context="{'group_by':'report_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_smart_print_scenario" model="ir.actions.act_window">
        <field name="name">Print Scenarios</field>
        <field name="res_model">smart.print.scenario</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define automatic printing scenarios
            </p>
            <p>
                Scenarios define what should be printed automatically when
                certain actions occur in the system.
            </p>
        </field>
    </record>

    <menuitem id="menu_smart_print_scenario" name="Print Scenarios" parent="menu_smart_print_config" action="action_smart_print_scenario" sequence="40"/>
</odoo>