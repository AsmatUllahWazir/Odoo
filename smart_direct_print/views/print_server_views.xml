<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_print_server_tree" model="ir.ui.view">
        <field name="name">smart.print.server.tree</field>
        <field name="model">smart.print.server</field>
        <field name="arch" type="xml">
            <list string="Print Servers">
                <field name="name"/>
                <field name="server_url"/>
                <field name="state" widget="badge"/>
                <field name="last_connection_check"/>
                <field name="active" widget="boolean"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_smart_print_server_form" model="ir.ui.view">
        <field name="name">smart.print.server.form</field>
        <field name="model">smart.print.server</field>
        <field name="arch" type="xml">
            <form string="Print Server">
                <header>
                    <button name="test_connection" string="Test Connection" type="object" class="btn-primary"/>
                    <button name="sync_printers" string="Sync Printers" type="object" class="btn-secondary"/>
                    <button name="action_view_printers" string="View Printers" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Server Name..."/>
                        </h1>
                        <div>
                            <field name="active" invisible="1"/>
                            <field name="state" widget="badge" colors="{'online':'success','offline':'danger','connecting':'warning','error':'danger','draft':'secondary'}"/>
                        </div>
                    </div>
                    <group>
                        <group string="Connection Details">
                            <field name="server_url" placeholder="https://print-server.local:5000"/>
                            <field name="api_key" password="True"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Status">
                            <field name="last_connection_check"/>
                            <field name="error_message" nolabel="1" invisible="1"/>
                        </group>
                    </group>
                    <group string="Error Information" groups="base.group_system">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_smart_print_server_search" model="ir.ui.view">
        <field name="name">smart.print.server.search</field>
        <field name="model">smart.print.server</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="server_url"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="online" string="Online" domain="[('state','=','online')]"/>
                <filter name="offline" string="Offline" domain="[('state','in',['offline','error'])]"/>
                <group>
                    <filter name="group_by_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_smart_print_server" model="ir.actions.act_window">
        <field name="name">Print Servers</field>
        <field name="res_model">smart.print.server</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure print servers for direct printing
            </p>
            <p>
                Print servers connect Odoo to physical printers through a
                lightweight print bridge service.
            </p>
        </field>
    </record>

    <menuitem id="menu_smart_print_server" name="Print Servers" parent="menu_smart_print_config" action="action_smart_print_server" sequence="10"/>
</odoo>