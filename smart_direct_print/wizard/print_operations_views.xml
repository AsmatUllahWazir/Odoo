<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!-- Print Operations Wizard                      -->
    <!-- ============================================ -->
    <record id="view_smart_print_operations_form" model="ir.ui.view">
        <field name="name">smart.print.operations.form</field>
        <field name="model">smart.print.operations</field>
        <field name="arch" type="xml">
            <form string="Print Operations">
                <header>
                    <button name="action_print" string="Print" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_retry_failed" string="Retry Failed" type="object" class="btn-secondary" invisible="state != 'done'"/>
                    <button name="action_view_jobs" string="View Jobs" type="object" class="btn-secondary" invisible="state != 'done'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state not in ['draft', 'error']"/>
                    <field name="state" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Manual Print Operations</h1>
                        <p class="text-muted">Select documents and print them directly to configured printers</p>
                    </div>

                    <group>
                        <group string="Document Selection">
                            <field name="model_id" required="1"
                                   options="{'no_create': True}"
                                   help="Select the model of the records to print"/>
                            <field name="record_ids" required="1"
                                   placeholder="e.g., 1, 2, 3, 4, 5"
                                   help="Comma-separated list of record IDs to print"/>
                            <field name="report_id" required="1"
                                   options="{'no_create': True}"
                                   help="Select the report to use for printing"/>
                        </group>
                        <group string="Print Options">
                            <field name="printer_id" required="1"
                                   options="{'no_create': True}"
                                   help="Select the printer to use"/>
                            <field name="number_of_copies"
                                   help="Number of copies to print"/>
                            <field name="output_format"
                                   help="Output format for the document"/>
                            <field name="print_immediately"
                                   help="Send the job to the printer immediately"/>
                            <field name="show_preview"
                                   help="Show a preview before printing"/>
                        </group>
                    </group>

                    <group string="Error" groups="base.group_system" invisible="not error_message">
                        <field name="error_message" nolabel="1"
                               widget="text"
                               readonly="1"/>
                    </group>

                    <group string="Created Print Jobs" invisible="not job_ids">
                        <field name="job_ids" nolabel="1"
                               context="{'form_view_ref': 'smart_direct_print.view_smart_print_job_form'}">
                            <list>
                                <field name="name"/>
                                <field name="model"/>
                                <field name="res_id"/>
                                <field name="state" widget="badge" colors="{
                                    'draft':'secondary',
                                    'queued':'warning',
                                    'processing':'info',
                                    'sent':'primary',
                                    'done':'success',
                                    'error':'danger',
                                    'cancelled':'secondary'
                                }"/>
                                <field name="created_at"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_smart_print_operations" model="ir.actions.act_window">
        <field name="name">Manual Print</field>
        <field name="res_model">smart.print.operations</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manually print documents
            </p>
            <p>
                Select the model, record IDs, and report to print.
                Choose a printer and number of copies.
            </p>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- Quick Print Wizard                           -->
    <!-- ============================================ -->
    <record id="view_smart_print_wizard_form" model="ir.ui.view">
        <field name="name">smart.print.wizard.form</field>
        <field name="model">smart.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Print">
                <header>
                    <button name="action_print" string="Print" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_view_job" string="View Job" type="object" class="btn-secondary" invisible="state != 'printed'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                    <field name="state" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Quick Print</h1>
                        <p class="text-muted">Quickly print the current document</p>
                    </div>

                    <group>
                        <group string="Document">
                            <field name="model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                            <field name="report_id" required="1"
                                   options="{'no_create': True}"
                                   help="Select the report to use for printing"/>
                        </group>
                        <group string="Print Settings">
                            <field name="printer_id" required="1"
                                   options="{'no_create': True}"
                                   help="Select the printer to use"/>
                            <field name="copies"
                                   help="Number of copies to print"/>
                            <field name="format"
                                   help="Output format for the document"/>
                        </group>
                    </group>

                    <group string="Error" groups="base.group_system" invisible="not error_message">
                        <field name="error_message" nolabel="1"
                               widget="text"
                               readonly="1"/>
                    </group>

                    <group string="Print Job" invisible="not job_id">
                        <field name="job_id" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_smart_print_wizard" model="ir.actions.act_window">
        <field name="name">Quick Print</field>
        <field name="res_model">smart.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_model': active_model,
            'default_res_id': active_id,
        }</field>
    </record>

    <!-- ============================================ -->
    <!-- Batch Print Wizard                           -->
    <!-- ============================================ -->
    <record id="view_smart_print_batch_wizard_form" model="ir.ui.view">
        <field name="name">smart.print.batch.wizard.form</field>
        <field name="model">smart.print.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Print">
                <header>
                    <button name="action_add_lines" string="Add Lines" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_print_batch" string="Print Batch" type="object" class="btn-primary" invisible="state != 'draft'"
                            confirm="Are you sure you want to print all jobs in this batch?"/>
                    <button name="action_view_jobs" string="View Jobs" type="object" class="btn-secondary" invisible="state not in ['done', 'error']"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                    <field name="state" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Batch Print</h1>
                        <p class="text-muted">Print multiple documents in a batch operation</p>
                    </div>

                    <group>
                        <group string="Batch Information">
                            <field name="name"/>
                            <field name="description" placeholder="Description of this batch print operation"/>
                        </group>
                        <group string="Default Settings">
                            <field name="default_printer_id"
                                   options="{'no_create': True}"
                                   help="Default printer for all jobs in this batch"/>
                            <field name="default_copies"
                                   help="Default number of copies"/>
                            <field name="default_format"
                                   help="Default output format"/>
                        </group>
                    </group>

                    <group string="Statistics" invisible="not total_jobs">
                        <group>
                            <field name="total_jobs" readonly="1"
                                   class="text-center"/>
                            <label for="total_jobs" string="Total Jobs" class="text-muted text-center"/>
                        </group>
                        <group>
                            <field name="successful_jobs" readonly="1"
                                   class="text-center text-success"/>
                            <label for="successful_jobs" string="Successful" class="text-muted text-center"/>
                        </group>
                        <group>
                            <field name="failed_jobs" readonly="1"
                                   class="text-center text-danger"/>
                            <label for="failed_jobs" string="Failed" class="text-muted text-center"/>
                        </group>
                    </group>

                    <group string="Print Lines">
                        <field name="job_line_ids" nolabel="1">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="record_name"/>
                                <field name="report_id"/>
                                <field name="printer_id"/>
                                <field name="copies"/>
                                <field name="format"/>
                                <field name="state" widget="badge" colors="{
                                    'draft':'secondary',
                                    'processing':'warning',
                                    'done':'success',
                                    'error':'danger'
                                }"/>
                                <field name="error_message"
                                       attrs="{'invisible': [('state', '!=', 'error')]}"/>
                            </list>
                            <form>
                                <group>
                                    <group>
                                        <field name="model" invisible="1"/>
                                        <field name="res_id" invisible="1"/>
                                        <field name="record_name" readonly="1"/>
                                        <field name="report_id" required="1"/>
                                    </group>
                                    <group>
                                        <field name="printer_id" required="1"/>
                                        <field name="copies"/>
                                        <field name="format"/>
                                    </group>
                                </group>
                                <group string="Error" invisible="not error_message">
                                    <field name="error_message" nolabel="1"
                                           widget="text"
                                           readonly="1"/>
                                </group>
                                <group string="Print Job" invisible="not job_id">
                                    <field name="job_id" nolabel="1"/>
                                </group>
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_smart_print_batch_wizard" model="ir.actions.act_window">
        <field name="name">Batch Print</field>
        <field name="res_model">smart.print.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Batch print multiple documents
            </p>
            <p>
                Add multiple print jobs to a batch and print them all at once.
                Each job can have its own settings or use the default settings.
            </p>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- Add Lines Wizard for Batch Print             -->
    <!-- ============================================ -->
    <record id="view_smart_print_batch_wizard_line_form" model="ir.ui.view">
        <field name="name">smart.print.batch.wizard.line.form</field>
        <field name="model">smart.print.batch.wizard.line</field>
        <field name="arch" type="xml">
            <form string="Add Print Line">
                <sheet>
                    <div class="oe_title">
                        <h1>Add Print Line</h1>
                    </div>

                    <group>
                        <group string="Document">
                            <field name="model" required="1"
                                   placeholder="e.g., sale.order"
                                   help="Technical name of the model"/>
                            <field name="res_id" required="1"
                                   placeholder="Record ID"
                                   help="ID of the record to print"/>
                            <field name="record_name" readonly="1"
                                   help="Name of the record"/>
                            <field name="report_id" required="1"
                                   help="Report to use for printing"/>
                        </group>
                        <group string="Print Settings">
                            <field name="printer_id" required="1"
                                   help="Printer to use"/>
                            <field name="copies"
                                   help="Number of copies to print"/>
                            <field name="format"
                                   help="Output format"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_print" string="Print Now" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

