<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Document Tags -->
        <record id="tag_urgent" model="document.tag">
            <field name="name">Urgent</field>
            <field name="color">1</field>
        </record>

        <record id="tag_confidential" model="document.tag">
            <field name="name">Confidential</field>
            <field name="color">2</field>
        </record>

        <record id="tag_approved" model="document.tag">
            <field name="name">Approved</field>
            <field name="color">10</field>
        </record>

        <record id="tag_pending" model="document.tag">
            <field name="name">Pending Review</field>
            <field name="color">3</field>
        </record>

        <record id="tag_archived" model="document.tag">
            <field name="name">Archived</field>
            <field name="color">9</field>
        </record>

        <record id="tag_signed" model="document.tag">
            <field name="name">Signed</field>
            <field name="color">10</field>
        </record>

        <record id="tag_draft" model="document.tag">
            <field name="name">Draft</field>
            <field name="color">11</field>
        </record>

        <record id="tag_final" model="document.tag">
            <field name="name">Final Version</field>
            <field name="color">7</field>
        </record>

        <record id="tag_external" model="document.tag">
            <field name="name">External</field>
            <field name="color">4</field>
        </record>

        <record id="tag_internal" model="document.tag">
            <field name="name">Internal</field>
            <field name="color">5</field>
        </record>
    </data>
</odoo>
