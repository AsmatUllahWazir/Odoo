<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Auto-categorize uncategorized documents -->
        <record id="ir_cron_auto_categorize" model="ir.cron">
            <field name="name">Smart Document: Auto-Categorize</field>
            <field name="model_id" ref="model_smart_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_categorize()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Check for expired documents -->
        <record id="ir_cron_check_expired" model="ir.cron">
            <field name="name">Smart Document: Check Expired Documents</field>
            <field name="model_id" ref="model_smart_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expired_documents()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
