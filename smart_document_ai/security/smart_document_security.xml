<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- User Groups -->
    <record id="group_smart_document_user" model="res.groups">
        <field name="name">Smart Document / User</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_smart_document_manager" model="res.groups">
        <field name="name">Smart Document / Manager</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="implied_ids" eval="[(4, ref('group_smart_document_user'))]"/>
    </record>

    <record id="group_smart_document_admin" model="res.groups">
        <field name="name">Smart Document / Administrator</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="implied_ids" eval="[(4, ref('group_smart_document_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_smart_document_user" model="ir.rule">
        <field name="name">Smart Document: User Access</field>
        <field name="model_id" ref="model_smart_document"/>
        <field name="domain_force">[
            '|', '|', '|',
            ('owner_id', '=', user.id),
            ('access_level', 'in', ['public', 'internal']),
            ('allowed_user_ids', 'in', [user.id]),
            ('create_uid', '=', user.id),
        ]</field>
        <field name="groups" eval="[(4, ref('group_smart_document_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_smart_document_manager" model="ir.rule">
        <field name="name">Smart Document: Manager Access</field>
        <field name="model_id" ref="model_smart_document"/>
        <field name="domain_force">[
            '|', '|', '|',
            ('owner_id', '=', user.id),
            ('access_level', 'in', ['public', 'internal', 'department']),
            ('allowed_user_ids', 'in', [user.id]),
            ('create_uid', '=', user.id),
        ]</field>
        <field name="groups" eval="[(4, ref('group_smart_document_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_smart_document_admin" model="ir.rule">
        <field name="name">Smart Document: Admin Access</field>
        <field name="model_id" ref="model_smart_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_smart_document_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Folder Rules -->
    <record id="rule_document_folder_user" model="ir.rule">
        <field name="name">Document Folder: User Access</field>
        <field name="model_id" ref="model_document_folder"/>
        <field name="domain_force">[
            '|', '|', '|',
            ('owner_id', '=', user.id),
            ('access_level', 'in', ['public', 'internal']),
            ('allowed_user_ids', 'in', [user.id]),
            ('create_uid', '=', user.id),
        ]</field>
        <field name="groups" eval="[(4, ref('group_smart_document_user'))]"/>
    </record>

    <record id="rule_document_folder_manager" model="ir.rule">
        <field name="name">Document Folder: Manager Access</field>
        <field name="model_id" ref="model_document_folder"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_smart_document_manager'))]"/>
    </record>
</odoo>
