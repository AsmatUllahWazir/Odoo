<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Menu -->
    <menuitem id="menu_smart_document_root"
              name="Smart Documents"
              web_icon="smart_document_ai,static/description/icon.png"
              sequence="10"/>

    <!-- Documents -->
    <menuitem id="menu_smart_document_main"
              name="Documents"
              parent="menu_smart_document_root"
              sequence="10"/>

    <menuitem id="menu_smart_document_all"
              name="All Documents"
              parent="menu_smart_document_main"
              action="action_smart_document"
              sequence="10"/>

    <menuitem id="menu_my_documents"
              name="My Documents"
              parent="menu_smart_document_main"
              action="action_my_documents"
              sequence="20"/>

    <menuitem id="menu_favorite_documents"
              name="Favorites"
              parent="menu_smart_document_main"
              action="action_favorite_documents"
              sequence="30"/>

    <menuitem id="menu_duplicate_documents"
              name="Duplicates"
              parent="menu_smart_document_main"
              action="action_duplicate_documents"
              sequence="40"/>

    <menuitem id="menu_expiring_documents"
              name="Expiring Soon"
              parent="menu_smart_document_main"
              action="action_expiring_documents"
              sequence="50"/>

    <!-- Organization -->
    <menuitem id="menu_smart_document_org"
              name="Organization"
              parent="menu_smart_document_root"
              sequence="20"/>

    <menuitem id="menu_document_folders"
              name="Folders"
              parent="menu_smart_document_org"
              action="action_document_folder"
              sequence="10"/>

    <menuitem id="menu_document_categories"
              name="Categories"
              parent="menu_smart_document_org"
              action="action_document_category"
              sequence="20"/>

    <menuitem id="menu_document_tags"
              name="Tags"
              parent="menu_smart_document_org"
              action="action_document_tag"
              sequence="30"/>

    <!-- Analytics -->
    <menuitem id="menu_smart_document_analytics"
              name="Analytics"
              parent="menu_smart_document_root"
              sequence="30"/>

    <menuitem id="menu_document_analytics"
              name="Usage Analytics"
              parent="menu_smart_document_analytics"
              action="action_document_analytics"
              sequence="10"/>

    <menuitem id="menu_storage_analytics"
              name="Storage Analytics"
              parent="menu_smart_document_analytics"
              action="action_document_storage_analytics"
              sequence="20"/>

    <!-- Configuration -->
    <menuitem id="menu_smart_document_config"
              name="Configuration"
              parent="menu_smart_document_root"
              sequence="100"/>

    <menuitem id="menu_smart_document_settings"
              name="Settings"
              parent="menu_smart_document_config"
              action="base_setup.action_general_configuration"
              sequence="10"/>
</odoo>
