<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_merge_wizard_form" model="ir.ui.view">
        <field name="name">document.merge.wizard.form</field>
        <field name="model">document.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge Duplicate Documents">
                <group>
                    <field name="primary_document_id" options="{'no_create': True}"/>
                    <field name="duplicate_ids" widget="many2many_tags" options="{'no_create': True}" readonly="1"/>
                </group>
                <group>
                    <field name="keep_primary_only"/>
                    <field name="merge_tags"/>
                </group>
                <footer>
                    <button name="action_merge" string="Merge" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
