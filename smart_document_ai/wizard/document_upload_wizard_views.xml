<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_upload_wizard_form" model="ir.ui.view">
        <field name="name">document.upload.wizard.form</field>
        <field name="model">document.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Document">
                <group>
                    <field name="file" filename="file_name" widget="binary"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <group>
                    <group>
                        <field name="folder_id" options="{'no_create': True}"/>
                        <field name="category_id" options="{'no_create': True}"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                    </group>
                    <group>
                        <field name="access_level" widget="radio"/>
                        <field name="expiration_date"/>
                    </group>
                </group>
                <field name="description" placeholder="Optional description..."/>
                <footer>
                    <button name="action_upload" string="Upload" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_document_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Document</field>
        <field name="res_model">document.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
