<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Analysis Form -->
    <record id="view_inventory_aging_analysis_form" model="ir.ui.view">
        <field name="name">inventory.aging.analysis.form</field>
        <field name="model">inventory.aging.analysis</field>
        <field name="arch" type="xml">
            <form string="Inventory Aging Analysis">
                <header>
                    <button name="action_run_analysis" string="Run Analysis" type="object"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="smart_inventory_analytics.group_smart_inventory_manager"/>
                    <button name="action_set_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"
                            groups="smart_inventory_analytics.group_smart_inventory_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state == 'cancelled'"
                            groups="smart_inventory_analytics.group_smart_inventory_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_run_analysis"
                                icon="fa-refresh" invisible="state != 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Run</span>
                                <span class="o_stat_text">Analysis</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="analysis_date"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="total_products"/>
                            <field name="total_dead_stock"/>
                            <field name="high_priority_reorder"/>
                            <field name="total_value"/>
                            <field name="dead_stock_value"/>
                        </group>
                    </group>
                    <group string="Aging Bucket Distribution" invisible="state == 'draft'">
                        <group>
                            <field name="bucket_0_30"/>
                            <field name="bucket_31_60"/>
                            <field name="bucket_61_90"/>
                        </group>
                        <group>
                            <field name="bucket_90_plus"/>
                            <field name="bucket_no_move"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Aging Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree decoration-danger="is_dead_stock"
                                      decoration-warning="reorder_priority in ('high', 'critical')"
                                      default_order="dead_stock_score desc"
                                      limit="80">
                                    <field name="default_code" optional="show"/>
                                    <field name="product_id"/>
                                    <field name="qty_available"/>
                                    <field name="stock_value" sum="Total Value"/>
                                    <field name="days_since_last_move"/>
                                    <field name="aging_bucket" widget="badge"/>
                                    <field name="is_dead_stock"/>
                                    <field name="dead_stock_score"/>
                                    <field name="turnover_rate_30d"/>
                                    <field name="suggested_reorder_qty"/>
                                    <field name="reorder_priority" widget="badge"/>
                                    <field name="reorder_reason" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Notes about this analysis run..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Analysis Tree -->
    <record id="view_inventory_aging_analysis_tree" model="ir.ui.view">
        <field name="name">inventory.aging.analysis.tree</field>
        <field name="model">inventory.aging.analysis</field>
        <field name="arch" type="xml">
            <tree string="Aging Analyses" decoration-info="state == 'draft'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="analysis_date"/>
                <field name="total_products"/>
                <field name="total_dead_stock"/>
                <field name="high_priority_reorder"/>
                <field name="total_value"/>
                <field name="dead_stock_value"/>
                <field name="state" widget="badge"
                          decoration-info="state == 'draft'"
                          decoration-success="state == 'done'"
                          decoration-muted="state == 'cancelled'"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_inventory_aging_analysis_search" model="ir.ui.view">
        <field name="name">inventory.aging.analysis.search</field>
        <field name="model">inventory.aging.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Date" name="group_date" context="{'group_by': 'analysis_date'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_inventory_aging_analysis" model="ir.actions.act_window">
        <field name="name">Aging Analyses</field>
        <field name="res_model">inventory.aging.analysis</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_done': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first inventory aging analysis.
            </p>
            <p>
                Click "Run Analysis" to snapshot current aging buckets, dead stock and reorder recommendations.
            </p>
        </field>
    </record>
</odoo>
