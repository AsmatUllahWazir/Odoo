        <!-- Demo Property 1 -->
        <record id="demo_property_1" model="property.property">
            <field name="name">Luxury Downtown Condo</field>
            <field name="property_code">PROP-001</field>
            <field name="type">condo</field>
            <field name="category">sale</field>
            <field name="status">listed</field>
            <field name="street">123 Main Street</field>
            <field name="city">New York</field>
            <field name="state_id" ref="base.state_us_6"/>
            <field name="country_id" ref="base.us"/>
            <field name="zip">10001</field>
            <field name="latitude">40.7128</field>
            <field name="longitude">-74.0060</field>
            <field name="bedrooms">3</field>
            <field name="bathrooms">2.5</field>
            <field name="area_total">1850</field>
            <field name="area_living">1650</field>
            <field name="year_built">2018</field>
            <field name="energy_rating">a</field>
            <field name="base_price">1250000</field>
            <field name="rental_price">4500</field>
            <field name="rental_deposit">4500</field>
            <field name="owner_id" ref="demo_property_owner"/>
            <field name="manager_id" ref="base.user_demo"/>
            <field name="website_published">True</field>
            <field name="description"><![CDATA[
                <p>Stunning luxury condo in the heart of downtown with panoramic city views.</p>
                <ul>
                    <li>Open concept living area</li>
                    <li>Gourmet kitchen with stainless steel appliances</li>
                    <li>Floor-to-ceiling windows</li>
                    <li>Private balcony</li>
                    <li>24/7 concierge service</li>
                    <li>Fitness center and rooftop pool</li>
                </ul>
            ]]></field>
            <field name="features"><![CDATA[
                <ul>
                    <li><i class="fa fa-check"/> Hardwood floors</li>
                    <li><i class="fa fa-check"/> Granite countertops</li>
                    <li><i class="fa fa-check"/> Stainless steel appliances</li>
                    <li><i class="fa fa-check"/> Smart home system</li>
                    <li><i class="fa fa-check"/> Central AC and heating</li>
                    <li><i class="fa fa-check"/> In-unit laundry</li>
                </ul>
            ]]></field>
        </record>

