        <!-- Demo Owner -->
        <record id="demo_property_owner" model="res.partner">
            <field name="name">Demo Property Owner</field>
            <field name="is_company">True</field>
            <field name="email">owner@example.com</field>
            <field name="phone">+1 555-0001</field>
        </record>

