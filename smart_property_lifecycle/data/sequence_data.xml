<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Property Sequence -->
        <record id="seq_property_property" model="ir.sequence">
            <field name="name">Property Code</field>
            <field name="code">property.property</field>
            <field name="prefix">PROP-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
            <field name="use_date_range">True</field>
        </record>

        <!-- Lease Sequence -->
        <record id="seq_property_lease" model="ir.sequence">
            <field name="name">Lease Reference</field>
            <field name="code">property.lease</field>
            <field name="prefix">LEASE-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
            <field name="use_date_range">True</field>
        </record>

    </data>
</odoo>