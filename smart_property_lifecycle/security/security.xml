<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Property Management Groups -->
        <record id="group_property_manager" model="res.groups">
            <field name="name">Property Manager</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>
        </record>

        <record id="group_property_agent" model="res.groups">
            <field name="name">Property Agent</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_property_owner" model="res.groups">
            <field name="name">Property Owner</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_property_tenant_portal" model="res.groups">
            <field name="name">Tenant (Portal)</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_property_analyst" model="res.groups">
            <field name="name">Property Analyst</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Multi-Company Group -->
        <record id="group_property_multi_company" model="res.groups">
            <field name="name">Multi-Company Access</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_multi_company'))]"/>
        </record>

        <!-- Admin Group -->
        <record id="group_property_admin" model="res.groups">
            <field name="name">Property Administrator</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_property_manager')), (4, ref('group_property_analyst')), (4, ref('group_property_multi_company'))]"/>
            <field name="users" eval="[(4, ref('base.user_root'))]"/>
        </record>

    </data>
</odoo>