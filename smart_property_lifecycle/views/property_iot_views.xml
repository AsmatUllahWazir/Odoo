<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================== -->
    <!-- IoT Device Search View -->
    <!-- ===================================================================== -->

    <record id="view_property_iot_device_search" model="ir.ui.view">
        <field name="name">property.iot.device.search</field>
        <field name="model">property.iot.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="device_name" string="Device Name"/>
                <field name="device_id" string="Device ID"/>
                <field name="property_id" string="Property"/>
                <field name="device_type"/>
                <field name="status"/>
                <field name="manufacturer"/>

                <filter name="online" string="Online" domain="[('status', '=', 'online')]"/>
                <filter name="offline" string="Offline" domain="[('status', '=', 'offline')]"/>
                <filter name="has_alert" string="Has Alert" domain="[('has_alert', '=', True)]"/>
                <filter name="low_battery" string="Low Battery" domain="[('battery_level', '&lt;=', 20)]"/>
                <filter name="iot_enabled" string="IoT Enabled Properties" domain="[('property_id.iot_enabled', '=', True)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_type" string="Device Type" context="{'group_by': 'device_type'}"/>
                    <filter name="group_by_property" string="Property" context="{'group_by': 'property_id'}"/>
                    <filter name="group_by_manufacturer" string="Manufacturer" context="{'group_by': 'manufacturer'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================================================================== -->
    <!-- IoT Device Tree View -->
    <!-- ===================================================================== -->

    <record id="view_property_iot_device_tree" model="ir.ui.view">
        <field name="name">property.iot.device.tree</field>
        <field name="model">property.iot.device</field>
        <field name="arch" type="xml">
            <tree string="IoT Devices" decoration-success="status=='online'" decoration-danger="status=='offline' or status=='error'" decoration-warning="status=='maintenance'" decoration-muted="status=='inactive'">
                <field name="device_name" string="Device"/>
                <field name="device_type" string="Type" widget="badge"/>
                <field name="device_id" string="Device ID"/>
                <field name="property_id" string="Property"/>
                <field name="unit_id" string="Unit"/>
                <field name="status" string="Status" widget="badge"/>
                <field name="battery_level" string="Battery" widget="progressbar"/>
                <field name="last_seen" string="Last Seen"/>
                <field name="has_alert" string="Alert" widget="boolean_toggle"/>
                <field name="location_description" string="Location"/>
            </tree>
        </field>
    </record>

