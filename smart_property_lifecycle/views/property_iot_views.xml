    <!-- ===================================================================== -->
    <!-- IoT Device Form View -->
    <!-- ===================================================================== -->

    <record id="view_property_iot_device_form" model="ir.ui.view">
        <field name="name">property.iot.device.form</field>
        <field name="model">property.iot.device</field>
        <field name="arch" type="xml">
            <form string="IoT Device">
                <header>
<!--                    <button name="action_refresh" string="Refresh Device" type="object" class="btn-primary"/>-->
                    <button name="action_clear_alert" string="Clear Alert" type="object" class="btn-warning" invisible="not has_alert"/>
<!--                    <button name="action_send_command" string="Send Command" type="object" class="btn-info"/>-->
                    <field name="status" widget="statusbar" statusbar_visible="online,offline,maintenance"/>
                </header>

                <sheet>
<!--                    <div class="oe_button_box" name="button_box">-->
<!--                        <button type="object" class="oe_stat_button" icon="fa-bell" invisible="not has_alert">-->
<!--                            <div class="o_stat_info">-->
<!--                                <span class="o_stat_value text-danger">Alert</span>-->
<!--                            </div>-->
<!--                        </button>-->
<!--                        <button type="object" class="oe_stat_button" icon="fa-battery-3">-->
<!--                            <div class="o_stat_info">-->
<!--                                <span class="o_stat_value" t-att-class="{-->
<!--                                    'text-success': battery_level &gt;= 70,-->
<!--                                    'text-warning': battery_level &gt;= 30 and battery_level &lt; 70,-->
<!--                                    'text-danger': battery_level &lt; 30-->
<!--                                }"><field name="battery_level"/>%</span>-->
<!--                            </div>-->
<!--                        </button>-->
<!--                        <button type="object" class="oe_stat_button" icon="fa-clock-o">-->
<!--                            <div class="o_stat_info">-->
<!--                                <span class="o_stat_value small"><field name="last_seen"/></span>-->
<!--                            </div>-->
<!--                        </button>-->
<!--                    </div>-->

                    <div class="oe_title">
                        <h1>
                            <field name="device_name" placeholder="Device Name"/>
                            <span class="badge" t-att-class="{
                                'badge-success': status == 'online',
                                'badge-danger': status in ['offline', 'error'],
                                'badge-warning': status == 'maintenance',
                                'badge-secondary': status == 'inactive'
                            }"><field name="status"/></span>
                            <span class="badge badge-danger" invisible="not has_alert"><i class="fa fa-exclamation-triangle"/> Alert</span>
                        </h1>
                        <h4>
                            <field name="device_type"/>
                            <span class="text-muted">|</span>
                            <field name="device_id"/>
                            <span class="text-muted">|</span>
                            <field name="property_id"/>
                        </h4>
                    </div>

                    <notebook>
                        <page string="General Information">
                            <group>
                                <group string="Device Details">
                                    <field name="device_name"/>
                                    <field name="device_type" widget="selection"/>
                                    <field name="device_id"/>
                                    <field name="status" widget="selection"/>
                                </group>
                                <group string="Location">
                                    <field name="property_id" options="{'no_create': True}"/>
                                    <field name="unit_id" options="{'no_create': True}"/>
                                    <field name="location_description"/>
                                    <field name="floor"/>
                                    <field name="room"/>
                                </group>
                            </group>
                        </page>

                        <page string="Technical Details">
                            <group>
                                <group string="Manufacturer Info">
                                    <field name="manufacturer"/>
                                    <field name="model"/>
                                    <field name="firmware_version"/>
                                </group>
                                <group string="Installation">
                                    <field name="installation_date"/>
                                    <field name="last_maintenance_date"/>
                                </group>
                            </group>
                            <group string="Status">
                                <group>
                                    <field name="battery_level" widget="progressbar"/>
                                    <field name="last_seen"/>
                                </group>
                                <group>
                                    <field name="has_alert" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>

                        <page string="Data">
                            <field name="last_data" widget="json"/>
                        </page>

                        <page string="Alerts">
                            <field name="alert_ids">
                                <tree>
                                    <field name="alert_type" widget="badge"/>
                                    <field name="description"/>
                                    <field name="status" widget="badge"/>
                                    <field name="create_date"/>
                                    <field name="resolved_date"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="alert_type" widget="selection"/>
                                            <field name="status" widget="selection"/>
                                            <field name="description"/>
                                        </group>
                                        <group>
                                            <field name="create_date" readonly="1"/>
                                            <field name="acknowledged_date" readonly="1"/>
                                            <field name="resolved_date" readonly="1"/>
                                            <field name="resolved_by"/>
                                        </group>
                                    </group>
                                    <group string="Notes">
                                        <field name="notes"/>
                                    </group>
                                    <footer>
                                        <button name="action_acknowledge" string="Acknowledge" type="object" class="btn-primary" invisible="status != 'active'"/>
                                        <button name="action_resolve" string="Resolve" type="object" class="btn-success" invisible="status != 'acknowledged'"/>
                                    </footer>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ===================================================================== -->
    <!-- IoT Device Action Window -->
    <!-- ===================================================================== -->

    <record id="action_property_iot_device" model="ir.actions.act_window">
        <field name="name">IoT Devices</field>
        <field name="res_model">property.iot.device</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first IoT device
            </p>
            <p>
                Manage smart devices, sensors, and IoT alerts for your properties.
            </p>
        </field>
    </record>

</odoo>