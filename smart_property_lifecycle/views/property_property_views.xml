<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================== -->
    <!-- Property Search View -->
    <!-- ===================================================================== -->

    <record id="view_property_property_search" model="ir.ui.view">
        <field name="name">property.property.search</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Property Name" filter_domain="['|', '|', ('name', 'ilike', self), ('property_code', 'ilike', self), ('full_address', 'ilike', self)]"/>
                <field name="property_code" string="Code"/>
                <field name="type"/>
                <field name="status"/>
                <field name="city"/>
                <field name="state_id"/>
                <field name="bedrooms"/>
                <field name="bathrooms"/>
                <field name="energy_rating"/>
                <field name="owner_id"/>
                <field name="manager_id"/>

                <filter name="published" string="Published" domain="[('website_published', '=', True)]"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="listed" string="Listed" domain="[('status', '=', 'listed')]"/>
                <filter name="leased" string="Leased" domain="[('status', '=', 'leased')]"/>
                <filter name="sold" string="Sold" domain="[('status', '=', 'sold')]"/>
                <filter name="has_iot" string="IoT Enabled" domain="[('iot_enabled', '=', True)]"/>

                <separator/>
                <filter name="price_high" string="High Price" domain="[('base_price', '&gt;', 1000000)]"/>
                <filter name="price_low" string="Low Price" domain="[('base_price', '&lt;', 100000)]"/>
                <filter name="large_property" string="Large Property" domain="[('area_total', '&gt;', 3000)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_type" string="Type" context="{'group_by': 'type'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_manager" string="Manager" context="{'group_by': 'manager_id'}"/>
                    <filter name="group_by_city" string="City" context="{'group_by': 'city'}"/>
                    <filter name="group_by_energy" string="Energy Rating" context="{'group_by': 'energy_rating'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================================================================== -->
    <!-- Property Tree View -->
    <!-- ===================================================================== -->

    <record id="view_property_property_tree" model="ir.ui.view">
        <field name="name">property.property.tree</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <tree string="Properties" decoration-success="status=='listed'" decoration-danger="status=='maintenance'" decoration-info="status=='leased' or status=='sold'" decoration-warning="status=='under_offer'">
                <field name="property_code" string="Code"/>
                <field name="name" string="Name"/>
                <field name="type" string="Type"/>
                <field name="status" string="Status" widget="badge"/>
                <field name="city" string="City"/>
                <field name="bedrooms" string="Beds" sum="Total Beds"/>
                <field name="bathrooms" string="Baths" sum="Total Baths"/>
                <field name="area_total" string="Area (sqft)" sum="Total Area"/>
                <field name="base_price" string="Base Price" sum="Total Value"/>
                <field name="dynamic_price" string="Dynamic Price" sum="Total Dynamic"/>
                <field name="occupancy_rate" string="Occupancy %" widget="progressbar"/>
                <field name="owner_id" string="Owner"/>
                <field name="manager_id" string="Manager"/>
                <field name="website_published" string="Published" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

