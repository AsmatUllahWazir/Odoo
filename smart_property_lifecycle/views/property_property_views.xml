    <!-- ===================================================================== -->
    <!-- Property Form View -->
    <!-- ===================================================================== -->

    <record id="view_property_property_form" model="ir.ui.view">
        <field name="name">property.property.form</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_publish_website" string="Publish on Website" type="object" class="btn-primary" invisible="not active or website_published or status not in ['draft', 'listed']"/>
                    <button name="action_unpublish_website" string="Unpublish" type="object" class="btn-secondary" invisible="not active or not website_published or status != 'listed'"/>
                    <button name="action_mark_leased" string="Mark Leased" type="object" class="btn-success" invisible="not active or status not in ['listed', 'under_offer']"/>
                    <button name="action_mark_sold" string="Mark Sold" type="object" class="btn-success" invisible="not active or status not in ['under_offer', 'listed']"/>
                    <button name="action_create_lease" string="Create Lease" type="object" class="btn-primary" invisible="not active or lease_ids != [] or status not in ['under_offer', 'listed']"/>
                    <button name="action_archive_property" string="Archive" type="object" class="btn-danger" invisible="not active or status not in ['sold', 'leased', 'maintenance']"/>
                    <button name="action_restore_property" string="Restore" type="object" class="btn-success" invisible="active or status != 'archived'"/>

                    <field name="status" widget="statusbar" statusbar_visible="draft,listed,under_offer,leased,sold,maintenance"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
<!--                        <button name="action_show_leases" type="object" class="oe_stat_button" icon="fa-file-text-o" context="{'default_property_id': active_id}">-->
<!--                            <div class="o_stat_info">-->
<!--                                <field name="lease_ids" widget="statbutton" string="Leases" options="{'field': 'lease_ids'}"/>-->
<!--                            </div>-->
<!--                        </button>-->
<!--                        <button name="action_show_maintenance" type="object" class="oe_stat_button" icon="fa-wrench">-->
<!--                            <div class="o_stat_info">-->
<!--                                <field name="maintenance_request_ids" widget="statbutton" string="Maintenance" options="{'field': 'maintenance_request_ids'}"/>-->
<!--                            </div>-->
<!--                        </button>-->
<!--                        <button name="%(action_property_unit)d" type="action" class="oe_stat_button" icon="fa-building">-->
<!--                            <div class="o_stat_info">-->
<!--                                <field name="unit_ids" widget="statbutton" string="Units" options="{'field': 'unit_ids'}"/>-->
<!--                            </div>-->
<!--                        </button>-->
<!--                        <button type="object" class="oe_stat_button" icon="fa-users">-->
<!--                            <div class="o_stat_info">-->
<!--                                <field name="viewing_ids" widget="statbutton" string="Viewings" options="{'field': 'viewing_ids'}"/>-->
<!--                            </div>-->
<!--                        </button>-->
<!--                        <button type="object" class="oe_stat_button" icon="fa-thermometer-half">-->
<!--                            <div class="o_stat_info">-->
<!--                                <field name="occupancy_rate" string="Occupancy" widget="statbutton" options="{'color': 'blue'}"/>-->
<!--                            </div>-->
<!--                        </button>-->
<!--                        <button type="object" class="oe_stat_button" icon="fa-dollar">-->
<!--                            <div class="o_stat_info">-->
<!--                                <field name="total_revenue" string="Revenue" widget="statbutton" options="{'color': 'green'}"/>-->
<!--                            </div>-->
<!--                        </button>-->
                    </div>

                    <div class="oe_title">
                        <div class="row">
                            <div class="col-8">
                                <h1>
                                    <field name="name" placeholder="Property Name"/>
                                    <span class="text-muted" groups="base.group_no_one">(<field name="property_code"/>)</span>
                                </h1>
                                <h4>
                                    <field name="type"/>
                                    <span class="text-muted">|</span>
                                    <field name="status" widget="badge"/>
                                    <field name="active" invisible="1"/>
<!--                                    <span t-if="record.website_published.raw_value" class="badge badge-success">Published</span>-->
<!--                                    <span t-if="record.iot_enabled.raw_value" class="badge badge-info">IoT Enabled</span>-->
                                </h4>
                            </div>
                            <div class="col-4 text-right">
                                <div class="row" style="margin-bottom: 5px;">
                                    <div class="col-12">
                                        <span class="text-muted">Base Price</span><br/>
                                        <h3><field name="base_price" widget="monetary"/></h3>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <span class="text-muted">Dynamic Price</span><br/>
                                        <h3><field name="dynamic_price" widget="monetary"/></h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <!-- Page: General Information -->
                        <page string="General Information">
                            <group>
                                <group string="Basic Details">
                                    <field name="type" widget="selection"/>
                                    <field name="category" widget="selection"/>
                                    <field name="property_code" readonly="1"/>
                                    <field name="active" invisible="1"/>
                                </group>
                                <group string="Specifications">
                                    <field name="bedrooms"/>
                                    <field name="bathrooms"/>
                                    <field name="area_total"/>
                                    <field name="area_living"/>
                                    <field name="area_land"/>
                                    <field name="area_unit"/>
                                    <field name="year_built"/>
                                    <field name="year_renovated"/>
                                    <field name="energy_rating" widget="selection"/>
                                </group>
                            </group>

                            <group string="Address">
                                <field name="partner_id" invisible="1"/>
                                <field name="street" placeholder="Street"/>
                                <field name="street2" placeholder="Street 2"/>
                                <field name="city" placeholder="City"/>
                                <field name="state_id" options="{'no_create': True}"/>
                                <field name="zip" placeholder="ZIP"/>
                                <field name="country_id" options="{'no_create': True}"/>
                                <field name="full_address" readonly="1"/>
                            </group>

                            <group string="Location &amp; Media">
                                <field name="latitude"/>
                                <field name="longitude"/>
                                <field name="virtual_tour_url" placeholder="https://"/>
                                <field name="ar_preview_url" placeholder="https://"/>
                                <field name="youtube_video" placeholder="YouTube Video ID"/>
                            </group>
                        </page>

                        <!-- Page: Pricing & Financial -->
                        <page string="Pricing &amp; Financial">
                            <group>
                                <group string="Pricing">
                                    <field name="currency_id" options="{'no_create': True}"/>
                                    <field name="base_price"/>
                                    <field name="dynamic_price" readonly="1"/>
                                    <field name="minimum_price"/>
                                    <field name="price_sqft" readonly="1"/>
                                </group>
                                <group string="Rental">
                                    <field name="rental_price"/>
                                    <field name="rental_deposit"/>
                                    <field name="hoa_fees"/>
                                    <field name="total_revenue" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Page: Ownership & Management -->
                        <page string="Ownership &amp; Management">
                            <group>
                                <group string="Owners &amp; Managers">
                                    <field name="owner_id" options="{'no_create': True}"/>
                                    <field name="manager_id" options="{'no_create': True}"/>
                                    <field name="sales_person_id" options="{'no_create': True}"/>
                                </group>
                                <group string="Status">
                                    <field name="status" widget="selection"/>
                                    <field name="website_published" widget="boolean_toggle"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>

                        <!-- Page: Description -->
                        <page string="Description">
                            <group string="Property Description">
                                <field name="description" widget="html"/>
                            </group>
                            <group string="Features &amp; Amenities">
                                <field name="features" widget="html"/>
                            </group>
                        </page>

                        <!-- Page: Units -->
                        <page string="Units" invisible="type != 'multi_unit'">
                            <field name="unit_ids" context="{'default_property_id': active_id}">
                                <tree>
                                    <field name="unit_number"/>
                                    <field name="floor_number"/>
                                    <field name="unit_type"/>
                                    <field name="status" widget="badge"/>
                                    <field name="unit_area"/>
                                    <field name="bedrooms"/>
                                    <field name="bathrooms"/>
                                    <field name="rent_amount"/>
                                    <field name="current_tenant_id"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="property_id" invisible="1"/>
                                            <field name="unit_number"/>
                                            <field name="floor_number"/>
                                            <field name="unit_type" widget="selection"/>
                                            <field name="status" widget="selection"/>
                                        </group>
                                        <group>
                                            <field name="unit_area"/>
                                            <field name="bedrooms"/>
                                            <field name="bathrooms"/>
                                            <field name="parking_spaces"/>
                                            <field name="storage_unit"/>
                                            <field name="balcony_area"/>
                                        </group>
                                    </group>
                                    <group string="Pricing">
                                        <group>
                                            <field name="unit_price"/>
                                            <field name="rent_amount"/>
                                            <field name="deposit_amount"/>
                                        </group>
                                        <group>
                                            <field name="hoa_fees"/>
                                            <field name="is_occupied" readonly="1"/>
                                            <field name="current_tenant_id" readonly="1"/>
                                        </group>
                                    </group>
                                    <group string="Leases">
                                        <field name="lease_ids" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <!-- Page: Leases -->
                        <page string="Leases">
                            <field name="lease_ids" context="{'default_property_id': active_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="unit_id"/>
                                    <field name="status" widget="badge"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="rent_amount"/>
                                    <field name="signed" widget="boolean_toggle"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="tenant_id"/>
                                            <field name="property_id" invisible="1"/>
                                            <field name="unit_id"/>
                                            <field name="status" widget="selection"/>
                                        </group>
                                        <group>
                                            <field name="start_date"/>
                                            <field name="end_date"/>
                                            <field name="term_months"/>
                                            <field name="signed" widget="boolean_toggle"/>
                                            <field name="signed_date"/>
                                        </group>
                                    </group>
                                    <group string="Financial">
                                        <group>
                                            <field name="rent_amount"/>
                                            <field name="deposit_amount"/>
                                            <field name="rent_frequency" widget="selection"/>
                                        </group>
                                        <group>
                                            <field name="late_fee_amount"/>
                                            <field name="late_fee_percent"/>
                                            <field name="grace_period_days"/>
                                        </group>
                                    </group>
                                    <group string="Legal">
                                        <field name="terms_conditions" widget="html"/>
                                        <field name="special_terms"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <!-- Page: Maintenance -->
                        <page string="Maintenance">
                            <field name="maintenance_request_ids" context="{'default_property_id': active_id}">
                                <tree>
                                    <field name="title"/>
                                    <field name="category" widget="badge"/>
                                    <field name="priority" widget="badge"/>
                                    <field name="status" widget="badge"/>
                                    <field name="scheduled_date"/>
                                    <field name="assigned_to_id"/>
                                    <field name="iot_alert" widget="boolean_toggle"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Page: HOA Associations -->
                        <page string="HOA Associations">
                            <field name="hoa_association_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="association_type"/>
                                    <field name="monthly_fee"/>
                                    <field name="annual_budget"/>
                                    <field name="board_member_count"/>
                                    <field name="property_count"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Page: IoT Devices -->
                        <page string="IoT Devices" invisible="not iot_enabled">
                            <field name="iot_device_ids" context="{'default_property_id': active_id}">
                                <tree>
                                    <field name="device_name"/>
                                    <field name="device_type"/>
                                    <field name="status" widget="badge"/>
                                    <field name="battery_level" widget="progressbar"/>
                                    <field name="last_seen"/>
                                    <field name="has_alert" widget="boolean_toggle"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="property_id" invisible="1"/>
                                            <field name="device_name"/>
                                            <field name="device_type" widget="selection"/>
                                            <field name="device_id" invisible="1"/>
                                        </group>
                                        <group>
                                            <field name="status" widget="selection"/>
                                            <field name="battery_level"/>
                                            <field name="last_seen"/>
                                            <field name="has_alert" widget="boolean_toggle"/>
                                        </group>
                                    </group>
                                    <group string="Location">
                                        <field name="location_description"/>
                                        <field name="floor"/>
                                        <field name="room"/>
                                    </group>
                                    <group string="Technical">
                                        <field name="manufacturer"/>
                                        <field name="model"/>
                                        <field name="firmware_version"/>
                                        <field name="installation_date"/>
                                    </group>
                                    <group string="Alerts">
                                        <field name="alert_ids"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <!-- Page: Analytics -->
                        <page string="Analytics">
                            <group>
                                <group string="Performance Metrics">
                                    <field name="occupancy_rate" readonly="1"/>
                                    <field name="total_revenue" readonly="1"/>
                                    <field name="next_maintenance_date" readonly="1"/>
                                </group>
                                <group string="IoT Statistics">
                                    <field name="iot_enabled" readonly="1"/>
                                    <field name="smart_lock_enabled" widget="boolean_toggle"/>
                                    <field name="security_system_enabled" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ===================================================================== -->
    <!-- Property Action Window -->
    <!-- ===================================================================== -->

    <record id="action_property_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">property.property</field>
<!--        <field name="view_mode">kanban,tree,form,pivot,graph,calendar</field>-->
        <field name="view_mode">tree,form,pivot,graph,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property
            </p>
            <p>
                Manage all your properties in one place. Track listings, leases, maintenance, and more.
            </p>
        </field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- ===================================================================== -->
    <!-- Property Pivot View -->
    <!-- ===================================================================== -->

    <record id="view_property_property_pivot" model="ir.ui.view">
        <field name="name">property.property.pivot</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <pivot string="Properties">
                <field name="type" type="row"/>
                <field name="status" type="row"/>
                <field name="city" type="col"/>
                <field name="base_price" type="measure" operator="sum"/>
                <field name="dynamic_price" type="measure" operator="sum"/>
                <field name="area_total" type="measure" operator="sum"/>
                <field name="bedrooms" type="measure" operator="sum"/>
                <field name="bathrooms" type="measure" operator="sum"/>
                <field name="occupancy_rate" type="measure" operator="avg"/>
            </pivot>
        </field>
    </record>

