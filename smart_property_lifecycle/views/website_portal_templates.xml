<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================== -->
    <!-- Portal Leases Template -->
    <!-- ===================================================================== -->

    <template id="portal_leases" name="Portal Leases">
        <t t-call="portal.portal_layout">
            <div class="oe_structure">
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <h1 class="mt-4 mb-4">My Leases</h1>

                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Reference</th>
                                            <th>Property</th>
                                            <th>Unit</th>
                                            <th>Status</th>
                                            <th>Start Date</th>
                                            <th>End Date</th>
                                            <th>Monthly Rent</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="leases">
                                            <t t-foreach="leases" t-as="lease">
                                                <tr t-attf-class="{# 'table-success' if lease.status == 'active' else ''}">
                                                    <td><a t-attf-href="/my/leases/#{lease.id}"><t t-esc="lease.name"/></a></td>
                                                    <td><t t-esc="lease.property_id.name"/></td>
                                                    <td><t t-esc="lease.unit_id.unit_number or '-'"/></td>
                                                    <td>
                                                        <span class="badge" t-attf-class="{
                                                            'badge-success': lease.status == 'active',
                                                            'badge-warning': lease.status == 'pending_signature',
                                                            'badge-info': lease.status == 'signed',
                                                            'badge-danger': lease.status == 'terminated',
                                                            'badge-secondary': True
                                                        }">
                                                            <t t-esc="lease.status.replace('_', ' ').title()"/>
                                                        </span>
                                                    </td>
                                                    <td><t t-esc="lease.start_date"/></td>
                                                    <td><t t-esc="lease.end_date"/></td>
                                                    <td><t t-esc="lease.currency_id.symbol or '$'"/><t t-esc="lease.rent_amount"/></td>
                                                    <td>
                                                        <a t-attf-href="/my/leases/#{lease.id}" class="btn btn-sm btn-primary">
                                                            <i class="fa fa-eye"/> View
                                                        </a>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <tr>
                                                <td colspan="8" class="text-center">
                                                    <p class="text-muted">You don't have any leases yet.</p>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination -->
                            <t t-if="pager and pager.get('page_count', 0) > 1">
                                <div class="text-center">
                                    <ul class="pagination">
                                        <t t-if="pager.get('page', 0) > 0">
                                            <li class="page-item">
                                                <a class="page-link" t-attf-href="/my/leases?page=#{pager.get('page', 0)-1}">Previous</a>
                                            </li>
                                        </t>
                                        <t t-foreach="range(pager.get('page_count', 0))" t-as="page">
                                            <li class="page-item" t-attf-class="{'active': page == pager.get('page', 0)}">
                                                <a class="page-link" t-attf-href="/my/leases?page=#{page}">
                                                    <t t-esc="page+1"/>
                                                </a>
                                            </li>
                                        </t>
                                        <t t-if="pager.get('page', 0) + 1 &lt; pager.get('page_count', 0)">
                                            <li class="page-item">
                                                <a class="page-link" t-attf-href="/my/leases?page=#{pager.get('page', 0)+1}">Next</a>
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================================================================== -->
    <!-- Portal Lease Detail Template -->
    <!-- ===================================================================== -->

    <template id="portal_lease_detail" name="Portal Lease Detail">
        <t t-call="portal.portal_layout">
            <div class="oe_structure">
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                                    <li class="breadcrumb-item"><a href="/my/leases">My Leases</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">
                                        <t t-esc="lease.name"/>
                                    </li>
                                </ol>
                            </nav>

                            <h1 class="mt-4">
                                Lease <t t-esc="lease.name"/>
                                <span class="badge" t-attf-class="{
                                    'badge-success': lease.status == 'active',
                                    'badge-warning': lease.status == 'pending_signature',
                                    'badge-info': lease.status == 'signed',
                                    'badge-danger': lease.status == 'terminated',
                                    'badge-secondary': True
                                }">
                                    <t t-esc="lease.status.replace('_', ' ').title()"/>
                                </span>
                            </h1>

                            <div class="row mt-4">
                                <!-- Lease Info -->
                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 class="mb-0">Lease Details</h5>
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-borderless">
                                                <tr>
                                                    <td><strong>Property:</strong></td>
                                                    <td><t t-esc="lease.property_id.name"/></td>
                                                </tr>
                                                <tr t-if="lease.unit_id">
                                                    <td><strong>Unit:</strong></td>
                                                    <td><t t-esc="lease.unit_id.unit_number"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Tenant:</strong></td>
                                                    <td><t t-esc="lease.tenant_id.name"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Start Date:</strong></td>
                                                    <td><t t-esc="lease.start_date"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>End Date:</strong></td>
                                                    <td><t t-esc="lease.end_date"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Term:</strong></td>
                                                    <td><t t-esc="lease.term_months"/> months</td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Rent Frequency:</strong></td>
                                                    <td><t t-esc="lease.rent_frequency"/></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <!-- Financial Info -->
                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 class="mb-0">Financial Information</h5>
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-borderless">
                                                <tr>
                                                    <td><strong>Monthly Rent:</strong></td>
                                                    <td><t t-esc="lease.currency_id.symbol or '$'"/><t t-esc="lease.rent_amount"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Security Deposit:</strong></td>
                                                    <td><t t-esc="lease.currency_id.symbol or '$'"/><t t-esc="lease.deposit_amount"/></td>
                                                </tr>
                                                <tr t-if="lease.deposit_returned">
                                                    <td><strong>Deposit Returned:</strong></td>
                                                    <td><span class="badge badge-success">Yes</span></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Amount Paid:</strong></td>
                                                    <td><t t-esc="lease.currency_id.symbol or '$'"/><t t-esc="lease.paid_amount"/></td>
                                                </tr>
                                                <tr t-if="lease.outstanding_amount > 0">
                                                    <td><strong>Outstanding:</strong></td>
                                                    <td class="text-danger"><t t-esc="lease.currency_id.symbol or '$'"/><t t-esc="lease.outstanding_amount"/></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Invoices -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 class="mb-0">Invoices</h5>
                                        </div>
                                        <div class="card-body">
                                            <t t-if="invoices">
                                                <table class="table table-sm">
                                                    <thead>
                                                        <tr>
                                                            <th>Invoice #</th>
                                                            <th>Date</th>
                                                            <th>Due Date</th>
                                                            <th>Amount</th>
                                                            <th>Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="invoices" t-as="invoice">
                                                            <tr>
                                                                <td><t t-esc="invoice.name"/></td>
                                                                <td><t t-esc="invoice.invoice_date"/></td>
                                                                <td><t t-esc="invoice.invoice_date_due"/></td>
                                                                <td><t t-esc="invoice.amount_total"/></td>
                                                                <td>
                                                                    <span class="badge" t-attf-class="{
                                                                        'badge-success': invoice.state == 'paid',
                                                                        'badge-warning': invoice.state == 'posted',
                                                                        'badge-secondary': True
                                                                    }">
                                                                        <t t-esc="invoice.state"/>
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                </table>
                                            </t>
                                            <t t-else="">
                                                <p class="text-muted">No invoices yet.</p>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Maintenance Requests -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 class="mb-0">Maintenance Requests</h5>
                                        </div>
                                        <div class="card-body">
                                            <t t-if="maintenance_requests">
                                                <table class="table table-sm">
                                                    <thead>
                                                        <tr>
                                                            <th>Title</th>
                                                            <th>Category</th>
                                                            <th>Priority</th>
                                                            <th>Status</th>
                                                            <th>Date</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="maintenance_requests" t-as="maintenance">
                                                            <tr>
                                                                <td><a t-attf-href="/my/maintenance/#{maintenance.id}"><t t-esc="maintenance.title"/></a></td>
                                                                <td><span class="badge badge-secondary"><t t-esc="maintenance.category"/></span></td>
                                                                <td>
                                                                    <span class="badge" t-attf-class="{
                                                                        'badge-danger': maintenance.priority == 'emergency',
                                                                        'badge-warning': maintenance.priority == 'high',
                                                                        'badge-info': True
                                                                    }">
                                                                        <t t-esc="maintenance.priority"/>
                                                                    </span>
                                                                </td>
                                                                <td>
                                                                    <span class="badge" t-attf-class="{
                                                                        'badge-success': maintenance.status == 'completed',
                                                                        'badge-warning': maintenance.status == 'in_progress',
                                                                        'badge-info': True
                                                                    }">
                                                                        <t t-esc="maintenance.status"/>
                                                                    </span>
                                                                </td>
                                                                <td><t t-esc="maintenance.create_date"/></td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                </table>
                                            </t>
                                            <t t-else="">
                                                <p class="text-muted">No maintenance requests.</p>
                                            </t>
                                            <a href="/my/maintenance/create" class="btn btn-sm btn-primary">
                                                <i class="fa fa-plus"/> Create Maintenance Request
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================================================================== -->
    <!-- Portal Maintenance Template -->
    <!-- ===================================================================== -->

    <template id="portal_maintenance" name="Portal Maintenance">
        <t t-call="portal.portal_layout">
            <div class="oe_structure">
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <h1 class="mt-4 mb-4">My Maintenance Requests</h1>

                            <a href="/my/maintenance/create" class="btn btn-primary mb-3">
                                <i class="fa fa-plus"/> New Request
                            </a>

                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Title</th>
                                            <th>Property</th>
                                            <th>Category</th>
                                            <th>Priority</th>
                                            <th>Status</th>
                                            <th>Date</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="maintenance_requests">
                                            <t t-foreach="maintenance_requests" t-as="maintenance">
                                                <tr>
                                                    <td><t t-esc="maintenance.title"/></td>
                                                    <td><t t-esc="maintenance.property_id.name"/></td>
                                                    <td><span class="badge badge-secondary"><t t-esc="maintenance.category"/></span></td>
                                                    <td>
                                                        <span class="badge" t-attf-class="{
                                                            'badge-danger': maintenance.priority == 'emergency',
                                                            'badge-warning': maintenance.priority == 'high',
                                                            'badge-info': True
                                                        }">
                                                            <t t-esc="maintenance.priority"/>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="badge" t-attf-class="{
                                                            'badge-success': maintenance.status == 'completed',
                                                            'badge-warning': maintenance.status == 'in_progress',
                                                            'badge-info': True
                                                        }">
                                                            <t t-esc="maintenance.status"/>
                                                        </span>
                                                    </td>
                                                    <td><t t-esc="maintenance.create_date"/></td>
                                                    <td>
                                                        <a t-attf-href="/my/maintenance/#{maintenance.id}" class="btn btn-sm btn-primary">
                                                            <i class="fa fa-eye"/> View
                                                        </a>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <tr>
                                                <td colspan="7" class="text-center">
                                                    <p class="text-muted">No maintenance requests found.</p>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================================================================== -->
    <!-- Portal Maintenance Form Template -->
    <!-- ===================================================================== -->

    <template id="portal_maintenance_form" name="Portal Maintenance Form">
        <t t-call="portal.portal_layout">
            <div class="oe_structure">
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                                    <li class="breadcrumb-item"><a href="/my/maintenance">Maintenance</a></li>
                                    <li class="breadcrumb-item active">Create Request</li>
                                </ol>
                            </nav>

                            <h1 class="mt-4">Create Maintenance Request</h1>

                            <div class="card mt-4">
                                <div class="card-body">
                                    <form method="post">
                                        <div class="form-group">
                                            <label>Title *</label>
                                            <input type="text" name="title" class="form-control" required="required"/>
                                        </div>
                                        <div class="form-group">
                                            <label>Description</label>
                                            <textarea name="description" class="form-control" rows="3" placeholder="Describe the issue..."></textarea>
                                        </div>
                                        <div class="form-group">
                                            <label>Property *</label>
                                            <select name="property_id" class="form-control" required="required">
                                                <option value="">Select Property</option>
                                                <t t-foreach="leases" t-as="lease">
                                                    <option t-att-value="lease.property_id.id">
                                                        <t t-esc="lease.property_id.name"/>
                                                        <t t-if="lease.unit_id"> - Unit <t t-esc="lease.unit_id.unit_number"/></t>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label>Category</label>
                                            <select name="category" class="form-control">
                                                <t t-foreach="categories" t-as="category">
                                                    <option t-att-value="category[0]"><t t-esc="category[1]"/></option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label>Priority</label>
                                            <select name="priority" class="form-control">
                                                <t t-foreach="priorities" t-as="priority">
                                                    <option t-att-value="priority[0]"><t t-esc="priority[1]"/></option>
                                                </t>
                                            </select>
                                        </div>
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-primary">Submit Request</button>
                                        <a href="/my/maintenance" class="btn btn-secondary">Cancel</a>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================================================================== -->
    <!-- Portal Maintenance Detail Template -->
    <!-- ===================================================================== -->

    <template id="portal_maintenance_detail" name="Portal Maintenance Detail">
        <t t-call="portal.portal_layout">
            <div class="oe_structure">
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                                    <li class="breadcrumb-item"><a href="/my/maintenance">Maintenance</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">
                                        <t t-esc="maintenance.title"/>
                                    </li>
                                </ol>
                            </nav>

                            <h1 class="mt-4">
                                <t t-esc="maintenance.title"/>
                                <span class="badge" t-attf-class="{
                                    'badge-success': maintenance.status == 'completed',
                                    'badge-warning': maintenance.status == 'in_progress',
                                    'badge-info': True
                                }">
                                    <t t-esc="maintenance.status.replace('_', ' ').title()"/>
                                </span>
                            </h1>

                            <div class="row mt-4">
                                <!-- Maintenance Details -->
                                <div class="col-md-8">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 class="mb-0">Request Details</h5>
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-borderless">
                                                <tr>
                                                    <td><strong>Property:</strong></td>
                                                    <td><t t-esc="maintenance.property_id.name"/></td>
                                                </tr>
                                                <tr t-if="maintenance.unit_id">
                                                    <td><strong>Unit:</strong></td>
                                                    <td><t t-esc="maintenance.unit_id.unit_number"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Category:</strong></td>
                                                    <td><span class="badge badge-secondary"><t t-esc="maintenance.category"/></span></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Priority:</strong></td>
                                                    <td>
                                                        <span class="badge" t-attf-class="{
                                                            'badge-danger': maintenance.priority == 'emergency',
                                                            'badge-warning': maintenance.priority == 'high',
                                                            'badge-info': True
                                                        }">
                                                            <t t-esc="maintenance.priority"/>
                                                        </span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Status:</strong></td>
                                                    <td><t t-esc="maintenance.status.replace('_', ' ').title()"/></td>
                                                </tr>
                                                <tr t-if="maintenance.scheduled_date">
                                                    <td><strong>Scheduled Date:</strong></td>
                                                    <td><t t-esc="maintenance.scheduled_date"/></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Reported:</strong></td>
                                                    <td><t t-esc="maintenance.create_date"/></td>
                                                </tr>
                                                <tr t-if="maintenance.completed_date">
                                                    <td><strong>Completed:</strong></td>
                                                    <td><t t-esc="maintenance.completed_date"/></td>
                                                </tr>
                                                <tr t-if="maintenance.assigned_to_id">
                                                    <td><strong>Assigned To:</strong></td>
                                                    <td><t t-esc="maintenance.assigned_to_id.name"/></td>
                                                </tr>
                                            </table>

                                            <h6>Description</h6>
                                            <p><t t-esc="maintenance.description or 'No description provided.'"/></p>

                                            <t t-if="maintenance.resolution_notes">
                                                <h6 class="mt-3">Resolution Notes</h6>
                                                <p><t t-esc="maintenance.resolution_notes"/></p>
                                            </t>
                                        </div>
                                    </div>
                                </div>

                                <!-- Status Timeline -->
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 class="mb-0">Status Timeline</h5>
                                        </div>
                                        <div class="card-body">
                                            <ul class="list-unstyled">
                                                <li class="mb-2">
                                                    <span class="badge badge-info">Reported</span>
                                                    <small class="text-muted"><t t-esc="maintenance.create_date"/></small>
                                                </li>
                                                <li t-if="maintenance.status in ['assigned', 'scheduled', 'in_progress', 'completed']" class="mb-2">
                                                    <span class="badge badge-info">Assigned</span>
                                                    <small class="text-muted"><t t-esc="maintenance.create_date"/></small>
                                                </li>
                                                <li t-if="maintenance.status in ['scheduled', 'in_progress', 'completed']" class="mb-2">
                                                    <span class="badge badge-info">Scheduled</span>
                                                    <small class="text-muted"><t t-esc="maintenance.scheduled_date"/></small>
                                                </li>
                                                <li t-if="maintenance.status in ['in_progress', 'completed']" class="mb-2">
                                                    <span class="badge badge-warning">In Progress</span>
                                                    <small class="text-muted"><t t-esc="maintenance.create_date"/></small>
                                                </li>
                                                <li t-if="maintenance.status == 'completed'" class="mb-2">
                                                    <span class="badge badge-success">Completed</span>
                                                    <small class="text-muted"><t t-esc="maintenance.completed_date"/></small>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <!-- IoT Info -->
                                    <div t-if="maintenance.iot_alert" class="card mt-3">
                                        <div class="card-header bg-warning">
                                            <h5 class="mb-0"><i class="fa fa-wifi"/> IoT Alert</h5>
                                        </div>
                                        <div class="card-body">
                                            <p>This request was auto-generated from an IoT device alert.</p>
                                            <t t-if="maintenance.iot_device_id">
                                                <p><strong>Device:</strong> <t t-esc="maintenance.iot_device_id.device_name"/></p>
                                                <p><strong>Type:</strong> <t t-esc="maintenance.iot_device_id.device_type"/></p>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================================================================== -->
    <!-- Portal Properties Template -->
    <!-- ===================================================================== -->

    <template id="portal_properties" name="Portal Properties">
        <t t-call="portal.portal_layout">
            <div class="oe_structure">
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <h1 class="mt-4 mb-4">My Properties</h1>

                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Name</th>
                                            <th>Type</th>
                                            <th>Status</th>
                                            <th>City</th>
                                            <th>Price</th>
                                            <th>Occupancy</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="properties">
                                            <t t-foreach="properties" t-as="property">
                                                <tr>
                                                    <td><t t-esc="property.property_code"/></td>
                                                    <td><a t-attf-href="/property/#{property.property_code}"><t t-esc="property.name"/></a></td>
                                                    <td><t t-esc="property.type"/></td>
                                                    <td>
                                                        <span class="badge" t-attf-class="{
                                                            'badge-success': property.status == 'listed',
                                                            'badge-warning': property.status == 'under_offer',
                                                            'badge-info': property.status == 'leased',
                                                            'badge-danger': property.status == 'sold',
                                                            'badge-secondary': True
                                                        }">
                                                            <t t-esc="property.status.replace('_', ' ').title()"/>
                                                        </span>
                                                    </td>
                                                    <td><t t-esc="property.city or '-'"/></td>
                                                    <td><t t-esc="property.currency_id.symbol or '$'"/><t t-esc="property.base_price"/></td>
                                                    <td><t t-esc="property.occupancy_rate"/>%</td>
                                                </tr>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <tr>
                                                <td colspan="7" class="text-center">
                                                    <p class="text-muted">You don't own any properties yet.</p>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>