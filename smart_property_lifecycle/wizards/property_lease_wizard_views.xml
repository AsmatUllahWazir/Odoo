    <!-- ===================================================================== -->
    <!-- Lease Termination Wizard -->
    <!-- ===================================================================== -->

    <record id="view_property_terminate_wizard_form" model="ir.ui.view">
        <field name="name">property.terminate.wizard.form</field>
        <field name="model">property.lease.terminate.wizard</field>
        <field name="arch" type="xml">
            <form string="Terminate Lease">
                <group>
                    <group string="Lease Information">
                        <field name="lease_id" readonly="1"/>
<!--                        <field name="lease_id.tenant_id" readonly="1" string="Tenant"/>-->
<!--                        <field name="lease_id.property_id" readonly="1" string="Property"/>-->
<!--                        <field name="lease_id.start_date" readonly="1" string="Start Date"/>-->
<!--                        <field name="lease_id.end_date" readonly="1" string="End Date"/>-->
                    </group>
                    <group string="Termination Details">
                        <field name="termination_date"/>
                        <field name="termination_reason" widget="selection"/>
                        <field name="termination_notes"/>
                    </group>
                </group>

                <group string="Deposit" invisible="not return_deposit">
                    <group>
                        <field name="return_deposit" widget="boolean_toggle"/>
                        <field name="deposit_return_date" invisible="not return_deposit"/>
                    </group>
                    <group>
                        <field name="deposit_deductions" invisible="not return_deposit"/>
                        <field name="deposit_returned_amount" readonly="1" invisible="not return_deposit"/>
                    </group>
                </group>

                <footer>
                    <button name="action_terminate_lease" string="Terminate Lease" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

