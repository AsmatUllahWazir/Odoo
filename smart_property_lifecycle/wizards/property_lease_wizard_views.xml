<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================== -->
    <!-- Lease Creation Wizard -->
    <!-- ===================================================================== -->

    <record id="view_property_lease_wizard_form" model="ir.ui.view">
        <field name="name">property.lease.wizard.form</field>
        <field name="model">property.lease.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Lease">
                <group>
                    <group string="Property Details">
                        <field name="property_id" options="{'no_create': True}"/>
<!--                        <field name="unit_id" options="{'no_create': True}" invisible="property_id.type != multy_unit"/>-->
                        <field name="unit_id" options="{'no_create': True}"/>
                        <field name="tenant_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Lease Terms">
                        <field name="start_date"/>
                        <field name="end_date" readonly="1"/>
                        <field name="term_months"/>
                        <field name="rent_frequency" widget="selection"/>
                    </group>
                </group>

                <group string="Financial">
                    <group>
                        <field name="currency_id" readonly="1"/>
                        <field name="rent_amount"/>
                        <field name="deposit_amount"/>
                    </group>
                    <group>
                        <field name="renewal_options" widget="selection"/>
                    </group>
                </group>

                <group string="Legal Terms">
                    <field name="terms_conditions" widget="html"/>
                    <field name="special_terms"/>
                </group>

                <group string="Options">
                    <group>
                        <field name="create_invoices" widget="boolean_toggle"/>
                        <field name="send_signature" widget="boolean_toggle"/>
                    </group>
                </group>

                <footer>
                    <button name="action_create_lease" string="Create Lease" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

