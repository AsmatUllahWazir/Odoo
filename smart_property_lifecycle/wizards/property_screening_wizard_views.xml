<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================== -->
    <!-- Tenant Screening Wizard -->
    <!-- ===================================================================== -->

    <record id="view_property_screening_wizard_form" model="ir.ui.view">
        <field name="name">property.screening.wizard.form</field>
        <field name="model">property.screening.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Tenant Screening">
                <group>
                    <group string="Applicant Information">
                        <field name="applicant_id" options="{'no_create': True}"/>
                        <field name="property_id" options="{'no_create': True}"/>
                        <field name="unit_id" options="{'no_create': True}" invisible="property_id.type != 'multi_unit'"/>
                        <field name="viewing_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Screening Details">
                        <field name="credit_score"/>
                        <field name="income_monthly"/>
                        <field name="employment_status" widget="selection"/>
                        <field name="employer_name"/>
                        <field name="employment_duration"/>
                    </group>
                </group>

                <group string="Background Information">
                    <group>
                        <field name="previous_address"/>
                        <field name="previous_landlord"/>
                        <field name="reference_1"/>
                        <field name="reference_2"/>
                    </group>
                    <group>
                        <field name="criminal_background" widget="selection"/>
                        <field name="eviction_history" widget="selection"/>
                        <field name="pets_allowed" widget="boolean_toggle"/>
                        <field name="pet_details" invisible="not pets_allowed"/>
                        <field name="smoking" widget="boolean_toggle"/>
                        <field name="move_in_date"/>
                    </group>
                </group>

                <group string="Notes">
                    <field name="notes"/>
                </group>

                <footer>
                    <button name="action_create_screening" string="Create Screening" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>