<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tracking Update Cron -->
    <record id="cron_update_tracking" model="ir.cron">
        <field name="name">Update Shipment Tracking</field>
        <field name="model_id" ref="model_shipping_shipment"/>
        <field name="code">model.action_update_tracking()</field>
        <field name="state">code</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Cleanup Old Tracking Data -->
    <record id="cron_cleanup_tracking" model="ir.cron">
        <field name="name">Clean Old Tracking Data</field>
        <field name="model_id" ref="model_shipping_tracking_event"/>
        <field name="code">model.action_cleanup_old_events()</field>
        <field name="state">code</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Update Dashboard Statistics -->
    <record id="cron_update_dashboard" model="ir.cron">
        <field name="name">Update Dashboard Statistics</field>
        <field name="model_id" ref="model_shipping_dashboard"/>
        <field name="code">model.action_update_statistics()</field>
        <field name="state">code</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Clean Old API Logs -->
    <record id="cron_clean_api_logs" model="ir.cron">
        <field name="name">Clean Old API Logs</field>
        <field name="model_id" ref="model_shipping_api_log"/>
        <field name="code">model.clean_old_logs()</field>
        <field name="state">code</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Archive Old Shipments -->
    <record id="cron_archive_old_shipments" model="ir.cron">
        <field name="name">Archive Old Shipments</field>
        <field name="model_id" ref="model_shipping_shipment"/>
        <field name="code">model.action_cleanup_old_shipments()</field>
        <field name="state">code</field>
        <field name="interval_number">30</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Auto-Expire Insurance Policies -->
    <record id="cron_expire_insurance" model="ir.cron">
        <field name="name">Expire Insurance Policies</field>
        <field name="model_id" ref="model_shipping_insurance_policy"/>
        <field name="code">model.action_auto_expire()</field>
        <field name="state">code</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>