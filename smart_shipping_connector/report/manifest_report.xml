<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <report
        id="manifest_report"
        model="shipping.shipment"
        string="Manifest"
        report_type="qweb-pdf"
        name="smart_shipping_connector.manifest"
        file="smart_shipping_connector.manifest"
        attachment_use="False"
        paperformat="smart_shipping_connector.paperformat_manifest"
        print_report_name="'Manifest - %s' % (fields.Date.today())"
    />

    <template id="manifest">
        <t t-call="web.html_container">
            <div class="page" style="padding: 20px; font-family: Arial, sans-serif;">
                <div class="oe_structure">
                    <div style="text-align: center; border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 20px;">
                        <h1 style="margin: 0;">SHIPPING MANIFEST</h1>
                        <p style="font-size: 12px; margin: 5px 0;">
                            Generated: <t t-out="format_date(fields.Datetime.now())"/>
                        </p>
                    </div>

                    <table style="width: 100%; font-size: 9px; border-collapse: collapse; margin-bottom: 15px;">
                        <thead>
                            <tr style="background: #f5f5f5;">
                                <th style="padding: 4px; border: 1px solid #ddd; text-align: left;">#</th>
                                <th style="padding: 4px; border: 1px solid #ddd; text-align: left;">Reference</th>
                                <th style="padding: 4px; border: 1px solid #ddd; text-align: left;">Carrier</th>
                                <th style="padding: 4px; border: 1px solid #ddd; text-align: left;">Service</th>
                                <th style="padding: 4px; border: 1px solid #ddd; text-align: left;">Tracking</th>
                                <th style="padding: 4px; border: 1px solid #ddd; text-align: left;">Recipient</th>
                                <th style="padding: 4px; border: 1px solid #ddd; text-align: center;">Weight</th>
                                <th style="padding: 4px; border: 1px solid #ddd; text-align: center;">Packages</th>
                                <th style="padding: 4px; border: 1px solid #ddd; text-align: right;">Cost</th>
                                <th style="padding: 4px; border: 1px solid #ddd; text-align: left;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="shipment" t-set="index">
                                <td style="padding: 4px; border: 1px solid #ddd; text-align: center;">
                                    <t t-esc="index + 1"/>
                                </td>
                                <td style="padding: 4px; border: 1px solid #ddd;">
                                    <t t-out="shipment.name"/>
                                </td>
                                <td style="padding: 4px; border: 1px solid #ddd;">
                                    <t t-out="shipment.carrier_provider_id.name"/>
                                </td>
                                <td style="padding: 4px; border: 1px solid #ddd;">
                                    <t t-out="shipment.service_type or 'Standard'"/>
                                </td>
                                <td style="padding: 4px; border: 1px solid #ddd;">
                                    <t t-out="shipment.tracking_number or 'N/A'"/>
                                </td>
                                <td style="padding: 4px; border: 1px solid #ddd;">
                                    <t t-out="shipment.recipient_name[:20]"/>
                                </td>
                                <td style="padding: 4px; border: 1px solid #ddd; text-align: center;">
                                    <t t-out="shipment.total_weight or 0.0"/>
                                </td>
                                <td style="padding: 4px; border: 1px solid #ddd; text-align: center;">
                                    <t t-out="shipment.total_packages or 0"/>
                                </td>
                                <td style="padding: 4px; border: 1px solid #ddd; text-align: right;">
                                    <t t-out="format_currency(shipment.shipping_cost, shipment.currency_id)"/>
                                </td>
                                <td style="padding: 4px; border: 1px solid #ddd;">
                                    <span class="badge" t-attf-class="#{shipment.state == 'delivered' and 'badge-success' or shipment.state == 'exception' and 'badge-danger' or 'badge-warning'}">
                                        <t t-out="shipment.get_tracking_status_display()"/>
                                    </span>
                                </td>
                            </tr>
                            <tr t-if="not docs">
                                <td colspan="10" style="padding: 10px; border: 1px solid #ddd; text-align: center;">
                                    No shipments found
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr style="font-weight: bold; background: #f9f9f9;">
                                <td colspan="6" style="padding: 4px; border: 1px solid #ddd; text-align: right;">TOTALS:</td>
                                <td style="padding: 4px; border: 1px solid #ddd; text-align: center;">
                                    <t t-out="sum(docs.mapped('total_weight')) or 0.0"/>
                                </td>
                                <td style="padding: 4px; border: 1px solid #ddd; text-align: center;">
                                    <t t-out="sum(docs.mapped('total_packages')) or 0"/>
                                </td>
                                <td style="padding: 4px; border: 1px solid #ddd; text-align: right;">
                                    <t t-out="format_currency(sum(docs.mapped('shipping_cost')), docs[0].currency_id if docs else '')"/>
                                </td>
                                <td style="padding: 4px; border: 1px solid #ddd; text-align: center;">
                                    <t t-out="len(docs)"/> Shipments
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>