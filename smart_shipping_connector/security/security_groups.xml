<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="group_shipping_user" model="res.groups">
        <field name="name">Shipping User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Basic shipping user - can view and create shipments</field>
    </record>

    <record id="group_shipping_manager" model="res.groups">
        <field name="name">Shipping Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_shipping_user'))]"/>
        <field name="comment">Shipping manager - can approve shipments and configure settings</field>
    </record>

    <record id="group_shipping_admin" model="res.groups">
        <field name="name">Shipping Administrator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_shipping_manager'))]"/>
        <field name="comment">Shipping administrator - full access to all shipping features</field>
    </record>

    <record id="group_shipping_carrier_user" model="res.groups">
        <field name="name">Carrier Management</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_shipping_user'))]"/>
        <field name="comment">Can manage carrier providers and accounts</field>
    </record>
</odoo>