<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Carrier Account Tree View -->
    <record id="view_shipping_carrier_account_tree" model="ir.ui.view">
        <field name="name">shipping.carrier.account.tree</field>
        <field name="model">shipping.carrier.account</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="provider_id"/>
                <field name="environment"/>
                <field name="is_default"/>
                <field name="active"/>
                <field name="total_requests"/>
                <field name="success_requests"/>
                <field name="failed_requests"/>
            </tree>
        </field>
    </record>

    <!-- Carrier Account Form View -->
    <record id="view_shipping_carrier_account_form" model="ir.ui.view">
        <field name="name">shipping.carrier.account.form</field>
        <field name="model">shipping.carrier.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="toggle_active" type="object" class="btn-secondary"
                            invisible="active" string="Activate"/>
                    <button name="toggle_active" type="object" class="btn-danger"
                            invisible="not active" string="Deactivate"/>
                    <button name="action_test_connection" type="object" string="Test Connection"
                            class="btn-primary"/>
                    <button name="action_reset_counters" type="object" string="Reset Counters"
                            class="btn-secondary"/>
                    <button name="action_view_shipments" type="object" string="View Shipments"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Account Name..."/>
                        </h1>
                        <group>
                            <field name="provider_id" required="1"/>
                            <field name="environment"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                    </div>
                    <notebook>
                        <page string="Credentials">
                            <group>
                                <group>
                                    <field name="api_key" password="1"/>
                                    <field name="api_secret" password="1"/>
                                    <field name="username"/>
                                    <field name="password" password="1"/>
                                </group>
                                <group>
                                    <field name="account_number"/>
                                    <field name="meter_number"/>
                                    <field name="license_number"/>
                                    <field name="auth_type"/>
                                </group>
                            </group>
                            <group string="OAuth2" invisible="auth_type != 'oauth2'">
                                <field name="oauth2_client_id"/>
                                <field name="oauth2_client_secret" password="1"/>
                                <field name="oauth2_token_url"/>
                                <field name="oauth2_refresh_token"/>
                            </group>
                        </page>
                        <page string="API URLs">
                            <group>
                                <field name="test_api_url"/>
                                <field name="production_api_url"/>
                                <field name="test_api_key" password="1"/>
                                <field name="test_api_secret" password="1"/>
                            </group>
                        </page>
                        <page string="Defaults">
                            <group>
                                <group>
                                    <field name="default_weight_uom"/>
                                    <field name="default_dimension_uom"/>
                                    <field name="default_package_type"/>
                                </group>
                                <group>
                                    <field name="default_service_level" options="{'no_create': True}"/>
                                    <field name="default_signature_required"/>
                                    <field name="default_saturday_delivery"/>
                                    <field name="default_residential"/>
                                    <field name="default_insurance"/>
                                </group>
                            </group>
                        </page>
                        <page string="Rate Limits">
                            <group>
                                <group>
                                    <field name="requests_per_minute"/>
                                    <field name="requests_per_hour"/>
                                    <field name="requests_per_day"/>
                                </group>
                                <group>
                                    <field name="current_requests"/>
                                    <field name="last_reset_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Usage Statistics">
                            <group>
                                <group>
                                    <field name="last_used_date"/>
                                    <field name="total_requests"/>
                                    <field name="success_requests"/>
                                    <field name="failed_requests"/>
                                </group>
                                <group>
                                    <field name="last_error"/>
                                </group>
                            </group>
                        </page>
                        <page string="Custom Fields">
                            <field name="custom_fields" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Carrier Account Search View -->
    <record id="view_shipping_carrier_account_search" model="ir.ui.view">
        <field name="name">shipping.carrier.account.search</field>
        <field name="model">shipping.carrier.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="account_number"/>
                <field name="provider_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="production" string="Production" domain="[('environment','=','production')]"/>
                <filter name="sandbox" string="Sandbox" domain="[('environment','=','sandbox')]"/>
                <filter name="default" string="Default" domain="[('is_default','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_provider" string="Provider" context="{'group_by':'provider_id'}"/>
                    <filter name="group_environment" string="Environment" context="{'group_by':'environment'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shipping_carrier_account" model="ir.actions.act_window">
        <field name="name">Carrier Accounts</field>
        <field name="res_model">shipping.carrier.account</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure carrier accounts with API credentials
            </p>
        </field>
    </record>
</odoo>