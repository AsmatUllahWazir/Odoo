<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="assets_backend" name="Shipping Assets" inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <link rel="stylesheet" href="/smart_shipping_connector/static/src/scss/shipping.scss"/>
            <script src="/smart_shipping_connector/static/src/js/dashboard.js"/>
            <script src="/smart_shipping_connector/static/src/js/shipment.js"/>
            <script src="/smart_shipping_connector/static/src/js/tracking.js"/>
        </xpath>
    </template>

    <template id="assets_frontend" name="Shipping Frontend Assets" inherit_id="web.assets_frontend">
        <xpath expr="." position="inside">
            <script src="/smart_shipping_connector/static/src/js/tracking.js"/>
        </xpath>
    </template>
</odoo>