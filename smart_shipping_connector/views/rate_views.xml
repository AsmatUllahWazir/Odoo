<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rate Tree View -->
    <record id="view_shipping_rate_tree" model="ir.ui.view">
        <field name="name">shipping.rate.tree</field>
        <field name="model">shipping.rate</field>
        <field name="arch" type="xml">
            <tree>
                <field name="service_name"/>
                <field name="carrier_provider_id"/>
                <field name="total_cost" sum="Total"/>
                <field name="delivery_days"/>
                <field name="is_selected"/>
                <field name="is_recommended"/>
                <button name="action_select_rate" type="object" string="Select" class="btn-primary"/>
            </tree>
        </field>
    </record>

    <!-- Rate Form View -->
    <record id="view_shipping_rate_form" model="ir.ui.view">
        <field name="name">shipping.rate.form</field>
        <field name="model">shipping.rate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="service_name"/>
                        </h1>
                        <group>
                            <field name="carrier_provider_id"/>
                            <field name="service_code"/>
                            <field name="is_selected"/>
                            <field name="is_recommended"/>
                        </group>
                    </div>
                    <notebook>
                        <page string="Cost Breakdown">
                            <group>
                                <group>
                                    <field name="total_cost"/>
                                    <field name="base_cost"/>
                                    <field name="fuel_surcharge"/>
                                    <field name="total_surcharges"/>
                                </group>
                                <group>
                                    <field name="residential_surcharge"/>
                                    <field name="saturday_surcharge"/>
                                    <field name="insurance_surcharge"/>
                                    <field name="cod_surcharge"/>
                                    <field name="other_surcharges"/>
                                </group>
                            </group>
                            <group>
                                <field name="currency_id"/>
                            </group>
                        </page>
                        <page string="Delivery">
                            <group>
                                <field name="delivery_days"/>
                                <field name="delivery_date"/>
                                <field name="guaranteed_delivery"/>
                                <field name="guaranteed_time"/>
                                <field name="transit_time"/>
                                <field name="pickup_date"/>
                                <field name="cutoff_time"/>
                            </group>
                        </page>
                        <page string="Additional">
                            <group>
                                <field name="shipment_id"/>
                                <field name="carrier_account_id"/>
                                <field name="carrier_service_id"/>
                                <field name="service_type"/>
                                <field name="restrictions"/>
                                <field name="notes"/>
                            </group>
                            <group string="Raw Data">
                                <field name="raw_response" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Rate Request History Tree View -->
    <record id="view_shipping_rate_request_history_tree" model="ir.ui.view">
        <field name="name">shipping.rate.request.history.tree</field>
        <field name="model">shipping.rate.request.history</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="request_date"/>
                <field name="response_date"/>
                <field name="state" widget="badge"/>
                <field name="carrier_count"/>
                <field name="rate_count"/>
                <field name="response_time_ms"/>
            </tree>
        </field>
    </record>

    <!-- Rate Request History Form -->
    <record id="view_shipping_rate_request_history_form" model="ir.ui.view">
        <field name="name">shipping.rate.request.history.form</field>
        <field name="model">shipping.rate.request.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="shipment_id"/>
                            <field name="state" widget="statusbar"/>
                            <field name="request_date"/>
                            <field name="response_date"/>
                        </group>
                        <group>
                            <field name="carrier_count"/>
                            <field name="rate_count"/>
                            <field name="response_time_ms"/>
                            <field name="error_message" invisible="state != 'failed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request Data">
                            <field name="request_data" nolabel="1"/>
                        </page>
                        <page string="Response Data">
                            <field name="response_data" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_shipping_rate" model="ir.actions.act_window">
        <field name="name">Rates</field>
        <field name="res_model">shipping.rate</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_shipping_rate_request_history" model="ir.actions.act_window">
        <field name="name">Rate Request History</field>
        <field name="res_model">shipping.rate.request.history</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>