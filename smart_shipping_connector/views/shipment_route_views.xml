<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shipping_shipment_route_tree" model="ir.ui.view">
        <field name="name">shipping.shipment.route.tree</field>
        <field name="model">shipping.shipment.route</field>
        <field name="arch" type="xml">
            <tree>
                <field name="shipment_id"/>
                <field name="sequence"/>
                <field name="location"/>
                <field name="location_type"/>
                <field name="arrival_date"/>
                <field name="departure_date"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_shipping_shipment_route_form" model="ir.ui.view">
        <field name="name">shipping.shipment.route.form</field>
        <field name="model">shipping.shipment.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Route Stop</h1>
                    </div>
                    <group>
                        <group>
                            <field name="shipment_id" required="1"/>
                            <field name="location" required="1"/>
                            <field name="location_type"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group>
                        <field name="arrival_date"/>
                        <field name="departure_date"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shipping_shipment_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">shipping.shipment.route</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>