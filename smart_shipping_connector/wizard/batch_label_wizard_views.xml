<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shipping_batch_label_wizard" model="ir.ui.view">
        <field name="name">shipping.batch.label.wizard</field>
        <field name="model">shipping.batch.label.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Batch Label Generation</h1>
                    </div>
                    <group>
                        <field name="shipment_ids" widget="many2many_tags" options="{'no_create': True}" required="1"/>
                        <field name="label_format"/>
                        <field name="include_return_labels"/>
                        <field name="notes"/>
                    </group>
                    <footer>
                        <button name="action_generate_labels" type="object" string="Generate Labels" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>