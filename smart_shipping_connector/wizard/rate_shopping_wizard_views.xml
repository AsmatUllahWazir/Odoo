<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rate Shopping Wizard Form -->
    <record id="view_shipping_rate_request_form" model="ir.ui.view">
        <field name="name">shipping.rate.request.form</field>
        <field name="model">shipping.rate.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_get_rates" type="object" string="Get Rates"
                            class="btn-primary" invisible="state not in ['draft']"/>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-secondary" invisible="state != 'failed'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Rate Shopping</h1>
                    </div>
                    <group>
                        <field name="shipment_id" options="{'no_create': True}"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,requesting,completed"/>
                        <field name="request_date"/>
                        <field name="response_date"/>
                        <field name="error_message" invisible="state != 'failed'"/>
                        <field name="carrier_ids" widget="many2many_tags" invisible="state in ['requesting','completed']"/>
                        <field name="include_fuel_surcharge"/>
                        <field name="include_residential"/>
                    </group>
                    <field name="rate_ids" invisible="state in ['draft', 'requesting']">
                        <tree>
                            <field name="service_name"/>
                            <field name="carrier_provider_id"/>
                            <field name="total_cost" sum="Total"/>
                            <field name="delivery_days"/>
                            <field name="fuel_surcharge"/>
                            <field name="is_recommended" invisible="1"/>
                            <button name="action_select_rate" type="object" string="Select"
                                    class="btn-primary"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>