<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="barcode_scanner_pro_template" name="Barcode Scanner Pro">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
                <script src="/stock_barcode_scanner_pro/static/src/lib/html5-qrcode.min.js"></script>
            </t>
            <div id="barcode_scanner_pro_root"
                 t-att-data-picking-id="picking_id"
                 style="min-height: 100vh; background: #f5f5f5;">
                <div class="scanner-header">
                    <h3>Scan: <t t-esc="picking_name"/></h3>
                    <p class="text-muted"><t t-esc="partner"/> — <t t-esc="origin"/></p>
                </div>
                <div id="scanner-reader" style="width: 100%; max-width: 480px; margin: 0 auto;"></div>
                <div class="scanner-controls">
                    <button id="scanner-start" class="btn btn-primary btn-lg btn-block">Start Camera</button>
                    <button id="scanner-stop" class="btn btn-secondary btn-lg btn-block" style="display:none;">Stop Camera</button>
                    <button id="scanner-validate" class="btn btn-success btn-lg btn-block">Validate Picking</button>
                </div>
                <div id="scanner-manual">
                    <label>Manual barcode entry:</label>
                    <div class="input-group">
                        <input type="text" id="scanner-manual-input" class="form-control" placeholder="Type barcode and press Enter"/>
                        <span class="input-group-btn">
                            <button id="scanner-manual-submit" class="btn btn-default">Add</button>
                        </span>
                    </div>
                </div>
                <div id="scanner-log" class="scanner-log"></div>
                <div id="scanner-lines" class="scanner-lines"></div>
            </div>
        </t>
    </template>
</odoo>