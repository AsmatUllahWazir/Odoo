<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Invoice Multi-Company Rules -->
        <record id="account_move_dispatch_company_rule" model="ir.rule">
            <field name="name">Vendor Bills: Multi-company</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[
                '|',
                    ('company_id', '=', False),
                    ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_dms_user'))]"/>
        </record>

        <!-- OCR Results: Users can only see OCR for bills in their companies -->
        <record id="ocr_result_company_rule" model="ir.rule">
            <field name="name">OCR Results: Multi-company</field>
            <field name="model_id" ref="model_vendor_bill_ocr_result"/>
            <field name="domain_force">[
                '|',
                    ('invoice_id.company_id', '=', False),
                    ('invoice_id.company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_dms_user'))]"/>
        </record>

        <!-- Validation History: Multi-company access -->
        <record id="validation_history_company_rule" model="ir.rule">
            <field name="name">Validation History: Multi-company</field>
            <field name="model_id" ref="model_vendor_bill_validation_history"/>
            <field name="domain_force">[
                '|',
                    ('invoice_id.company_id', '=', False),
                    ('invoice_id.company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_dms_user'))]"/>
        </record>

        <!-- Dispatch Rules: All active companies can see all rules -->
        <record id="dispatch_rule_all_companies" model="ir.rule">
            <field name="name">Dispatch Rules: All Companies</field>
            <field name="model_id" ref="model_vendor_bill_dispatch_rule"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dms_user'))]"/>
        </record>

        <!-- Configuration: Accessible to all -->
        <record id="config_all_access" model="ir.rule">
            <field name="name">Configuration: Global Access</field>
            <field name="model_id" ref="model_vendor_bill_dispatch_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dms_user'))]"/>
        </record>

        <!-- KPI: Multi-company -->
        <record id="kpi_company_rule" model="ir.rule">
            <field name="name">KPI: Multi-company</field>
            <field name="model_id" ref="model_dispatch_kpi"/>
            <field name="domain_force">[
                '|',
                    ('company_id', '=', False),
                    ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_business_validator'))]"/>
        </record>

    </data>
</odoo>