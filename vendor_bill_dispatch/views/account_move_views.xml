<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherited Invoice Form View -->
        <record id="view_move_form_dispatch" model="ir.ui.view">
            <field name="name">account.move.form.dispatch</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <!-- Add dispatch state in header -->
                <xpath expr="//header" position="inside">
                    <field name="dispatch_state" widget="statusbar"
                           statusbar_visible="ocr_draft,routed,to_approve,approved,finance_approved"
                           invisible="move_type != 'in_invoice'"/>

                    <button name="action_process_ocr" string="Process OCR" type="object" class="btn-primary"
                            invisible="move_type != 'in_invoice' or ocr_status in ['processing', 'done']"/>

                    <button name="action_auto_dispatch" string="Auto Dispatch" type="object" class="btn-primary"
                            invisible="move_type != 'in_invoice' or dispatch_state != 'ocr_draft'"/>

                    <button name="action_submit_for_approval" string="Submit for Approval" type="object"
                            class="btn-primary"
                            invisible="move_type != 'in_invoice' or dispatch_state != 'routed'"/>

                    <button name="action_business_approve" string="Business Approve" type="object" class="btn-success"
                            invisible="not can_business_approve"/>

                    <button name="action_finance_approve" string="Finance Approve" type="object" class="btn-success"
                            invisible="not can_finance_approve"/>

                    <button name="action_reject" string="Reject" type="object" class="btn-danger"
                            invisible="move_type != 'in_invoice' or dispatch_state not in ['to_approve', 'approved']"/>
                </xpath>
                <!-- Add dispatch info alert -->
                <xpath expr="//sheet" position="before">
                    <div class="alert alert-info text-center" role="alert"
                         invisible="dispatch_state not in ['to_approve', 'approved']">
                        <strong>Awaiting Approval:</strong>
                        This invoice requires validation before posting.

                        <field name="requires_finance_approval" invisible="1"/>

                        <span invisible="not requires_finance_approval">
                            (Finance approval required for high-value invoice)
                        </span>
                    </div>

                    <div class="alert alert-danger text-center" role="alert"
                         invisible="dispatch_state != 'rejected'">
                        <strong>Rejected:</strong>
                        <field name="rejection_reason" readonly="1"/>
                    </div>
                </xpath>

                <!-- Add dispatch info in notebook -->
                <xpath expr="//notebook" position="inside">
                    <page string="Dispatch Info" name="dispatch_info"
                          invisible="move_type != 'in_invoice'">
                        <group>
                            <group string="OCR Information">
                                <field name="ocr_status"/>
                                <field name="ocr_confidence" widget="percentage"/>
                                <field name="ocr_result_id"/>
                                <field name="ocr_error_message" invisible="ocr_status != 'error'"/>
                            </group>
                            <group string="Dispatch Information">
                                <field name="original_company_id"/>
                                <field name="dispatch_method"/>
                                <field name="dispatch_rule_id"/>
                                <field name="dispatch_date"/>
                                <field name="dispatch_user_id"/>
                            </group>
                        </group>

                        <group>
                            <group string="Business Validation">
                                <field name="business_approved_by"/>
                                <field name="business_approved_date"/>
                            </group>
                            <group string="Finance Validation">
                                <field name="finance_approved_by"/>
                                <field name="finance_approved_date"/>
                            </group>
                        </group>

                        <group string="Rejection Info" invisible="dispatch_state != 'rejected'">
                            <field name="rejected_by"/>
                            <field name="rejected_date"/>
                        </group>

                        <separator string="Validation History"/>
                        <field name="validation_history_ids" nolabel="1" mode="list">
                            <list string="Validation History" create="false" edit="false">
                                <field name="timestamp" string="Date"/>
                                <field name="action"/>
                                <field name="user_id"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </page>
                </xpath>

                <!-- Hidden fields for permissions -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="can_business_approve" invisible="1"/>
                    <field name="can_finance_approve" invisible="1"/>
                    <field name="can_post" invisible="1"/>
                </xpath>

            </field>
        </record>

        <!-- Vendor Bills to Approve List View -->
        <record id="view_move_list_dispatch_to_approve" model="ir.ui.view">
            <field name="name">account.move.list.dispatch.to.approve</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list string="Bills To Approve" decoration-info="dispatch_state == 'to_approve'"
                      decoration-success="dispatch_state == 'approved'"
                      decoration-danger="dispatch_state == 'rejected'">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="invoice_date"/>
                    <field name="amount_total"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="dispatch_state"/>
                    <field name="requires_finance_approval" widget="boolean_toggle"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_vendor_bills_to_approve" model="ir.actions.act_window">
            <field name="name">Bills To Approve</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('move_type', '=', 'in_invoice'), ('dispatch_state', '=', 'to_approve')]</field>
            <field name="context">{'default_move_type': 'in_invoice'}</field>
        </record>

        <record id="action_vendor_bills_finance_approval" model="ir.actions.act_window">
            <field name="name">Bills - Finance Approval</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('move_type', '=', 'in_invoice'), ('dispatch_state', '=', 'approved'),
                ('requires_finance_approval', '=', True)]
            </field>
            <field name="context">{'default_move_type': 'in_invoice'}</field>
        </record>

        <record id="action_vendor_bills_ocr_draft" model="ir.actions.act_window">
            <field name="name">Bills - OCR Draft</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('move_type', '=', 'in_invoice'), ('dispatch_state', '=', 'ocr_draft')]</field>
            <field name="context">{'default_move_type': 'in_invoice'}</field>
        </record>

    </data>
</odoo>