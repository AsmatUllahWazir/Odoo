<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_validation_history_list" model="ir.ui.view">
            <field name="name">vendor.bill.validation.history.list</field>
            <field name="model">vendor.bill.validation.history</field>
            <field name="arch" type="xml">
                <list string="Validation History">
                    <field name="timestamp"/>
                    <field name="invoice_id"/>
                    <field name="action"/>
                    <field name="user_id"/>
                    <field name="old_company_id"/>
                    <field name="new_company_id"/>
                    <field name="notes"/>
                </list>
            </field>
        </record>

        <record id="view_validation_history_form" model="ir.ui.view">
            <field name="name">vendor.bill.validation.history.form</field>
            <field name="model">vendor.bill.validation.history</field>
            <field name="arch" type="xml">
                <form string="Validation History" create="false" edit="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="invoice_id"/>
                                <field name="action"/>
                                <field name="user_id"/>
                                <field name="timestamp"/>
                            </group>
                            <group>
                                <field name="old_company_id"/>
                                <field name="new_company_id"/>
                                <field name="old_state"/>
                                <field name="new_state"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes"/>
                            <field name="rejection_reason"/>
                        </group>
                        <group>
                            <group>
                                <field name="ip_address"/>
                                <field name="session_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_validation_history" model="ir.actions.act_window">
            <field name="name">Validation History</field>
            <field name="res_model">vendor.bill.validation.history</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>