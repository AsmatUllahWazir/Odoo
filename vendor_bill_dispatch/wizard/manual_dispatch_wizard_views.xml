<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_manual_dispatch_wizard_form" model="ir.ui.view">
            <field name="name">vendor.bill.manual.dispatch.wizard.form</field>
            <field name="model">vendor.bill.manual.dispatch.wizard</field>
            <field name="arch" type="xml">
                <form string="Manual Company Selection">
                    <group>
                        <field name="invoice_id" invisible="1"/>

                        <field name="suggested_company_id"
                               readonly="1"
                               invisible="not suggested_company_id"/>

                        <field name="matched_rule_id"
                               readonly="1"
                               invisible="not matched_rule_id"/>

                        <field name="target_company_id"
                               options="{'no_create': True}"/>

                        <field name="notes"
                               placeholder="Optional notes about this dispatch decision..."/>
                    </group>
                    <footer>
                        <button name="action_dispatch" string="Dispatch" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>