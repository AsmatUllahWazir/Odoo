<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_reject_invoice_wizard_form" model="ir.ui.view">
            <field name="name">vendor.bill.reject.wizard.form</field>
            <field name="model">vendor.bill.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Invoice">
                    <group>
                        <field name="invoice_id" invisible="1"/>
                        <field name="rejection_reason" placeholder="Please provide a detailed reason for rejection (minimum 10 characters)..."/>
                        <field name="notify_submitter"/>
                    </group>
                    <footer>
                        <button name="action_reject" string="Reject Invoice" type="object" class="btn-danger"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>