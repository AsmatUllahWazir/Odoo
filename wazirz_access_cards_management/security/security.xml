<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
    GROUPS (No category needed - removed category_id)
    ============================================================= -->
    <record id="group_access_card_user" model="res.groups">
        <field name="name">Access Card User</field>
    </record>

    <record id="group_access_card_manager" model="res.groups">
        <field name="name">Access Card Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_access_card_user'))]"/>
    </record>

    <record id="group_access_card_admin" model="res.groups">
        <field name="name">Access Card Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_access_card_manager'))]"/>
    </record>

    <!-- ============================================================
    RECORD RULES (Unchanged - these still work the same way)
    ============================================================= -->
    <record id="access_card_company_rule" model="ir.rule">
        <field name="name">Access Card: Multi-Company</field>
        <field name="model_id" ref="model_access_card"/>
        <field name="global" eval="True"/>
    </record>

    <record id="client_floor_company_rule" model="ir.rule">
        <field name="name">Client Floor: Multi-Company</field>
        <field name="model_id" ref="model_client_floor"/>
        <field name="global" eval="True"/>
    </record>
</odoo>