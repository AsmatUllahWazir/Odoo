<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Parking Module Categories -->
        <record id="module_category_parking" model="ir.module.category">
            <field name="name">Parking Management</field>
            <field name="sequence">10</field>
        </record>

        <record id="module_category_parking_config" model="ir.module.category">
            <field name="name">Parking Configuration</field>
            <field name="parent_id" ref="module_category_parking"/>
            <field name="sequence">1</field>
        </record>

        <!-- Parking Groups -->
        <record id="group_parking_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_parking"/>
        </record>

        <record id="group_parking_management_approval" model="res.groups">
            <field name="name">Management Approval</field>
            <field name="category_id" ref="module_category_parking"/>
            <field name="implied_ids" eval="[(4, ref('group_parking_user'))]"/>
        </record>

        <record id="group_parking_tech_active" model="res.groups">
            <field name="name">Technical Active</field>
            <field name="category_id" ref="module_category_parking"/>
            <field name="implied_ids" eval="[(4, ref('group_parking_user'))]"/>
        </record>

        <record id="group_parking_active" model="res.groups">
            <field name="name">Active</field>
            <field name="category_id" ref="module_category_parking"/>
            <field name="implied_ids" eval="[(4, ref('group_parking_user'))]"/>
        </record>

        <record id="group_parking_block" model="res.groups">
            <field name="name">Block</field>
            <field name="category_id" ref="module_category_parking"/>
            <field name="implied_ids" eval="[(4, ref('group_parking_user'))]"/>
        </record>

        <record id="group_parking_cancel" model="res.groups">
            <field name="name">Cancel</field>
            <field name="category_id" ref="module_category_parking"/>
            <field name="implied_ids" eval="[(4, ref('group_parking_user'))]"/>
        </record>

        <record id="group_parking_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_parking"/>
            <field name="implied_ids" eval="[
                (4, ref('group_parking_user')),
                (4, ref('group_parking_management_approval')),
                (4, ref('group_parking_tech_active')),
                (4, ref('group_parking_active')),
                (4, ref('group_parking_block')),
                (4, ref('group_parking_cancel'))
            ]"/>
        </record>

        <!-- Configuration Groups -->
        <record id="group_parking_config_manager" model="res.groups">
            <field name="name">Configuration Manager</field>
            <field name="category_id" ref="module_category_parking_config"/>
            <field name="implied_ids" eval="[(4, ref('group_parking_administrator'))]"/>
        </record>

        <record id="group_parking_config_user" model="res.groups">
            <field name="name">Configuration User</field>
            <field name="category_id" ref="module_category_parking_config"/>
            <field name="implied_ids" eval="[(4, ref('group_parking_user'))]"/>
        </record>
    </data>
</odoo>