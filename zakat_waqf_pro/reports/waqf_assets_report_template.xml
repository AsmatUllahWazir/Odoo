<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="waqf_assets_report_template">
        <t t-call="web.html_container">
            <t t-set="assets" t-value="docs"/>
            <t t-call="web.basic_layout">
                <style>
                    .report-header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #b8860b; padding-bottom: 20px; }
                    .report-header h1 { color: #b8860b; }
                    .report-table { width: 100%; border-collapse: collapse; margin: 20px 0; }
                    .report-table th { background: #1a472a; color: white; padding: 10px; }
                    .report-table td { border: 1px solid #ddd; padding: 8px; }
                    .total-row { background: #fef8e7; font-weight: bold; }
                    .footer { margin-top: 40px; text-align: center; font-size: 11px; color: #999; }
                </style>

                <div class="report-header">
                    <h1>🏢 Waqf Assets Report</h1>
                    <p><t t-esc="docs.env.company.name if docs else ''"/></p>
                    <p>Generated on <t t-esc="time.strftime('%d/%m/%Y')"/></p>
                </div>

                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Asset Name</th>
                            <th>Type</th>
                            <th>Initial Value</th>
                            <th>Current Value</th>
                            <th>Depreciation</th>
                            <th>Annual Income</th>
                            <th>Charity Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="assets" t-as="asset">
                            <tr>
                                <td><t t-esc="asset.asset_code or '-'"/></td>
                                <td><t t-esc="asset.name"/></td>
                                <td><t t-esc="asset.asset_type"/></td>
                                <td style="text-align: right;"><t t-esc="'{:,.2f}'.format(asset.initial_value)"/></td>
                                <td style="text-align: right;"><t t-esc="'{:,.2f}'.format(asset.current_value)"/></td>
                                <td style="text-align: right;"><t t-esc="'{:,.2f}'.format(asset.total_depreciation)"/></td>
                                <td style="text-align: right;"><t t-esc="'{:,.2f}'.format(asset.annual_income)"/></td>
                                <td style="text-align: right; color: #b8860b;"><t t-esc="'{:,.2f}'.format(asset.charity_amount)"/></td>
                                <td><t t-esc="asset.state"/></td>
                            </tr>
                        </t>
                        <tr class="total-row">
                            <td colspan="3" style="text-align: right;"><strong>TOTAL</strong></td>
                            <td style="text-align: right;"><strong><t t-esc="'{:,.2f}'.format(sum(a.initial_value for a in assets))"/></strong></td>
                            <td style="text-align: right;"><strong><t t-esc="'{:,.2f}'.format(sum(a.current_value for a in assets))"/></strong></td>
                            <td style="text-align: right;"><strong><t t-esc="'{:,.2f}'.format(sum(a.total_depreciation for a in assets))"/></strong></td>
                            <td style="text-align: right;"><strong><t t-esc="'{:,.2f}'.format(sum(a.annual_income for a in assets))"/></strong></td>
                            <td style="text-align: right;"><strong><t t-esc="'{:,.2f}'.format(sum(a.charity_amount for a in assets))"/></strong></td>
                            <td>—</td>
                        </tr>
                    </tbody>
                </table>

                <div class="footer">
                    <p>ZakatPro — Waqf Asset Management Report</p>
                </div>
            </t>
        </t>
    </template>
</odoo>