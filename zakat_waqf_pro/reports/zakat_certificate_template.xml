<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="zakat_certificate_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.basic_layout">

                        <style>
                            @font-face {
                            font-family: 'Almarai';
                            src: local('Tajawal'), local('Tajawal'), url(/zakat_waqf_pro/static/fonts/Almarai.ttf)
                            format('opentype');
                            }
                        </style>

                        <div class="header">
                            <div class="row" style="text-align: center;">
                                <div class="col-4" style="padding-top: 30px;">
                                    <h1 style="font-size: 30px; color: #b8860b;">
                                        <strong>Zakat Certificate</strong>
                                    </h1>
                                </div>
                                <div class="col-4">
                                    <img src="/zakat_waqf_pro/static/images/icon.png"
                                         style="height: 100px; text-align: center;"/>
                                </div>
                                <div class="col-4" style="padding-top: 30px;">
                                    <h1 style="font-size: 30px; color: #b8860b;">
                                        <strong>شهادة زكاة</strong>
                                    </h1>
                                </div>
                            </div>
                        </div>

                        <div class="page"
                             style="font-family: 'Almarai'!important; direction: rtl; text-align: center; position: relative; min-height: 230mm; background: url('/zakat_waqf_pro/static/src/img/certificate_bg.jpg') no-repeat center center; background-size: cover;">

                            <div style="position: absolute; top: 15mm; left: 15mm; right: 15mm; bottom: 15mm; border: 12px solid #b8860b; border-image: url('/zakat_waqf_pro/static/src/img/border.png') 30 round; pointer-events: none;"/>

                            <div style="padding: 15px 20px; position: relative; z-index: 2;">

                                <div style="background: rgba(255,255,255,0.96); padding: 50px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); max-width: 650px; margin: 0 auto;">

                                    <p style="font-size: 20px; color: #333; margin: 18px 0;">
                                        <strong>رقم الشهادة / .Certificate No</strong>
                                        <br/>
                                        <span style="color: #b8860b; font-weight: bold;">ZKT-
                                            <t t-esc="doc.id"/>
                                        </span>
                                    </p>

                                    <p style="font-size: 22px; color: #333; margin: 25px 0;">
                                        <strong>المستحق / Recipient</strong>
                                        <br/>
                                        <span style="font-size: 26px; color: #b8860b;">
                                            <t t-esc="doc.recipient_name"/>
                                        </span>
                                    </p>

                                    <p style="font-size: 18px; color: #333; margin: 20px 0;">
                                        <strong>التاريخ / Date</strong>
                                        <br/>
                                        <span style="color: #b8860b;">
                                            <t t-esc="doc.issue_date.strftime('%d/%m/%Y')"/>
                                        </span>
                                    </p>

                                    <div style="background: linear-gradient(135deg, #f6e8b1, #e8c48a); padding: 10px; border-radius: 10px; margin: 15px 0;">
                                        <p style="font-size: 15px; color: #8b5a2b; margin: 0;">
                                            <strong>المبلغ المدفوع / Amount Paid</strong>
                                        </p>
                                        <p style="font-size: 20px; color: #b8860b; margin: 10px 0 0;">
                                            <t t-esc="'{:,}'.format(int(doc.amount_paid))"/>
                                            SAR
                                        </p>
                                    </div>

                                    <p style="font-size: 15px; color: #555; margin: 10px 0; line-height: 1.5;">
                                        تم دفع الزكاة المستحقة وفقًا للشريعة الإسلامية
                                        <br/>
                                        Zakat has been paid in accordance with Islamic Shariah
                                    </p>

                                    <div style="margin-top: 10px; display: flex; justify-content: space-between; align-items: end;">
                                        <div>
                                            <div style="border-top: 3px solid #b8860b; color: #666; width: 280px; padding-top: 10px; font-size: 16px;">
                                                <span>التوقيع المفوض</span>
                                                <span>Authorized Signature</span>
                                            </div>
                                        </div>

                                        <img src="/zakat_waqf_pro/static/images/image_paid.jpeg"
                                             style="height: 140px;"/>

                                    </div>

                                    <div style="margin-top: 20px; color: #b8860b; font-size: 15px;">
                                        جزاكم الله خيرًا • May Allah reward you abundantly
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>