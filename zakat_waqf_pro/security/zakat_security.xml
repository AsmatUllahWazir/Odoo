<!--    </record>-->

    <!-- Hide configuration menu from non-managers -->
<!--    <record id="menu_zakat_configuration" model="ir.ui.menu">-->
<!--        <field name="groups_id" eval="[(4, ref('group_zakat_manager'))]"/>-->
<!--    </record>-->

    <!-- ============================================================
    COLUMN ACCESS RULES (Field-level security)
    ============================================================= -->

    <!-- Hide sensitive fields from regular users -->
    <record id="zakat_calculation_field_security" model="ir.model.access">
        <field name="name">zakat.calculation.field.security</field>
        <field name="model_id" ref="model_zakat_calculation"/>
        <field name="group_id" ref="group_zakat_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>