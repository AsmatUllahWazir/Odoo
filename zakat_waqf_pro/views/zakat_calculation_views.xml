<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE VIEW -->
    <record id="view_zakat_calculation_tree" model="ir.ui.view">
        <field name="name">zakat.calculation.tree</field>
        <field name="model">zakat.calculation</field>
        <field name="arch" type="xml">
            <tree string="Zakat Calculations" decoration-success="state == 'paid'" decoration-warning="state == 'calculated'" decoration-danger="state == 'draft'">
                <field name="name" string="Reference"/>
                <field name="partner_id" string="Partner"/>
                <field name="calculation_date" string="Date" widget="date"/>
                <field name="hijri_date" string="Hijri Date"/>
                <field name="school" string="School" widget="badge"/>
                <field name="total_wealth" string="Total Wealth" widget="monetary" sum="Total"/>
                <field name="nisab_threshold" string="Nisab" widget="monetary"/>
                <field name="zakat_due" string="Zakat Due" widget="monetary" sum="Total Zakat" decoration-danger="zakat_due > 0"/>
                <field name="state" string="Status" widget="badge"/>
                <field name="sadad_bill_id" string="SADAD Bill"/>
            </tree>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_zakat_calculation_search" model="ir.ui.view">
        <field name="name">zakat.calculation.search</field>
        <field name="model">zakat.calculation</field>
        <field name="arch" type="xml">
            <search string="Search Zakat Calculations">
                <field name="partner_id" string="Partner"/>
                <field name="name" string="Reference"/>
                <field name="state"/>
                <filter string="Above Nisab" name="above_nisab" domain="[('is_above_nisab', '=', True)]"/>
                <filter string="Has Zakat Due" name="has_zakat" domain="[('zakat_due', '>', 0)]"/>
                <filter string="This Month" name="this_month" date="calculation_date"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="School" name="group_school" context="{'group_by': 'school'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'calculation_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_zakat_calculation_form" model="ir.ui.view">
        <field name="name">zakat.calculation.form</field>
        <field name="model">zakat.calculation</field>
        <field name="arch" type="xml">
            <form string="Zakat Calculation">
                <header>
                    <button name="action_calculate"
                            string="Calculate Zakat"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_generate_sadad_bill"
                            string="Generate SADAD Bill"
                            type="object"
                            class="btn-info"
                            invisible="zakat_due == 0 or state == 'invoiced' or state == 'paid'"
                            confirm="Generate a SADAD invoice for this Zakat amount?"/>

                    <button name="action_generate_certificate"
                            string="Generate Certificate"
                            type="object"
                            class="btn-success"
                            invisible="zakat_due == 0 or state == 'draft'"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ['calculated', 'invoiced', 'certified']"
                            confirm="Reset this calculation to draft? All data will be preserved."/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,calculated,invoiced,certified,paid"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_certificates"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-pdf-o"
                                help="View Certificates">
                            <div class="o_stat_info">
                                <field name="certificate_ids" widget="statinfo" string="Certificates"/>
                            </div>
                        </button>

                        <button name="action_generate_sadad_bill"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-invoice"
                                help="SADAD Invoice"
                                invisible="sadad_bill_id == False">
                            <div class="o_stat_info">
                                <span class="o_stat_value">SADAD</span>
                                <span class="o_stat_text">Invoice Ready</span>
                            </div>
                        </button>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="is_above_nisab">
                        <i class="fa fa-exclamation-triangle"/> Warning: Total wealth is below Nisab threshold. No Zakat is due.
                    </div>

                    <group name="main_info">
                        <group name="partner_info">
                            <field name="name" string="Reference" readonly="1"/>
                            <field name="partner_id" readonly="state != 'draft'" string="Partner/Company" required="1" options="{'no_create': True}"/>
                            <field name="calculation_date" readonly="state != 'draft'" string="Calculation Date"/>
                            <field name="hijri_date" string="Hijri Date" readonly="1"/>
                            <field name="school" string="Madhhab/School" readonly="state != 'draft'" widget="radio"/>
                        </group>

                        <group name="summary">
                            <field name="total_wealth" readonly="state != 'draft'" string="Total Wealth" widget="monetary" class="oe_inline"/>
                            <field name="nisab_threshold" readonly="state != 'draft'" string="Nisab Threshold" widget="monetary"/>
                            <field name="zakat_due" readonly="state != 'draft'" string="Zakat Due (2.5%)" widget="monetary" class="oe_inline" style="font-size: 24px; color: #b8860b; font-weight: bold;"/>
                            <field name="is_above_nisab" readonly="state != 'draft'" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Assets Breakdown" name="breakdown">
                            <group string="Assets" name="assets">
                                <group name="left_assets">
                                    <field name="cash_amount" readonly="state != 'draft'" string="Cash &amp; Bank" widget="monetary" placeholder="0.00"/>
                                    <field name="inventory_value" readonly="state != 'draft'" string="Inventory Value" widget="monetary" placeholder="0.00"/>
                                    <field name="receivables" readonly="state != 'draft'" string="Receivables" widget="monetary" placeholder="0.00"/>
                                </group>
                                <group name="right_assets">
                                    <field name="gold_silver" string="Gold/Silver" readonly="state != 'draft'" widget="monetary" placeholder="0.00"/>
                                    <field name="other_assets" readonly="state != 'draft'" string="Other Assets" widget="monetary" placeholder="0.00"/>
                                    <field name="total_liabilities" readonly="state != 'draft'" string="Liabilities (Optional)" widget="monetary" placeholder="0.00"/>
                                </group>
                            </group>
                        </page>

                        <page string="SADAD Invoice" name="invoice" invisible="not sadad_bill_id">
                            <group string="Invoice Details">
                                <field name="sadad_bill_id" string="Invoice" readonly="1" context="{'tree_view_ref': 'account.view_move_tree', 'form_view_ref': 'account.view_move_form'}"/>
                            </group>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes" readonly="state != 'draft'" nolabel="1" placeholder="Additional notes about this Zakat calculation..."/>
                        </page>
                    </notebook>
                </sheet>

                <div class="clearfix"/>
            </form>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_zakat_calculation_kanban" model="ir.ui.view">
        <field name="name">zakat.calculation.kanban</field>
        <field name="model">zakat.calculation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="calculation_date"/>
                <field name="zakat_due"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('res.partner', 'image_128', record.partner_id.raw_value)" alt="Partner" class="o_image_64_cover"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="partner_id"/>
                                </strong>
                                <div class="text-muted o_kanban_record_subtitle">
                                    <field name="name" />
                                </div>
                                <div>
                                    <field name="calculation_date"/>
                                </div>
                                <div class="o_kanban_tags">
                                    <field name="state" widget="badge"/>
                                </div>
                                <div class="o_kanban_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="zakat_due" widget="monetary"/> due
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACTION WINDOW -->
    <record id="action_zakat_calculations" model="ir.actions.act_window">
        <field name="name">Zakat Calculations</field>
        <field name="res_model">zakat.calculation</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_zakat_calculation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Zakat calculation
            </p>
            <p>
                ZakatPro helps you calculate Zakat (2.5%) on cash, inventory, receivables, gold, and other assets.
                The system automatically checks Nisab threshold based on current gold price.
            </p>
        </field>
    </record>
</odoo>